  <script>
    import { animate, inView, stagger } from "motion";

    const menuBtn = document.getElementById("menu-btn");
    const mobileNav = document.getElementById("mobile-nav");
    if (menuBtn && mobileNav) {
      menuBtn.addEventListener("click", () => {
        const open = !mobileNav.classList.toggle("hidden");
        menuBtn.setAttribute("aria-expanded", String(open));
      });
      mobileNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.classList.add("hidden");
          menuBtn.setAttribute("aria-expanded", "false");
        });
      });
    }

    const modal = document.getElementById("library-modal");
    const modalTitle = document.getElementById("library-modal-title");
    const modalDesc = document.getElementById("library-modal-desc");
    const modalClose = document.getElementById("library-modal-close");
    const libraryCopy = {
      brochure: {
        title: "Company Brochure",
        desc: "Our updated downloadable PDF brochure is being uploaded shortly. Need our company profile right away? Message us on WhatsApp or email and we will send it immediately.",
      },
      gallery: {
        title: "Project Gallery",
        desc: "Photos of our completed storage tank, structural steel, piping, and shutdown projects are being uploaded shortly. Reach out on WhatsApp or email if you would like recent project references.",
      },
    };
    const closeModal = () => {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };
    document.querySelectorAll("[data-library-placeholder]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        const key = el.getAttribute("data-library-placeholder");
        const item = key === "brochure" ? libraryCopy.brochure : key === "gallery" ? libraryCopy.gallery : null;
        if (!modal || !item) return;
        if (modalTitle) modalTitle.textContent = item.title;
        if (modalDesc) modalDesc.textContent = item.desc;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });
    modalClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      document.documentElement.classList.remove("js");
    } else {
      animate("[data-hero]", { opacity: [0, 1], y: [28, 0] }, { duration: 0.8, delay: stagger(0.12), ease: "easeOut" });
      inView("[data-group]", (group) => {
        animate(group.querySelectorAll("[data-reveal]"), { opacity: [0, 1], y: [32, 0] }, { duration: 0.7, delay: stagger(0.08), ease: "easeOut" });
      }, { amount: 0.1 });
    }
  </script>
