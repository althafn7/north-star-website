---
import "../styles/global.css";

const phones = [
  { label: "+968 9724 8330", href: "tel:+96897248330" },
  { label: "+968 9777 1508", href: "tel:+96897771508" },
];
const email = "nstsoman@gmail.com";
const map = "https://maps.app.goo.gl/pwzAuGg2UD7wKney9";

const stats = [
  { value: "350", suffix: "+", label: "Projects delivered" },
  { value: "18", suffix: "+", label: "Years of expertise" },
  { value: "120", suffix: "+", label: "Clients served" },
];

const services = [
  { t: "Storage tank construction and rehabilitation", d: "API 650/653 repairs, shell and floor plate replacement, and nozzle and manway rehabilitation." },
  { t: "Structural steel and piping fabrication", d: "Custom shop and site fabrication, process piping to ASME B31.3, and certified welding (SMAW, GTAW)." },
  { t: "Plant maintenance and shutdowns", d: "Preventive and shutdown maintenance, turnarounds, precision grinding, weld build-ups and cold patch plate removal to API 653 guidelines." },
  { t: "Heavy rigging and lifting", d: "Certified heavy rigging and crane lifting operations that support turnarounds and plant maintenance." },
  { t: "Technical material supply", d: "Supply of technical materials for fabrication and maintenance work, with incoming material checks." },
];

const standards = ["ASME Sec II, V, IX", "ASME B31.3", "API 650", "API 653", "AWS", "ASTM"];
const qa = [
  { t: "Inspection and test plans", d: "ITPs, document review, incoming material checks (MIRR) and shop fabrication control." },
  { t: "NDT/NDE testing", d: "RT, UT, MPI/MPT, dye penetrant (DPT/LPT) and PMI checks, including for SS 304 components." },
  { t: "Traceability and sign-offs", d: "Material verification, initial and final dimensions, fit-up inspection and pad plate pneumatic testing before test pack handover." },
];
const clients = [
  { name: "OQ", src: "oq" },
  { name: "Oman Methanol Company", src: "oman-methanol" },
  { name: "Wadi Al Jizzi Power Company", src: "wadi-al-jizzi-power" },
  { name: "Sohar Aluminium", src: "sohar-aluminium" },
  { name: "Vale", src: "vale" },
  { name: "Oman Formaldehyde Chemical Company", src: "oman-formaldehyde" },
  { name: "Gulf International Pipe Industry", src: "gipi" },
  { name: "Mawarid Mining", src: "mawarid-mining" },
  { name: "Oman Mining Company", src: "oman-mining" },
  { name: "Air Liquide", src: "air-liquide" },
  { name: "Sohar Sulphur Fertilizers", src: "sohar-sulphur-fertilizers" },
  { name: "SIUCI", src: "siuci" },
  { name: "Client", src: "client-water" },
  { name: "Panorama", src: "panorama" },
  { name: "Oman Aluminium Rolling Company", src: "oarc" },
  { name: "Drake & Scull", src: "drake-and-scull" },
  { name: "S&T", src: "s-and-t" },
  { name: "STS", src: "sts" },
  { name: "Shell Oman", src: "shell-oman" },
  { name: "Bahwan Engineering Company LLC (BEC)", src: "bec" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>North Star Technical Services LLC | Mechanical Fabrication and Plant Maintenance, Sohar, Oman</title>
  <meta name="description" content="North Star Technical Services LLC is an engineering and technical contracting company in Sohar, Oman: structural fabrication, piping, storage tank rehabilitation and plant maintenance for oil, gas and industry." />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add("js")</script>
</head>
<body>
  <header class="sticky top-0 z-20 border-b-4 border-flare bg-white">
    <div class="mx-auto flex h-20 max-w-6xl items-center justify-between gap-4 px-6">
      <a href="#top" class="flex items-center gap-3.5" aria-label="North Star Technical Services, home">
        <img src="/logo.png" alt="North Star logo" class="h-14 w-auto" />
        <span class="hidden border-l-2 border-plate pl-3.5 text-sm font-semibold leading-tight text-mid sm:block">North Star Technical Services LLC</span>
      </a>
      <nav class="hidden gap-7 text-[15px] font-medium md:flex" aria-label="Main">
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#about">About</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#services">Services</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#quality">Quality and safety</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#clients">Clients</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#contact">Contact</a>
      </nav>
      <a href={phones[0].href} class="bg-flare px-4 py-2 text-sm font-semibold text-white md:hidden">Call us</a>
    </div>
  </header>

  <main id="top">
    <section class="relative overflow-hidden bg-ink text-white">
      <div class="absolute -right-24 top-0 h-full w-1/2 -skew-x-12 bg-flare/90" aria-hidden="true"></div>
      <div class="absolute -right-4 top-0 h-full w-24 -skew-x-12 bg-black/60" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pb-16 pt-16 md:grid-cols-[1.25fr_1fr] md:pt-24">
        <div>
          <h1 data-hero class="font-display text-6xl font-black leading-[.92] sm:text-7xl lg:text-8xl">Fabrication, piping and plant maintenance for Oman's industry.</h1>
          <p data-hero class="mt-7 max-w-xl text-lg text-white/80">Industrial engineering, mechanical fabrication and plant maintenance and contracting, delivered from Sohar with strict QA/QC and a zero-harm approach.</p>
          <div data-hero class="mt-9 flex flex-wrap gap-4">
            <a href="#contact" class="bg-flare px-7 py-3.5 font-semibold text-white hover:bg-red-700">Request a quote</a>
            <a href="#services" class="border-2 border-white/40 px-7 py-3.5 font-semibold hover:bg-white/10">See our services</a>
          </div>
        </div>
        <div data-hero class="mx-auto w-full max-w-sm">
          <div class="flex aspect-square items-center justify-center overflow-hidden rounded-full bg-white p-[13%] shadow-2xl">
            <div class="relative aspect-[436/420] w-full -translate-y-1">
              <img src="/logo-gear.png" alt="" aria-hidden="true" class="gear-rock absolute inset-0 h-full w-full" />
              <img src="/logo-core.png" alt="North Star Technical Services logo" class="relative h-full w-full" />
            </div>
          </div>
        </div>
      </div>
      <svg class="relative block h-24 w-full" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="pipe" d="M0 92H300V48H620V92H880V36H1200" fill="none" stroke="#fff" stroke-width="8" opacity=".9" />
        <rect x="0" y="108" width="1200" height="12" fill="#e6e4da" />
      </svg>
    </section>

    <section id="about" class="relative overflow-hidden bg-steel bg-grid-light py-24" data-group>
      <div class="pointer-events-none absolute -right-28 top-0 h-full w-1/3 -skew-x-12 bg-ink/[0.06]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-8 top-0 h-full w-16 -skew-x-12 bg-flare/15" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-2">
        <div data-reveal class="self-center">
          <div class="mb-4 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-flare">
            <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
            01 / About NSTS
          </div>
          <h2 class="font-display text-5xl font-extrabold leading-none sm:text-6xl">Engineering and technical contracting in Sohar</h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-mid">North Star Technical Services (NSTS) is a specialized engineering and technical contracting company based in Sohar, Oman. We deliver end-to-end mechanical construction, structural fabrication, piping, storage tank rehabilitation and plant maintenance.</p>
          <div class="mt-7 inline-flex items-center gap-3 border-l-4 border-flare bg-ink px-4 py-2.5 text-xs font-semibold uppercase tracking-widest text-white shadow-sm">
            <span>Liwa Industrial Area</span>
            <span class="text-flare" aria-hidden="true">&bull;</span>
            <span>Sohar, Oman</span>
          </div>
        </div>
        <div class="grid gap-6 self-center">
          <div data-reveal class="border-l-4 border-flare bg-ink p-7 text-white shadow-lg">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-400">Our direction</p>
            <h3 class="mt-1 font-display text-3xl font-extrabold">Vision</h3>
            <p class="mt-2 text-white/80">To be the preferred industrial engineering and mechanical contracting partner in Oman.</p>
          </div>
          <div data-reveal class="border border-plate border-l-4 border-l-ink bg-white p-7 shadow-md">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-flare">Our commitment</p>
            <h3 class="mt-1 font-display text-3xl font-extrabold">Mission</h3>
            <p class="mt-2 text-mid">To support critical infrastructure through precision fabrication, strict QA/QC and plant maintenance.</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-label="Company track record" class="relative overflow-hidden border-y-4 border-flare bg-ink bg-grid-dark text-white" data-group>
      <div class="pointer-events-none absolute -right-24 top-0 h-full w-1/3 -skew-x-12 bg-flare/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-4 top-0 h-full w-20 -skew-x-12 bg-black/40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <dl class="grid divide-y divide-white/15 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {stats.map((s) => (
            <div data-reveal class="flex flex-col-reverse py-9 sm:px-10 sm:py-12 sm:first:pl-0 sm:last:pr-0">
              <dt class="mt-2.5 text-base font-medium text-white/80 sm:text-lg">{s.label}</dt>
              <dd class="font-display text-6xl font-black leading-none tracking-tight sm:text-7xl">
                {s.value}<span class="text-flare">{s.suffix}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="services" class="relative overflow-hidden bg-cream py-24" data-group>
      <img
        src="/services-bg.jpg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-cream/85 via-cream/65 to-cream/82" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cream/65 via-transparent to-ink/20" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <div data-reveal class="mb-4 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-flare">
          <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
          02 / Capabilities
        </div>
        <h2 data-reveal class="font-display text-5xl font-extrabold leading-none sm:text-6xl">Core services</h2>
        <p data-reveal class="mt-4 max-w-prose text-lg font-medium text-ink/80">Shop and site work for refineries, tank farms, power, mining and process plants.</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <article data-reveal class="group flex flex-col border border-plate/80 border-t-4 border-t-ink bg-white/90 p-7 shadow-md backdrop-blur-md transition-[translate,border-color,box-shadow,background-color] duration-300 hover:-translate-y-1 hover:border-t-flare hover:bg-white hover:shadow-xl">
              <span class="font-display text-2xl font-black tracking-wider text-flare">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 font-display text-3xl font-extrabold leading-tight text-ink">{s.t}</h3>
              <p class="mt-3 text-mid">{s.d}</p>
            </article>
          ))}
          <article data-reveal class="relative flex flex-col justify-between overflow-hidden bg-gradient-to-br from-flare to-flare-deep p-7 text-white shadow-xl">
            <div class="pointer-events-none absolute -right-10 top-0 h-full w-24 -skew-x-12 bg-ink/20" aria-hidden="true"></div>
            <div class="relative">
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Custom scope</span>
              <h3 class="mt-2 font-display text-3xl font-extrabold leading-tight">Have a different scope?</h3>
              <p class="mt-3 text-white/90">Send us the drawings or a site visit request and we will tell you plainly what we can deliver.</p>
            </div>
            <div class="relative mt-6">
              <a href="#contact" class="inline-block bg-ink px-6 py-3 font-semibold text-white transition-colors hover:bg-black">Talk to us</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="quality" class="relative overflow-hidden border-y-4 border-flare bg-ink bg-grid-dark py-24 text-white" data-group>
      <div class="pointer-events-none absolute -right-28 top-0 h-full w-2/5 -skew-x-12 bg-flare/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-8 top-0 h-full w-24 -skew-x-12 bg-flare/75" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <div data-reveal class="mb-4 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-red-400">
          <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
          03 / Standards &amp; HSE
        </div>
        <h2 data-reveal class="font-display text-5xl font-extrabold leading-none sm:text-6xl">Quality and safety</h2>
        <div data-reveal class="mt-6 flex flex-wrap gap-2.5">
          {standards.map((s) => (
            <span class="inline-flex items-center gap-2 border border-white/25 bg-ink-soft/90 px-3.5 py-1.5 text-sm font-semibold text-white backdrop-blur-sm">
              <span class="h-1.5 w-1.5 bg-flare" aria-hidden="true"></span>
              {s}
            </span>
          ))}
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
          <div class="grid gap-5">
            {qa.map((q) => (
              <div data-reveal class="border border-white/10 border-l-4 border-l-flare bg-ink-soft/95 p-6 shadow-md backdrop-blur-sm">
                <h3 class="text-xl font-semibold text-white">{q.t}</h3>
                <p class="mt-1.5 text-white/75">{q.d}</p>
              </div>
            ))}
          </div>
          <div data-reveal class="flex flex-col justify-between border border-white/15 bg-gradient-to-br from-flare to-flare-deep p-8 text-white shadow-xl">
            <div>
              <span class="inline-block bg-ink/85 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-white">Zero-harm policy</span>
              <h3 class="mt-5 font-display text-4xl font-extrabold leading-none">Health, safety and environment</h3>
              <p class="mt-4 text-white/90">A zero-harm philosophy backed by job safety analyses, method statements and strict permit-to-work compliance on every job.</p>
            </div>
            <div class="mt-8 border-t border-white/25 pt-4 text-xs font-semibold uppercase tracking-[0.16em] text-white/85">
              JSA &bull; Method Statements &bull; Permit-to-Work
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="clients" class="relative overflow-hidden bg-steel bg-grid-light py-24" data-group>
      <div class="pointer-events-none absolute -right-24 top-0 h-full w-1/3 -skew-x-12 bg-ink/[0.05]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-24 top-0 h-full w-24 -skew-x-12 bg-flare/10" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <div data-reveal class="mb-4 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-flare">
          <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
          04 / Trusted Partners
        </div>
        <h2 data-reveal class="font-display text-5xl font-extrabold leading-none sm:text-6xl">Clients we have worked with</h2>
      </div>
      <div class="relative mx-auto mt-10 max-w-6xl px-6">
        <div class="grid grid-cols-2 gap-px border border-plate border-t-4 border-t-flare bg-plate shadow-lg sm:grid-cols-3 lg:grid-cols-5">
          {clients.map((c, i) => (
            <div data-reveal class="group relative flex h-28 items-center justify-center overflow-hidden bg-white p-5 transition-colors duration-300 hover:bg-steel/40">
              <div
                class="client-wave flex h-full w-full items-center justify-center"
                style={`animation-delay: ${((i % 5) + Math.floor(i / 5)) * 0.35}s`}
              >
                <img
                  src={`/clients/${c.src}.png`}
                  alt={c.name}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 ease-out group-hover:scale-110"
                />
              </div>
              <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-flare transition-transform duration-300 ease-out group-hover:scale-x-100"></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="relative overflow-hidden border-t-4 border-flare bg-ink bg-grid-dark py-24 text-white" data-group>
      <div class="pointer-events-none absolute -right-28 top-0 h-full w-2/5 -skew-x-12 bg-flare/85" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-6 top-0 h-full w-24 -skew-x-12 bg-black/55" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <div data-reveal class="mb-4 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-red-400">
          <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
          05 / Contact
        </div>
        <h2 data-reveal class="font-display text-5xl font-extrabold leading-none sm:text-6xl">Tell us about your job</h2>
        <p data-reveal class="mt-4 max-w-prose text-lg text-white/80">Send your scope, drawings or a site visit request. We reply with a clear plan and quote.</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div data-reveal class="border border-white/15 border-t-4 border-t-flare bg-ink/90 p-6 shadow-lg backdrop-blur-sm">
            <h3 class="font-display text-2xl font-bold tracking-wide text-red-400">Phone</h3>
            <div class="mt-2 space-y-1">
              {phones.map((p) => <a class="block text-lg hover:underline" href={p.href}>{p.label}</a>)}
            </div>
          </div>
          <div data-reveal class="border border-white/15 border-t-4 border-t-flare bg-ink/90 p-6 shadow-lg backdrop-blur-sm">
            <h3 class="font-display text-2xl font-bold tracking-wide text-red-400">Email</h3>
            <a class="mt-2 block break-all text-lg hover:underline" href={`mailto:${email}`}>{email}</a>
          </div>
          <div data-reveal class="border border-white/15 border-t-4 border-t-flare bg-ink/90 p-6 shadow-lg backdrop-blur-sm">
            <h3 class="font-display text-2xl font-bold tracking-wide text-red-400">Address</h3>
            <p class="mt-2 text-lg text-white/90">Liwa Industrial Area, Sohar, Sultanate of Oman</p>
          </div>
          <div data-reveal class="border border-white/15 border-t-4 border-t-flare bg-ink/90 p-6 shadow-lg backdrop-blur-sm">
            <h3 class="font-display text-2xl font-bold tracking-wide text-red-400">Map</h3>
            <a class="mt-2 inline-flex items-center gap-1.5 text-lg font-medium hover:underline" href={map} target="_blank" rel="noopener">Open in Google Maps &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-[#14130a] py-7 text-sm text-[#a3a38f]">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-6 sm:flex-row sm:items-center">
      <span>&copy; {new Date().getFullYear()} North Star Technical Services LLC. Sohar, Sultanate of Oman.</span>
      <a href="#top" class="text-xs font-semibold uppercase tracking-widest text-white/70 transition-colors hover:text-flare">Back to top &uarr;</a>
    </div>
  </footer>

  <script>
    import { animate, inView, stagger } from "motion";

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      document.documentElement.classList.remove("js");
    } else {
      animate("[data-hero]", { opacity: [0, 1], y: [28, 0] }, { duration: 0.8, delay: stagger(0.12), ease: "easeOut" });
      inView("[data-group]", (group) => {
        animate(group.querySelectorAll("[data-reveal]"), { opacity: [0, 1], y: [32, 0] }, { duration: 0.7, delay: stagger(0.1), ease: "easeOut" });
      }, { amount: 0.15 });
    }
  </script>
</body>
</html>
