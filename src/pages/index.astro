<body>
  <header class="sticky top-0 z-30 border-b-4 border-flare bg-white shadow-xs">
    <div class="mx-auto flex h-20 max-w-6xl items-center justify-between gap-3 px-4 sm:h-24 sm:gap-4 sm:px-6">
      <a href="#top" class="flex min-w-0 items-center gap-3 sm:gap-4" aria-label="North Star Technical Services LLC, home">
        <img src="/logo.png" alt="North Star logo" class="h-13 w-auto shrink-0 sm:h-16 md:h-[4.25rem]" />
        <span class="border-l-2 border-flare pl-3 leading-tight sm:pl-4">
          <span class="block text-base font-extrabold uppercase tracking-wide text-ink sm:text-xl lg:text-[22px]">NORTH STAR</span>
          <span class="block text-xs font-semibold text-mid sm:text-sm">Technical Services LLC</span>
        </span>
      </a>
      <nav class="hidden items-center gap-6 text-[15px] font-medium md:flex lg:gap-7" aria-label="Main">
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#about">About</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#services">Services</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#quality">Quality and safety</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#clients">Clients</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#library">Library</a>
        <a class="border-b-2 border-transparent py-1 hover:border-flare" href="#contact">Contact</a>
      </nav>
      <button
        id="menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center border border-plate text-ink transition-colors hover:border-flare hover:text-flare md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
    <nav id="mobile-nav" class="hidden border-t border-plate bg-white px-4 py-3 md:hidden" aria-label="Mobile navigation">
      <div class="flex flex-col divide-y divide-plate/60 text-sm font-semibold text-ink">
        <a class="py-2.5 hover:text-flare" href="#about">About</a>
        <a class="py-2.5 hover:text-flare" href="#services">Services</a>
        <a class="py-2.5 hover:text-flare" href="#quality">Quality and safety</a>
        <a class="py-2.5 hover:text-flare" href="#clients">Clients</a>
        <a class="py-2.5 hover:text-flare" href="#library">Library</a>
        <a class="py-2.5 hover:text-flare" href="#contact">Contact</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="relative overflow-hidden bg-[#111318] text-white">
      <img
        src="/hero-bg.jpg"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[62%_center] md:object-center"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#111318]/85 via-[#111318]/55 to-[#111318]/80 md:bg-gradient-to-r md:from-[#111318]/90 md:via-[#111318]/65 md:to-[#111318]/25" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#111318]/80 via-transparent to-[#111318]/35" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-6 px-5 pb-6 pt-8 sm:px-6 md:grid-cols-[1.25fr_1fr] md:gap-12 md:pb-16 md:pt-24">
        <div>
          <h1 data-hero class="oman-flag-text pb-1.5 font-display text-5xl font-black leading-[.94] sm:text-7xl lg:text-8xl">Fabrication, piping and plant maintenance for Oman's industry.</h1>
          <p data-hero class="mt-4 max-w-xl text-[15px] leading-relaxed text-white/90 drop-shadow-[0_1px_6px_rgba(0,0,0,0.5)] sm:mt-7 sm:text-lg">Industrial engineering, mechanical fabrication and plant maintenance and contracting, delivered from Sohar with strict QA/QC and a zero-harm approach.</p>
          <div data-hero class="mt-6 flex flex-wrap gap-3 sm:mt-9 sm:gap-4">
            <a href="#contact" class="bg-flare px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-red-700 sm:px-7 sm:py-3.5 sm:text-base">Request a quote</a>
            <a href="#services" class="border-2 border-white/60 bg-black/30 px-5 py-2.5 text-sm font-semibold backdrop-blur-sm transition-colors hover:bg-white/15 sm:px-7 sm:py-3.5 sm:text-base">See our services</a>
          </div>
        </div>
        <div data-hero class="mx-auto w-full max-w-[200px] sm:max-w-[280px] md:max-w-[360px]">
          <div class="relative flex aspect-square items-center justify-center p-4 sm:p-6">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full bg-[radial-gradient(circle,rgba(255,252,240,0.28)_0%,rgba(255,252,240,0.08)_46%,transparent_72%)]"></div>
            <div class="relative aspect-[436/420] w-full drop-shadow-[0_14px_30px_rgba(0,0,0,0.78)]">
              <img src="/logo-gear-hero.png" alt="" aria-hidden="true" class="gear-rock absolute inset-0 h-full w-full" />
              <img src="/logo-core-hero.png" alt="North Star Technical Services logo" class="relative h-full w-full" />
            </div>
          </div>
        </div>
      </div>
      <svg class="relative block h-12 w-full sm:h-20 md:h-24" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="pipe" d="M0 92H300V48H620V92H880V36H1200" fill="none" stroke="#fff" stroke-width="8" opacity=".9" />
        <rect x="0" y="108" width="1200" height="12" fill="#e6e4da" />
      </svg>
    </section>

    <section id="about" class="relative overflow-hidden bg-steel bg-grid-light py-14 sm:py-24" data-group>
      <div class="pointer-events-none absolute -right-28 top-0 h-full w-1/3 -skew-x-12 bg-ink/[0.06]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-8 top-0 h-full w-16 -skew-x-12 bg-flare/15" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-8 px-5 sm:px-6 md:grid-cols-2 md:gap-12">
        <div data-reveal class="self-center">
          <div class="mb-3 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-flare sm:mb-4">
            <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
            01 / About NSTS
          </div>
          <h2 class="font-display text-4xl font-extrabold leading-none sm:text-5xl lg:text-6xl">Engineering and technical contracting in Sohar</h2>
          <p class="mt-4 max-w-prose text-base leading-relaxed text-mid sm:mt-6 sm:text-lg">North Star Technical Services (NSTS) is a specialized engineering and technical contracting company based in Sohar, Oman. We deliver end-to-end mechanical construction, structural fabrication, piping, storage tank rehabilitation and plant maintenance.</p>
          <div class="mt-6 inline-flex items-center gap-3 border-l-4 border-flare bg-ink px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white shadow-sm sm:mt-7 sm:py-2.5">
            <span>Liwa Industrial Area</span>
            <span class="text-flare" aria-hidden="true">&bull;</span>
            <span>Sohar, Oman</span>
          </div>
        </div>
        <div class="grid gap-4 self-center sm:gap-6">
          <div data-reveal class="border-l-4 border-flare bg-ink p-5 text-white shadow-lg sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-400">Our direction</p>
            <h3 class="mt-1 font-display text-3xl font-extrabold">Vision</h3>
            <p class="mt-2 text-sm text-white/80 sm:text-base">To be the preferred industrial engineering and mechanical contracting partner in Oman.</p>
          </div>
          <div data-reveal class="border border-plate border-l-4 border-l-ink bg-white p-5 shadow-md sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-flare">Our commitment</p>
            <h3 class="mt-1 font-display text-3xl font-extrabold">Mission</h3>
            <p class="mt-2 text-sm text-mid sm:text-base">To support critical infrastructure through precision fabrication, strict QA/QC and plant maintenance.</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-label="Company track record" class="relative overflow-hidden border-y-4 border-flare bg-ink bg-grid-dark text-white" data-group>
      <div class="pointer-events-none absolute -right-24 top-0 h-full w-1/3 -skew-x-12 bg-flare/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-4 top-0 h-full w-20 -skew-x-12 bg-black/40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <dl class="grid grid-cols-3 divide-x divide-white/15">
          {stats.map((s) => (
            <div data-reveal class="flex flex-col-reverse px-2 py-7 text-center sm:px-10 sm:py-12 sm:text-left sm:first:pl-0 sm:last:pr-0">
              <dt class="mt-2 text-xs font-medium leading-snug text-white/80 sm:mt-2.5 sm:text-base md:text-lg">{s.label}</dt>
              <dd class="font-display text-4xl font-black leading-none tracking-tight sm:text-6xl md:text-7xl">
                {s.value}<span class="text-flare">{s.suffix}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="services" class="relative overflow-hidden bg-cream py-14 sm:py-24" data-group>
      <img
        src="/services-bg.jpg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[68%_center] md:object-center"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-cream/88 via-cream/70 to-cream/85" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cream/65 via-transparent to-ink/20" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 sm:px-6">
        <div data-reveal class="mb-3 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-flare sm:mb-4">
          <span class="h-0.5 w-8 bg-flare" aria-hidden="true"></span>
          02 / Capabilities
        </div>
        <h2 data-reveal class="font-display text-4xl font-extrabold leading-none sm:text-5xl lg:text-6xl">Core services</h2>
        <p data-reveal class="mt-3 max-w-prose text-base font-medium text-ink/80 sm:mt-4 sm:text-lg">Shop and site work for refineries, tank farms, power, mining and process plants.</p>
        <div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {services.map((s, i) => (
            <article data-reveal class="group flex flex-col border border-plate/80 border-t-4 border-t-ink bg-white/92 p-5 shadow-md backdrop-blur-md transition-[translate,border-color,box-shadow,background-color] duration-300 hover:-translate-y-1 hover:border-t-flare hover:bg-white hover:shadow-xl sm:p-7">
              <span class="font-display text-2xl font-black tracking-wider text-flare">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-1.5 font-display text-3xl font-extrabold leading-tight text-ink sm:mt-2">{s.t}</h3>
              <p class="mt-2.5 text-sm text-mid sm:mt-3 sm:text-base">{s.d}</p>
            </article>
          ))}
          <article data-reveal class="relative flex flex-col justify-between overflow-hidden bg-gradient-to-br from-flare to-flare-deep p-6 text-white shadow-xl sm:p-7">
            <div class="pointer-events-none absolute -right-10 top-0 h-full w-24 -skew-x-12 bg-ink/20" aria-hidden="true"></div>
            <div class="relative">
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Custom scope</span>
              <h3 class="mt-2 font-display text-3xl font-extrabold leading-tight">Have a different scope?</h3>
              <p class="mt-3 text-sm text-white/90 sm:text-base">Send us the drawings or a site visit request and we will tell you plainly what we can deliver.</p>
            </div>
            <div class="relative mt-6">
              <a href="#contact" class="inline-block bg-ink px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black sm:text-base">Talk to us</a>
            </div>
          </article>
        </div>
      </div>
    </section>

