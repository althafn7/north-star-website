---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Operations Workflow Portal | North Star Technical Services LLC</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-[#0f1115] font-sans text-white antialiased">

  <!-- ================= AUTH GATE (LOGIN SCREEN) ================= -->
  <div id="login-gate" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0b0d11] p-4">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-flare bg-[#161920] p-8 shadow-2xl sm:p-10">
      <div class="flex flex-col items-center text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white p-2.5 shadow-md">
          <img src="/logo.png" alt="North Star logo" class="h-full w-auto object-contain" />
        </div>
        <span class="mt-4 text-xs font-semibold uppercase tracking-[0.25em] text-flare">North Star Operations</span>
        <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight text-white">Workflow Portal</h1>
        <p class="mt-2 text-xs text-white/60">Quotes • Purchase Orders • Execution • Invoicing</p>
      </div>

      <form id="login-form" class="mt-8 space-y-4">
        <div>
          <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            autocomplete="username"
            value="admin"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none focus:ring-1 focus:ring-flare"
            placeholder="admin"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Password</label>
            <button type="button" id="open-forgot-modal-btn" class="text-[11px] font-medium text-flare hover:underline">Forgot Password?</button>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none focus:ring-1 focus:ring-flare"
            placeholder="••••••••"
          />
        </div>

        <div id="login-error" class="hidden rounded-sm bg-red-900/40 p-2.5 text-xs font-medium text-red-300">
          Invalid username or password. Please try again.
        </div>

        <button
          type="submit"
          class="w-full bg-flare py-3 text-sm font-semibold tracking-wider text-white shadow-lg transition-colors hover:bg-red-700"
        >
          Sign In to Portal
        </button>
      </form>

      <div class="mt-6 border-t border-white/10 pt-4 text-center">
        <a href="/" class="text-xs text-white/50 transition-colors hover:text-white">← Back to public website</a>
      </div>
    </div>
  </div>

  <!-- ================= FORGOT PASSWORD MODAL ================= -->
  <div id="forgot-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-flare bg-[#161920] p-6 shadow-2xl sm:p-8">
      <button
        type="button"
        id="forgot-modal-close-btn"
        class="absolute right-4 top-4 text-white/50 transition-colors hover:text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-flare">Security Recovery</span>
      <h2 class="mt-1 font-display text-2xl font-extrabold text-white">Reset Portal Password</h2>
      <p class="mt-1.5 text-xs text-white/60">
        To reset your password, enter your registered company administration email (<strong class="font-mono text-white">in****@northstaroman.com</strong>).
      </p>

      <form id="forgot-form" class="mt-5 space-y-4">
        <div>
          <label for="recovery-email" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Company Email Address</label>
          <input
            type="email"
            id="recovery-email"
            required
            autocomplete="email"
            placeholder="in****@northstaroman.com"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none"
          />
        </div>

        <div id="recovery-new-pass-group" class="hidden space-y-3 border-t border-white/10 pt-3">
          <div>
            <label for="new-password" class="block text-xs font-semibold uppercase tracking-wider text-white/70">New Password</label>
            <input
              type="password"
              id="new-password"
              placeholder="Enter new password (min 4 chars)"
              class="mt-1 w-full border border-white/15 bg-[#0f1115] px-4 py-2 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none"
            />
          </div>
          <div>
            <label for="confirm-password" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Confirm New Password</label>
            <input
              type="password"
              id="confirm-password"
              placeholder="Confirm new password"
              class="mt-1 w-full border border-white/15 bg-[#0f1115] px-4 py-2 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none"
            />
          </div>
        </div>

        <div id="forgot-msg" class="hidden rounded-sm p-2.5 text-xs font-medium"></div>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button
            type="button"
            id="forgot-cancel-btn"
            class="border border-white/20 px-4 py-2 text-xs font-semibold text-white/70 hover:bg-white/10"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="forgot-submit-btn"
            class="bg-flare px-4 py-2 text-xs font-semibold text-white hover:bg-red-700"
          >
            Verify Email &amp; Continue
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= MAIN ADMIN DASHBOARD ================= -->
  <div id="admin-app" class="hidden min-h-screen flex-col">
    <!-- Top Navigation -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#161920]/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2.5" title="View live website">
            <img src="/logo.png" alt="North Star logo" class="h-9 w-auto" />
            <div class="border-l border-white/20 pl-2.5">
              <span class="block font-display text-lg font-extrabold leading-none tracking-wide text-white">NORTH STAR</span>
              <span class="block text-[10px] font-semibold uppercase tracking-wider text-flare">Operations Portal</span>
            </div>
          </a>
        </div>

        <!-- Action tools -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <a
            href="/attendance"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/15 px-3 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white"
            title="Switch to Staff Attendance & Payroll Portal"
          >
            <span>Attendance &amp; Payroll</span>
            <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </a>

          <a
            href="/"
            target="_blank"
            class="hidden items-center gap-1.5 rounded-sm border border-white/15 px-3 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white md:inline-flex"
          >
            <span>Live Site</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>

          <button
            id="export-csv-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/15"
          >
            <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="hidden sm:inline">Export Excel/CSV</span>
            <span class="sm:hidden">CSV</span>
          </button>

                    <button
            id="cloud-sync-btn"
            type="button"
            title="Live Cloud Sync: Click to refresh and sync with cloud database"
            class="inline-flex items-center gap-1.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-medium text-emerald-300 transition-colors hover:border-emerald-400 hover:bg-emerald-500/20"
          >
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
            <span id="cloud-sync-text" class="hidden sm:inline">Live Synced</span>
            <svg id="cloud-sync-icon" class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          </button>

<button
            id="open-create-modal-btn"
            type="button"
            class="inline-flex items-center gap-1.5 bg-flare px-3.5 py-1.5 text-xs font-semibold text-white shadow-md transition-colors hover:bg-red-700"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>New Job / Quote</span>
          </button>

          <button
            id="change-pass-btn"
            type="button"
            title="Change Password"
            class="rounded-sm border border-white/15 px-2.5 py-1.5 text-xs text-white/70 transition-colors hover:border-white/40 hover:text-white"
          >
            Change Password
          </button>

          <button
            id="logout-btn"
            type="button"
            title="Log out"
            class="rounded-sm border border-white/15 p-1.5 text-white/60 transition-colors hover:border-red-500 hover:text-red-400"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="mx-auto w-full max-w-[1440px] flex-1 px-2.5 py-4 sm:px-4 lg:px-6">
      
      <!-- Summary Metric Cards -->
      <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <div class="border border-white/10 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-white/50">Total Quoted Value</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-flare">OMR</span>
            <span id="metric-quoted-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-quoted-count" class="mt-1 block text-[11px] text-white/40">0 active quotes</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-emerald-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-400">POs Received (Approved)</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-emerald-400">OMR</span>
            <span id="metric-po-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-po-count" class="mt-1 block text-[11px] text-white/40">0 jobs with PO</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-amber-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-400">Pending Approvals</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span id="metric-pending-count" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
            <span class="text-xs font-medium text-white/50">quotes</span>
          </div>
          <span id="metric-pending-val" class="mt-1 block text-[11px] text-white/40">OMR 0 in review</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-blue-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-blue-400">Invoiced / Completed</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-blue-400">OMR</span>
            <span id="metric-invoiced-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-invoiced-count" class="mt-1 block text-[11px] text-white/40">0 jobs invoiced</span>
        </div>
      </section>

      <!-- Table Toolbar (Search & Filters) -->
      <section class="mt-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div class="flex flex-1 flex-wrap items-center gap-2.5">
          <div class="relative min-w-[220px] flex-1 sm:max-w-xs">
            <input
              type="text"
              id="search-input"
              placeholder="Search client, PO #, scope, quote #..."
              class="w-full border border-white/15 bg-[#161920] py-2 pl-9 pr-3 text-xs text-white placeholder-white/40 focus:border-flare focus:outline-none"
            />
            <svg class="absolute left-3 top-2.5 h-4 w-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <select
            id="filter-status"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-flare focus:outline-none"
          >
            <option value="ALL">All Approval Statuses</option>
            <option value="Pending">Pending Approval</option>
            <option value="Approved">PO Received / Approved</option>
            <option value="Under Revision">Under Revision</option>
            <option value="Lost">Lost / Cancelled</option>
            <option value="Dummy Quote">Dummy Quote</option>
          </select>

          <select
            id="filter-work"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-flare focus:outline-none"
          >
            <option value="ALL">All Work Progress</option>
            <option value="Not Started">Not Started</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
          </select>

          <select
            id="sort-date"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-flare focus:outline-none"
            title="Sort quotes by date"
          >
            <option value="NEWEST">Date: Newest to Oldest</option>
            <option value="OLDEST">Date: Oldest to Newest</option>
          </select>
        </div>

        <div class="text-right text-xs font-semibold text-red-400">
          Showing <span id="record-count" class="font-bold text-red-300">0</span> records
        </div>
      </section>

      <!-- Year Category Filter Bar (Between Search Bar & Table) -->
      <section class="mt-4 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-400">Year Register:</span>
          <div id="year-tabs-container" class="inline-flex flex-wrap items-center gap-1.5">
            <!-- Dynamically populated buttons: All Years, 2025, 2026, 2027... -->
          </div>
        </div>
        <div id="year-filter-badge" class="text-xs font-semibold text-red-400">
          <!-- Dynamically populated year summary -->
        </div>
      </section>

      <!-- Workflow Table -->
      <section class="mt-3 border border-white/10 bg-[#161920] shadow-xl">
        <div class="overflow-x-auto md:overflow-x-visible">
          <table class="w-full text-left text-xs">
            <thead class="sticky top-[60px] sm:top-[61px] z-30 border-b border-white/15 bg-[#1a1e27] text-[10.5px] font-bold uppercase tracking-wider text-white/70 shadow-md">
              <tr>
                <th id="th-sort-date" class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[105px] cursor-pointer select-none py-2.5 pl-2 pr-1 transition-colors hover:text-flare" title="Click to sort by date">
                  <span class="inline-flex items-center gap-1">
                    <span>Ref &amp; Date</span>
                    <span id="sort-indicator" class="text-xs text-flare font-bold">▼</span>
                  </span>
                </th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[55px] px-1 py-2.5">Client</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] px-2 py-2.5">Job / Scope Description</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[95px] px-1 py-2.5">Quote Total</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[95px] px-1 py-2.5">Status</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[100px] px-1 py-2.5">PO Details</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[88px] px-1 py-2.5">Work Progress</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[98px] px-1 py-2.5">Invoicing</th>
                <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[82px] py-2.5 pl-1 pr-1 text-left">Actions</th>
              </tr>
            </thead>
            <tbody id="workflow-table-body" class="divide-y divide-white/5">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>

        <div id="no-records-msg" class="hidden py-12 text-center text-sm text-white/40">
          No records match your filter criteria. Click "New Job / Quote" to add one.
        </div>
      </section>

      <!-- Bottom Utility Bar -->
      <section class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-red-400">
        <div class="font-medium text-red-400">
          Data is synchronized live across all your devices (<span id="footer-sync-status" class="font-semibold text-emerald-400">Live Cloud Active</span>).
        </div>
        <div class="flex items-center gap-3">
          <button id="backup-json-btn" type="button" class="font-medium text-red-400 underline transition-colors hover:text-red-300">Download JSON Backup</button>
          <span class="font-bold text-red-400">•</span>
          <button id="reset-sample-btn" type="button" class="font-medium text-red-400 underline transition-colors hover:text-red-300">Reload Sample Data</button>
        </div>
      </section>
    </main>
  </div>

  <!-- ================= VIEW RECORD DETAILS MODAL ================= -->
  <div id="view-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-xs">
    <div class="relative max-h-[92vh] w-full max-w-2xl overflow-y-auto border border-white/15 border-t-4 border-t-blue-500 bg-[#161920] p-6 shadow-2xl sm:p-8">
      <!-- Close button (top right) -->
      <button
        id="view-modal-close-btn"
        type="button"
        class="absolute right-4 top-4 rounded-sm border border-white/15 p-1.5 text-white/60 transition-colors hover:border-white/40 hover:bg-white/10 hover:text-white"
        aria-label="Close"
        title="Close View Window (Esc)"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- Eyebrow & Title -->
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400">Quote Inspection</span>
        <div id="view-status-badge"></div>
      </div>
      <h2 id="view-title-ref" class="mt-1 font-mono text-2xl font-extrabold text-white sm:text-3xl tracking-tight">NSTS/QUOTE/...</h2>
      <div id="view-client-bar" class="mt-1 text-xs text-white/70"></div>

      <!-- View Content Sections -->
      <div class="mt-5 space-y-4 text-xs">
        <!-- 1. Quotation Details -->
        <div class="rounded border border-white/10 bg-[#0f1115] p-3.5 sm:p-4">
          <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <span class="font-bold uppercase tracking-wider text-white/70 text-[11px]">1. Quotation Details</span>
            <span id="view-quote-date" class="text-white/50 font-mono text-[11px]"></span>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-3">
            <div class="rounded bg-[#161920] p-2.5 border border-white/5">
              <span class="block text-[10px] uppercase font-semibold text-white/50">Basic Amount</span>
              <span id="view-quote-basic" class="mt-1 block font-mono text-sm font-bold text-white"></span>
            </div>
            <div class="rounded bg-[#161920] p-2.5 border border-white/5">
              <span class="block text-[10px] uppercase font-semibold text-amber-300/80">VAT (5%)</span>
              <span id="view-quote-vat" class="mt-1 block font-mono text-sm font-bold text-amber-300"></span>
            </div>
            <div class="rounded bg-flare/10 p-2.5 border border-flare/30">
