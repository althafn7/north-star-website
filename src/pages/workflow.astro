    // Cloud Sync Configuration & Integration
    const SYNC_API_ENDPOINT = "/api/sync";
    const RAW_GIST_ENDPOINT = "https://gist.githubusercontent.com/althafn7/96e888d176e236fa12728ddf0d5066e2/raw/user_backup_clean.json";
    const cloudSyncBtn = document.getElementById("cloud-sync-btn");
    const cloudSyncText = document.getElementById("cloud-sync-text");
    const cloudSyncIcon = document.getElementById("cloud-sync-icon");
    const footerSyncStatus = document.getElementById("footer-sync-status");
    let isSyncing = false;
    let syncDebounceTimer = null;

    function updateSyncUI(status, label) {
      if (!cloudSyncBtn) return;
      if (status === "syncing") {
        cloudSyncBtn.className = "inline-flex items-center gap-1.5 rounded-sm border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-medium text-amber-300 transition-colors";
        if (cloudSyncText) cloudSyncText.textContent = label || "Syncing...";
        if (cloudSyncIcon) cloudSyncIcon.classList.add("animate-spin");
      } else if (status === "synced") {
        cloudSyncBtn.className = "inline-flex items-center gap-1.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-medium text-emerald-300 transition-colors hover:border-emerald-400 hover:bg-emerald-500/20";
        if (cloudSyncText) cloudSyncText.textContent = label || "Live Synced";
        if (cloudSyncIcon) cloudSyncIcon.classList.remove("animate-spin");
        if (footerSyncStatus) {
          footerSyncStatus.textContent = "Live Cloud Active";
          footerSyncStatus.className = "font-semibold text-emerald-400";
        }
      } else if (status === "offline") {
        cloudSyncBtn.className = "inline-flex items-center gap-1.5 rounded-sm border border-white/20 bg-white/5 px-2.5 py-1.5 text-xs font-medium text-white/60 transition-colors";
        if (cloudSyncText) cloudSyncText.textContent = label || "Saved Locally";
        if (cloudSyncIcon) cloudSyncIcon.classList.remove("animate-spin");
        if (footerSyncStatus) {
          footerSyncStatus.textContent = "Saved Locally (Offline)";
          footerSyncStatus.className = "font-semibold text-amber-400";
        }
      }
    }

    async function syncToCloud(recordsToSave) {
      updateSyncUI("syncing", "Saving to cloud...");
      try {
        const res = await fetch(SYNC_API_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ records: recordsToSave })
        });
        if (res.ok) {
          const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          updateSyncUI("synced", `Synced ${nowStr}`);
        } else {
          updateSyncUI("offline", "Saved locally");
        }
      } catch (err) {
        console.warn("Cloud sync network unavailable, saved locally:", err);
        updateSyncUI("offline", "Saved locally");
      }
    }

    async function fetchFromCloud(silent = false) {
      if (!silent) updateSyncUI("syncing", "Checking cloud...");
      try {
        let cloudRecords = null;
        try {
          const res = await fetch(`${SYNC_API_ENDPOINT}?t=${Date.now()}`);
          if (res.ok) {
            const data = await res.json();
            if (data.success && Array.isArray(data.records) && data.records.length > 0) {
              cloudRecords = data.records;
            }
          }
        } catch (e) {
          console.warn("Primary cloud API offline, trying fallback...", e);
        }

        if (!cloudRecords) {
          const fallbackRes = await fetch(`${RAW_GIST_ENDPOINT}?t=${Date.now()}`);
          if (fallbackRes.ok) {
            const fbData = await fallbackRes.json();
            if (Array.isArray(fbData) && fbData.length > 0) {
              cloudRecords = fbData;
            }
          }
        }

        if (cloudRecords && Array.isArray(cloudRecords) && cloudRecords.length > 0) {
          records = cloudRecords;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
          render();
          const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          updateSyncUI("synced", `Live Synced ${nowStr}`);
          return true;
        } else {
          updateSyncUI("synced", "Up to date");
          return false;
        }
      } catch (err) {
        console.warn("Cloud fetch failed:", err);
        updateSyncUI("offline", "Offline");
        return false;
      }
    }

    // Data Management
    function loadRecords() {
      // Clear legacy sample keys
      try {
        localStorage.removeItem("nsts_workflow_records");
        localStorage.removeItem("nsts_workflow_records_2026");
        localStorage.removeItem("nsts_workflow_records_2026_v2");
        localStorage.removeItem("nsts_workflow_records_2026_v3");
      } catch (e) {}

      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            records = parsed;
          } else {
            records = REGISTER_2026_RECORDS;
            saveRecords();
          }
        } catch (e) {
          records = REGISTER_2026_RECORDS;
          saveRecords();
        }
      } else {
        records = REGISTER_2026_RECORDS;
        saveRecords();
      }

      // Check cloud live updates across all devices
      fetchFromCloud(true);
    }

    function saveRecords() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
      render();
      clearTimeout(syncDebounceTimer);
      syncDebounceTimer = setTimeout(() => {
        syncToCloud(records);
      }, 350);
    }

    // Helpers
    function fmtOmr(num) {
      if (!num || isNaN(num)) return "0.000";
      return Number(num).toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
    }

    function fmtDate(dStr) {
      if (!dStr) return "—";
      const parts = dStr.split("-");
      if (parts.length === 3) {
        const d = new Date(parts[0], parts[1] - 1, parts[2]);
        return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
      }
      return dStr;
    }

    function getStatusBadge(status) {
      switch (status) {
        case "Approved":
          return `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-300 ring-1 ring-emerald-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Approved
          </span>`;
        case "Pending":
          return `<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-semibold text-amber-300 ring-1 ring-amber-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span> Pending
          </span>`;
        case "Under Revision":
          return `<span class="inline-flex items-center gap-1 rounded-full bg-blue-500/15 px-2 py-0.5 text-[10px] font-semibold text-blue-300 ring-1 ring-blue-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span> Revision
          </span>`;
        case "Lost":
          return `<span class="inline-flex items-center gap-1 rounded-full bg-neutral-500/15 px-2 py-0.5 text-[10px] font-semibold text-neutral-400 ring-1 ring-neutral-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-neutral-400"></span> Lost
          </span>`;
        case "Dummy Quote":
          return `<span class="inline-flex items-center gap-1 rounded-full bg-purple-500/15 px-2 py-0.5 text-[10px] font-semibold text-purple-300 ring-1 ring-purple-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span> Dummy
          </span>`;
        default:
          return status;
      }
    }

    function getWorkBadge(workStatus) {
      switch (workStatus) {
        case "Completed":
          return `<span class="font-semibold text-emerald-400 text-[10.5px]">✔ Completed</span>`;
        case "In Progress":
          return `<span class="font-semibold text-amber-300 text-[10.5px]">⚡ In Progress</span>`;
        default:
          return `<span class="text-white/40 text-[10.5px]">⏳ Not Started</span>`;
      }
    }

    // Render Metrics & Table
    function render() {
      // 0. Update Year Category Tabs
      renderYearTabs();

      // 1. Calculate Metrics (scoped to selected year)
      const metricPool = selectedYear === "ALL" 
        ? records 
        : records.filter((r) => getRecordYear(r) === selectedYear);

      let totalQuoted = 0;
      let totalPo = 0;
      let poCount = 0;
      let pendingVal = 0;
      let pendingCount = 0;
      let invoicedTotal = 0;
      let invoicedCount = 0;

      metricPool.forEach((r) => {
        const qTot = Number(r.totalAmt || r.quoteAmt) || 0;
        const pTot = Number(r.poTotalAmt || r.poAmt) || 0;
        totalQuoted += qTot;

        if (r.status === "Approved") {
          totalPo += pTot > 0 ? pTot : qTot;
          poCount++;
        }
        if (r.status === "Pending") {
          pendingVal += qTot;
          pendingCount++;
        }
        const invs = Array.isArray(r.invoices) && r.invoices.length > 0
          ? r.invoices
          : (r.invoiceDate || r.invoiceNum ? [{ invAmt: pTot > 0 ? pTot : qTot }] : []);

        if (invs.length > 0) {
          const invSum = invs.reduce((sum, i) => sum + (Number(i.invAmt) || 0), 0);
          invoicedTotal += invSum;
          invoicedCount += invs.length;
        }
      });

      const currentScopeLabel = selectedYear === "ALL" ? "All" : selectedYear;
      metricQuotedTotal.textContent = fmtOmr(totalQuoted);
      metricQuotedCount.textContent = `${metricPool.length} quotes (${currentScopeLabel}) • incl. 5% VAT`;
      metricPoTotal.textContent = fmtOmr(totalPo);
      metricPoCount.textContent = `${poCount} approved (${currentScopeLabel}) • incl. 5% VAT`;
      metricPendingCount.textContent = pendingCount;
      metricPendingVal.textContent = `OMR ${fmtOmr(pendingVal)} incl. VAT`;
      metricInvoicedTotal.textContent = fmtOmr(invoicedTotal);
      metricInvoicedCount.textContent = `${invoicedCount} invoice(s) submitted`;

      // 2. Filter records
      const q = searchInput.value.trim().toLowerCase();
      const statusF = filterStatus.value;
      const workF = filterWork.value;
      const sortD = sortDate ? sortDate.value : "NEWEST";

      let filtered = records.filter((r) => {
        const matchesYear = selectedYear === "ALL" || getRecordYear(r) === selectedYear;
        const matchesStatus = statusF === "ALL" || r.status === statusF;
        const matchesWork = workF === "ALL" || r.workStatus === workF;
        const matchesQuery =
          !q ||
          (r.client && r.client.toLowerCase().includes(q)) ||
          (r.ref && r.ref.toLowerCase().includes(q)) ||
          (r.scope && r.scope.toLowerCase().includes(q)) ||
          (r.poNumber && r.poNumber.toLowerCase().includes(q)) ||
          (r.invoiceNum && r.invoiceNum.toLowerCase().includes(q));

        return matchesYear && matchesStatus && matchesWork && matchesQuery;
      });

      // Sort by Quote Date (Newest to Oldest vs Oldest to Newest)
      filtered.sort((a, b) => {
        const dateA = a.quoteDate || "";
        const dateB = b.quoteDate || "";
        if (dateA !== dateB) {
          return sortD === "OLDEST" ? dateA.localeCompare(dateB) : dateB.localeCompare(dateA);
        }
        const refA = a.ref || "";
        const refB = b.ref || "";
        return sortD === "OLDEST" ? refA.localeCompare(refB) : refB.localeCompare(refA);
      });

      if (sortIndicator) {
        sortIndicator.textContent = sortD === "OLDEST" ? "▲" : "▼";
      }

      recordCountEl.textContent = filtered.length;

      // 3. Render Table Rows
      if (filtered.length === 0) {
        tableBody.innerHTML = "";
        noRecordsMsg.classList.remove("hidden");
        return;
      }
      noRecordsMsg.classList.add("hidden");

      tableBody.innerHTML = filtered
        .map(
          (r) => `
        <tr class="transition-colors hover:bg-white/[0.03]">
          <!-- Ref & Date -->
          <td class="w-[105px] py-2 pl-2 pr-1">
            <button
              type="button"
              onclick="window._viewRecord('${r.id}')"
              class="block w-full text-left truncate font-mono font-bold text-white text-[10.5px] transition-colors hover:text-flare hover:underline focus:outline-none"
              title="Click to view full quote details"
            >
              ${r.ref || "—"}
            </button>
            <span class="mt-0.5 block text-[9.5px] text-white/50">${fmtDate(r.quoteDate)}</span>
          </td>

          <!-- Client -->
          <td class="w-[55px] px-1 py-2 font-bold text-white text-[10.5px]">
            ${r.client || "—"}
          </td>

          <!-- Scope -->
          <td class="px-2 py-2">
            <p class="line-clamp-2 text-[10.5px] leading-snug text-white/80" title="${r.scope || ""}">${r.scope || "—"}</p>
          </td>

          <!-- Quoted Total & VAT Breakdown (Option A) -->
          <td class="w-[95px] whitespace-nowrap px-1 py-2">
            <span class="font-mono font-bold text-white text-[10.5px]">OMR ${fmtOmr(r.totalAmt || r.quoteAmt)}</span>
            <span class="mt-0.5 block font-mono text-[9px] text-white/60">Base: ${fmtOmr(r.basicAmt || (r.totalAmt ? r.totalAmt / 1.05 : 0))}</span>
            <span class="block font-mono text-[9px] text-amber-300/80">VAT: ${fmtOmr(r.vatAmt || (r.totalAmt ? r.totalAmt - (r.totalAmt / 1.05) : 0))}</span>
          </td>

          <!-- Approval Status -->
          <td class="w-[95px] whitespace-nowrap px-1 py-2">
            ${getStatusBadge(r.status)}
          </td>

          <!-- PO Details (Option A) -->
          <td class="w-[100px] whitespace-nowrap px-1 py-2">
            ${
              r.poNumber
                ? `<span class="block truncate font-mono font-semibold text-emerald-400 text-[10.5px]" title="${r.poNumber}">${r.poNumber}</span>
                   <span class="mt-0.5 block font-mono font-bold text-white text-[10.5px]">OMR ${fmtOmr(r.poTotalAmt || r.poAmt)}</span>
                   ${
                     (r.poBasicAmt || r.poVatAmt)
                       ? `<span class="mt-0.5 block font-mono text-[9px] text-white/60">Base: ${fmtOmr(r.poBasicAmt)}</span>
                          <span class="block font-mono text-[9px] text-amber-300/80">VAT: ${fmtOmr(r.poVatAmt)}</span>`
                       : ""
                   }`
                : `<span class="text-white/30 text-[10.5px]">—</span>`
            }
          </td>

          <!-- Work Progress -->
          <td class="w-[88px] whitespace-nowrap px-1 py-2">
            <div class="text-[10.5px]">${getWorkBadge(r.workStatus)}</div>
            ${r.completionDate ? `<span class="block text-[9.5px] text-white/50">Done: ${fmtDate(r.completionDate)}</span>` : ""}
          </td>

          <!-- Invoicing (Multi-Invoice Support) -->
          <td class="w-[98px] whitespace-nowrap px-1 py-2">
            ${getInvoicingCell(r)}
          </td>

          <!-- Actions -->
          <td class="w-[82px] whitespace-nowrap py-2 pl-1 pr-1 text-left">
            <div class="inline-flex items-center gap-1">
              <button
                onclick="window._viewRecord('${r.id}')"
                class="rounded-xs border border-blue-500/30 bg-blue-500/10 px-1 py-0.5 text-[10.5px] font-medium text-blue-300 transition-colors hover:border-blue-500/60 hover:bg-blue-500/25"
                title="View full quote details"
                aria-label="View record"
              >
                <svg class="h-3 w-3 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
              <button
                onclick="window._editRecord('${r.id}')"
                class="rounded-xs border border-white/20 bg-white/5 px-1.5 py-0.5 text-[10.5px] font-medium text-white transition-colors hover:border-white/50 hover:bg-white/15"
                title="Edit record"
              >
                Edit
              </button>
              <button
                onclick="window._deleteRecord('${r.id}')"
                class="rounded-xs border border-red-500/30 bg-red-500/10 px-1 py-0.5 text-[10.5px] font-medium text-red-300 transition-colors hover:border-red-500/60 hover:bg-red-500/25"
                title="Delete record"
              >
                Del
              </button>
            </div>
          </td>
        </tr>
      `
        )
        .join("");
    }

    // Helper to render Invoicing column in main table
    function getInvoicingCell(r) {
      const invs = Array.isArray(r.invoices) && r.invoices.length > 0
        ? r.invoices
        : (r.invoiceDate || r.invoiceNum
            ? [{ invNum: r.invoiceNum || "Inv", invDate: r.invoiceDate || "", invAmt: Number(r.poTotalAmt || r.poAmt) || 0, remarks: "Full Invoice" }]
            : []);

      if (invs.length === 0) {
        return `<span class="text-white/30 text-[10.5px]">Not Invoiced</span>`;
      }

      const totalInvAmt = invs.reduce((sum, i) => sum + (Number(i.invAmt) || 0), 0);
      const poTarget = Number(r.poTotalAmt || r.poAmt) || 0;
      const isFullyInvoiced = poTarget > 0 && totalInvAmt >= (poTarget - 0.001);

      return `
        <div>
          <div class="flex items-center gap-1">
            <span class="font-mono font-bold text-white text-[10.5px]">OMR ${fmtOmr(totalInvAmt)}</span>
            <span class="rounded px-1 py-0.2 text-[9px] font-semibold ${isFullyInvoiced ? 'bg-emerald-500/20 text-emerald-300 ring-1 ring-emerald-500/30' : 'bg-blue-500/20 text-blue-300 ring-1 ring-blue-500/30'}">
              ${invs.length} inv${invs.length > 1 ? 's' : ''} ${isFullyInvoiced ? '✔' : ''}
            </span>
          </div>
          <div class="mt-0.5 space-y-0.5">
            ${invs.slice(0, 2).map(i => `
              <div class="leading-tight">
                ${i.invNum ? `<span class="block truncate font-mono text-[9px] font-semibold text-white/80" title="${i.invNum}">${i.invNum}</span>` : ''}
                <span class="block font-mono text-[9px] text-white/60">OMR ${fmtOmr(i.invAmt || 0)}</span>
              </div>
            `).join('')}
            ${invs.length > 2 ? `<span class="block text-[8.5px] text-flare">+${invs.length - 2} more...</span>` : ''}
          </div>
        </div>
      `;
    }

    // Modal Invoices State
    let currentModalInvoices = [];
    const modalInvoicesList = document.getElementById("modal-invoices-list");
    const modalNoInvoices = document.getElementById("modal-no-invoices");
    const btnAddInvoice = document.getElementById("btn-add-invoice");
    const modalInvTotal = document.getElementById("modal-inv-total");
    const modalInvPoTarget = document.getElementById("modal-inv-po-target");
    const modalInvBalancePill = document.getElementById("modal-inv-balance-pill");

    function updateModalInvoiceSummary() {
      if (!modalInvTotal || !modalInvPoTarget || !modalInvBalancePill) return;
      const totalInv = currentModalInvoices.reduce((sum, inv) => sum + (parseFloat(inv.invAmt) || 0), 0);
      const poTarget = parseFloat(document.getElementById("form-po-total-amt")?.value) || parseFloat(document.getElementById("form-total-amt")?.value) || 0;
      modalInvTotal.textContent = `OMR ${fmtOmr(totalInv)}`;
      modalInvPoTarget.textContent = `OMR ${fmtOmr(poTarget)}`;

      if (poTarget > 0) {
        if (totalInv >= (poTarget - 0.001)) {
          modalInvBalancePill.innerHTML = `<span class="text-emerald-400 bg-emerald-500/15 ring-1 ring-emerald-500/30 px-2 py-0.5 rounded">✔ Fully Invoiced (100%)</span>`;
        } else {
          const bal = poTarget - totalInv;
          modalInvBalancePill.innerHTML = `<span class="text-blue-300 bg-blue-500/15 ring-1 ring-blue-500/30 px-2 py-0.5 rounded">Remaining: OMR ${fmtOmr(bal)}</span>`;
        }
      } else {
        modalInvBalancePill.innerHTML = `<span class="text-white/50">${currentModalInvoices.length} invoice(s)</span>`;
      }
    }

    function renderModalInvoices() {
      if (!modalInvoicesList || !modalNoInvoices) return;
      modalInvoicesList.innerHTML = "";

      if (currentModalInvoices.length === 0) {
        modalNoInvoices.classList.remove("hidden");
      } else {
        modalNoInvoices.classList.add("hidden");
        currentModalInvoices.forEach((inv, idx) => {
          const row = document.createElement("div");
          row.className = "grid grid-cols-12 gap-2 items-center bg-[#0f1115] p-2.5 rounded border border-white/10";
          row.innerHTML = `
            <div class="col-span-12 sm:col-span-3">
              <label class="block text-[10px] font-semibold uppercase text-white/50">Invoice #</label>
              <input type="text" data-field="invNum" data-index="${idx}" placeholder="e.g. INV-001" value="${inv.invNum || ''}" class="inv-input mt-0.5 w-full border border-white/15 bg-[#161920] px-2 py-1.5 text-xs font-mono text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>
            <div class="col-span-12 sm:col-span-3">
              <label class="block text-[10px] font-semibold uppercase text-white/50">Date</label>
              <input type="date" data-field="invDate" data-index="${idx}" value="${inv.invDate || ''}" class="inv-input mt-0.5 w-full border border-white/15 bg-[#161920] px-2 py-1.5 text-xs text-white focus:border-flare focus:outline-none" />
            </div>
            <div class="col-span-12 sm:col-span-3">
              <label class="block text-[10px] font-semibold uppercase text-white/50">Amount (OMR)</label>
              <input type="number" step="0.001" data-field="invAmt" data-index="${idx}" placeholder="0.000" value="${inv.invAmt !== undefined && inv.invAmt !== null ? inv.invAmt : ''}" class="inv-input mt-0.5 w-full border border-white/15 bg-[#161920] px-2 py-1.5 text-xs font-mono font-bold text-flare placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>
            <div class="col-span-10 sm:col-span-2">
              <label class="block text-[10px] font-semibold uppercase text-white/50">Milestone / Scope</label>
              <input type="text" data-field="remarks" data-index="${idx}" placeholder="e.g. Part 1" value="${inv.remarks || ''}" class="inv-input mt-0.5 w-full border border-white/15 bg-[#161920] px-2 py-1.5 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>
            <div class="col-span-2 sm:col-span-1 flex items-end justify-center pt-3 sm:pt-0">
              <button type="button" data-remove-index="${idx}" class="btn-remove-inv p-1.5 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded transition-colors" title="Delete Part Invoice">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          `;
          modalInvoicesList.appendChild(row);
        });
      }
      updateModalInvoiceSummary();
    }

    // Modal Invoices Event Listeners
    if (btnAddInvoice) {
      btnAddInvoice.addEventListener("click", () => {
        const today = new Date().toISOString().split("T")[0];
        currentModalInvoices.push({
          invNum: "",
          invDate: today,
          invAmt: 0,
          remarks: `Part ${currentModalInvoices.length + 1}`
        });
        renderModalInvoices();
      });
    }

    if (modalInvoicesList) {
      modalInvoicesList.addEventListener("input", (e) => {
        const target = e.target;
        if (target && target.classList.contains("inv-input")) {
          const idx = parseInt(target.getAttribute("data-index"), 10);
          const field = target.getAttribute("data-field");
          if (!isNaN(idx) && currentModalInvoices[idx]) {
            currentModalInvoices[idx][field] = field === "invAmt" ? parseFloat(target.value) || 0 : target.value;
            updateModalInvoiceSummary();
          }
        }
      });

      modalInvoicesList.addEventListener("click", (e) => {
        const btn = e.target.closest(".btn-remove-inv");
        if (btn) {
          const idx = parseInt(btn.getAttribute("data-remove-index"), 10);
          if (!isNaN(idx)) {
            currentModalInvoices.splice(idx, 1);
            renderModalInvoices();
          }
        }
      });
    }

    // Modal Operations
    function openModal(editRecord = null) {
      if (editRecord) {
        modalEyebrow.textContent = "Edit Entry";
        modalTitle.textContent = "Update Workflow Record";
        document.getElementById("record-id").value = editRecord.id;
        document.getElementById("form-ref").value = editRecord.ref || "";
        document.getElementById("form-date").value = editRecord.quoteDate || "";
        document.getElementById("form-client").value = editRecord.client || "";
        const bAmt = editRecord.basicAmt !== undefined ? editRecord.basicAmt : (editRecord.quoteAmt ? editRecord.quoteAmt / 1.05 : "");
        const vAmt = editRecord.vatAmt !== undefined ? editRecord.vatAmt : (bAmt ? bAmt * 0.05 : "");
        const tAmt = editRecord.totalAmt || editRecord.quoteAmt || "";
        document.getElementById("form-basic-amt").value = bAmt !== "" ? Number(bAmt).toFixed(3) : "";
        document.getElementById("form-vat-amt").value = vAmt !== "" ? Number(vAmt).toFixed(3) : "";
        document.getElementById("form-total-amt").value = tAmt !== "" ? Number(tAmt).toFixed(3) : "";

        document.getElementById("form-scope").value = editRecord.scope || "";
        document.getElementById("form-status").value = editRecord.status || "Pending";
        document.getElementById("form-po-number").value = editRecord.poNumber || "";

        const poBase = editRecord.poBasicAmt !== undefined ? editRecord.poBasicAmt : (editRecord.poAmt ? editRecord.poAmt / 1.05 : "");
        const poVat = editRecord.poVatAmt !== undefined ? editRecord.poVatAmt : (poBase ? poBase * 0.05 : "");
        const poTot = editRecord.poTotalAmt || editRecord.poAmt || "";
        document.getElementById("form-po-basic-amt").value = poBase !== "" ? Number(poBase).toFixed(3) : "";
        document.getElementById("form-po-vat-amt").value = poVat !== "" ? Number(poVat).toFixed(3) : "";
        document.getElementById("form-po-total-amt").value = poTot !== "" ? Number(poTot).toFixed(3) : "";
        document.getElementById("form-work-status").value = editRecord.workStatus || "Not Started";
        document.getElementById("form-completed-date").value = editRecord.completionDate || "";

        if (Array.isArray(editRecord.invoices) && editRecord.invoices.length > 0) {
          currentModalInvoices = JSON.parse(JSON.stringify(editRecord.invoices));
        } else if (editRecord.invoiceNum || editRecord.invoiceDate) {
          currentModalInvoices = [{
            invNum: editRecord.invoiceNum || "",
            invDate: editRecord.invoiceDate || "",
            invAmt: Number(editRecord.poTotalAmt || editRecord.poAmt) || 0,
            remarks: "Part 1"
          }];
        } else {
          currentModalInvoices = [];
        }
        renderModalInvoices();
      } else {
        modalEyebrow.textContent = "New Entry";
        modalTitle.textContent = "Add Job / Quotation";
        recordForm.reset();
        document.getElementById("record-id").value = "";
        // Default today's date
        const today = new Date().toISOString().split("T")[0];
        document.getElementById("form-date").value = today;
        document.getElementById("form-ref").value = `NSTS/QUOTE/${String(records.length + 1).padStart(3, "0")}/2026`;
        document.getElementById("form-basic-amt").value = "";
        document.getElementById("form-vat-amt").value = "";
        document.getElementById("form-total-amt").value = "";
        document.getElementById("form-po-basic-amt").value = "";
        document.getElementById("form-po-vat-amt").value = "";
        document.getElementById("form-po-total-amt").value = "";
        currentModalInvoices = [];
        renderModalInvoices();
      }
      recordModal.classList.remove("hidden");
      recordModal.classList.add("flex");
    }

    function closeModal() {
      recordModal.classList.add("hidden");
      recordModal.classList.remove("flex");
    }

    // Auto-calculate VAT (5%) and Total on input
    const formBasicAmt = document.getElementById("form-basic-amt");
    const formVatAmt = document.getElementById("form-vat-amt");
    const formTotalAmt = document.getElementById("form-total-amt");

    if (formBasicAmt && formVatAmt && formTotalAmt) {
      formBasicAmt.addEventListener("input", () => {
        const base = parseFloat(formBasicAmt.value) || 0;
        const vat = Math.round(base * 0.05 * 1000) / 1000;
        formVatAmt.value = vat > 0 ? vat.toFixed(3) : (base > 0 ? "0.000" : "");
        formTotalAmt.value = (base + (parseFloat(formVatAmt.value) || vat)).toFixed(3);
        updateModalInvoiceSummary();
      });
      formVatAmt.addEventListener("input", () => {
        const base = parseFloat(formBasicAmt.value) || 0;
        const vat = parseFloat(formVatAmt.value) || 0;
        formTotalAmt.value = (base + vat).toFixed(3);
        updateModalInvoiceSummary();
      });
    }

    const formPoBasicAmt = document.getElementById("form-po-basic-amt");
    const formPoVatAmt = document.getElementById("form-po-vat-amt");
    const formPoTotalAmt = document.getElementById("form-po-total-amt");

    if (formPoBasicAmt && formPoVatAmt && formPoTotalAmt) {
      formPoBasicAmt.addEventListener("input", () => {
        const base = parseFloat(formPoBasicAmt.value) || 0;
        const vat = Math.round(base * 0.05 * 1000) / 1000;
        formPoVatAmt.value = vat > 0 ? vat.toFixed(3) : (base > 0 ? "0.000" : "");
        formPoTotalAmt.value = (base + (parseFloat(formPoVatAmt.value) || vat)).toFixed(3);
        updateModalInvoiceSummary();
      });
      formPoVatAmt.addEventListener("input", () => {
        const base = parseFloat(formPoBasicAmt.value) || 0;
        const vat = parseFloat(formPoVatAmt.value) || 0;
        formPoTotalAmt.value = (base + vat).toFixed(3);
        updateModalInvoiceSummary();
      });
    }

    openCreateBtn.addEventListener("click", () => openModal(null));
    modalCloseBtn.addEventListener("click", closeModal);
    modalCancelBtn.addEventListener("click", closeModal);
    recordModal.addEventListener("click", (e) => {
      if (e.target === recordModal) closeModal();
    });

    // Form Save
    recordForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const id = document.getElementById("record-id").value || `rec_${Date.now()}`;
      const basicAmt = parseFloat(document.getElementById("form-basic-amt").value) || 0;
      const vatAmt = parseFloat(document.getElementById("form-vat-amt").value) || 0;
      const totalAmt = parseFloat(document.getElementById("form-total-amt").value) || (basicAmt + vatAmt);

      const poBasicAmt = parseFloat(document.getElementById("form-po-basic-amt").value) || 0;
      const poVatAmt = parseFloat(document.getElementById("form-po-vat-amt").value) || 0;
      const poTotalAmt = parseFloat(document.getElementById("form-po-total-amt").value) || (poBasicAmt + poVatAmt);

      const updated = {
        id,
        ref: document.getElementById("form-ref").value.trim(),
        quoteDate: document.getElementById("form-date").value,
        client: document.getElementById("form-client").value.trim(),
        basicAmt,
        vatAmt,
        totalAmt,
        quoteAmt: totalAmt,
        scope: document.getElementById("form-scope").value.trim(),
        status: document.getElementById("form-status").value,
        poNumber: document.getElementById("form-po-number").value.trim(),
        poBasicAmt,
        poVatAmt,
        poTotalAmt,
        poAmt: poTotalAmt,
        workStatus: document.getElementById("form-work-status").value,
        completionDate: document.getElementById("form-completed-date").value,
        invoices: currentModalInvoices,
        invoiceNum: currentModalInvoices.length > 0 ? currentModalInvoices.map(i => i.invNum).filter(Boolean).join(", ") : "",
        invoiceDate: currentModalInvoices.length > 0 ? (currentModalInvoices[currentModalInvoices.length - 1].invDate || "") : ""
      };

      const existingIndex = records.findIndex((r) => r.id === id);
      if (existingIndex >= 0) {
        records[existingIndex] = updated;
      } else {
        records.unshift(updated);
      }

      saveRecords();
      closeModal();
    });

    // ================= View Record Modal Operations =================
    const viewModal = document.getElementById("view-modal");
    const viewModalCloseBtn = document.getElementById("view-modal-close-btn");
    const viewModalCloseBottomBtn = document.getElementById("view-modal-close-bottom-btn");
    const viewModalEditBtn = document.getElementById("view-modal-edit-btn");
    let activeViewingRecord = null;

    function closeViewModal() {
      if (!viewModal) return;
      viewModal.classList.add("hidden");
      viewModal.classList.remove("flex");
      activeViewingRecord = null;
    }

    if (viewModalCloseBtn) viewModalCloseBtn.addEventListener("click", closeViewModal);
    if (viewModalCloseBottomBtn) viewModalCloseBottomBtn.addEventListener("click", closeViewModal);
    if (viewModal) {
      viewModal.addEventListener("click", (e) => {
        if (e.target === viewModal) closeViewModal();
      });
    }

    if (viewModalEditBtn) {
      viewModalEditBtn.addEventListener("click", () => {
        if (activeViewingRecord) {
          const recToEdit = activeViewingRecord;
          closeViewModal();
          openModal(recToEdit);
        }
      });
    }

    // Keyboard ESC to close any open modal
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeViewModal();
        closeModal();
      }
    });

    function openViewModal(r) {
      if (!r || !viewModal) return;
      activeViewingRecord = r;

      document.getElementById("view-title-ref").textContent = r.ref || "Untitled Quote";
      document.getElementById("view-client-bar").innerHTML = `Client: <strong class="text-white">${r.client || "—"}</strong>`;
      document.getElementById("view-status-badge").innerHTML = getStatusBadge(r.status);
      document.getElementById("view-quote-date").textContent = fmtDate(r.quoteDate);

      const bAmt = Number(r.basicAmt !== undefined ? r.basicAmt : (r.totalAmt ? r.totalAmt / 1.05 : 0)) || 0;
      const vAmt = Number(r.vatAmt !== undefined ? r.vatAmt : (r.totalAmt ? r.totalAmt - (r.totalAmt / 1.05) : 0)) || 0;
      const tAmt = Number(r.totalAmt || r.quoteAmt) || 0;

      document.getElementById("view-quote-basic").textContent = `OMR ${fmtOmr(bAmt)}`;
      document.getElementById("view-quote-vat").textContent = `OMR ${fmtOmr(vAmt)}`;
      document.getElementById("view-quote-total").textContent = `OMR ${fmtOmr(tAmt)}`;
      document.getElementById("view-scope").textContent = r.scope || "No scope description entered.";

      // PO Details
      const poEl = document.getElementById("view-po-details-body");
      const poNumberEl = document.getElementById("view-po-number-badge");
      if (r.poNumber) {
        poNumberEl.textContent = `PO: ${r.poNumber}`;
        const poBase = Number(r.poBasicAmt !== undefined ? r.poBasicAmt : (r.poTotalAmt ? r.poTotalAmt / 1.05 : 0)) || 0;
        const poVat = Number(r.poVatAmt !== undefined ? r.poVatAmt : (r.poTotalAmt ? r.poTotalAmt - (r.poTotalAmt / 1.05) : 0)) || 0;
        const poTot = Number(r.poTotalAmt || r.poAmt) || 0;
        poEl.innerHTML = `
          <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
            <div class="rounded bg-[#161920] p-2.5 border border-white/5">
              <span class="block text-[10px] uppercase font-semibold text-white/50">PO Basic Amount</span>
              <span class="mt-1 block font-mono text-sm font-bold text-white">OMR ${fmtOmr(poBase)}</span>
            </div>
            <div class="rounded bg-[#161920] p-2.5 border border-white/5">
              <span class="block text-[10px] uppercase font-semibold text-amber-300/80">PO VAT (5%)</span>
              <span class="mt-1 block font-mono text-sm font-bold text-amber-300">OMR ${fmtOmr(poVat)}</span>
            </div>
            <div class="rounded bg-emerald-500/10 p-2.5 border border-emerald-500/30">
              <span class="block text-[10px] uppercase font-semibold text-emerald-400">PO Total Value</span>
              <span class="mt-1 block font-mono text-sm font-extrabold text-emerald-400">OMR ${fmtOmr(poTot)}</span>
            </div>
          </div>
        `;
      } else {
        poNumberEl.textContent = "No PO Issued";
        poEl.innerHTML = `<p class="text-white/40 italic">Pending approval / No purchase order recorded yet.</p>`;
      }

      // Work status & Invoices
      document.getElementById("view-work-badge").innerHTML = `
        <div class="flex items-center gap-2">
          ${getWorkBadge(r.workStatus)}
          ${r.completionDate ? `<span class="text-white/50 font-mono text-[11px]">(Done: ${fmtDate(r.completionDate)})</span>` : ""}
        </div>
      `;

      const invs = Array.isArray(r.invoices) && r.invoices.length > 0
        ? r.invoices
        : (r.invoiceDate || r.invoiceNum
            ? [{ invNum: r.invoiceNum || "Inv", invDate: r.invoiceDate || "", invAmt: Number(r.poTotalAmt || r.poAmt) || 0, remarks: "Full Invoice" }]
            : []);

      const invSummaryEl = document.getElementById("view-invoices-summary");
      if (invs.length === 0) {
        invSummaryEl.innerHTML = `<p class="text-white/40 italic">No invoices submitted yet.</p>`;
      } else {
        const totalInv = invs.reduce((sum, i) => sum + (Number(i.invAmt) || 0), 0);
        const poTarget = Number(r.poTotalAmt || r.poAmt) || 0;
        const balance = poTarget > 0 ? (poTarget - totalInv) : 0;
        const isFullyInvoiced = poTarget > 0 && totalInv >= (poTarget - 0.001);

        invSummaryEl.innerHTML = `
          <div class="space-y-2">
            <div class="divide-y divide-white/5 rounded border border-white/10 bg-[#161920]">
              ${invs.map((i, idx) => `
                <div class="flex flex-wrap items-center justify-between gap-2 p-2.5 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[10px] text-white/70">#${idx + 1}</span>
                    <strong class="font-mono text-white">${i.invNum || "Inv"}</strong>
                    ${i.invDate ? `<span class="text-white/50 text-[11px]">(${fmtDate(i.invDate)})</span>` : ""}
                    ${i.remarks ? `<span class="text-white/40 text-[11px] italic">• ${i.remarks}</span>` : ""}
                  </div>
                  <span class="font-mono font-bold text-flare">OMR ${fmtOmr(i.invAmt || 0)}</span>
                </div>
              `).join("")}
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 rounded border border-white/10 bg-[#161920] px-3 py-2 text-xs">
              <div class="flex items-center gap-3 text-white/70">
                <span>Total Invoiced: <strong class="font-mono text-flare">OMR ${fmtOmr(totalInv)}</strong></span>
                ${poTarget > 0 ? `<span>PO Target: <strong class="font-mono text-white">OMR ${fmtOmr(poTarget)}</strong></span>` : ""}
              </div>
              <div>
                ${
                  poTarget > 0
                    ? (isFullyInvoiced
                        ? `<span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-emerald-300">Fully Invoiced ✔</span>`
                        : `<span class="rounded bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold text-amber-300">Balance: OMR ${fmtOmr(balance)}</span>`)
                    : ""
                }
              </div>
            </div>
          </div>
        `;
      }

      viewModal.classList.remove("hidden");
      viewModal.classList.add("flex");
    }

    // Expose Global view/edit/delete for inline table buttons
    window._viewRecord = function (id) {
      const rec = records.find((r) => r.id === id);
      if (rec) openViewModal(rec);
    };

    window._editRecord = function (id) {
      const rec = records.find((r) => r.id === id);
      if (rec) openModal(rec);
    };

    window._deleteRecord = function (id) {
      const rec = records.find((r) => r.id === id);
      if (rec && confirm(`Delete quote "${rec.ref}" for ${rec.client}?`)) {
        records = records.filter((r) => r.id !== id);
        saveRecords();
      }
    };

    // Filter & Sort Listeners
    searchInput.addEventListener("input", render);
    filterStatus.addEventListener("change", render);
    filterWork.addEventListener("change", render);

    if (sortDate) {
      sortDate.addEventListener("change", render);
    }

    if (thSortDate && sortDate) {
      thSortDate.addEventListener("click", () => {
        sortDate.value = sortDate.value === "NEWEST" ? "OLDEST" : "NEWEST";
        render();
      });
    }

    // Export to Excel / CSV
    exportCsvBtn.addEventListener("click", () => {
      if (records.length === 0) {
        alert("No records to export.");
        return;
      }
      const headers = [
        "Quote Ref",
        "Quote Date",
        "Client",
        "Scope Description",
        "Basic Quoted (OMR)",
        "VAT 5% (OMR)",
        "Total Quoted (OMR)",
        "Approval Status",
        "PO Number",
        "PO Basic (OMR)",
        "PO VAT 5% (OMR)",
        "PO Total (OMR)",
        "Work Status",
        "Completion Date",
        "Total Invoiced (OMR)",
        "Invoices Breakdown"
      ];

      const rows = records.map((r) => {
        const invs = Array.isArray(r.invoices) && r.invoices.length > 0
          ? r.invoices
          : (r.invoiceDate || r.invoiceNum ? [{ invNum: r.invoiceNum || "", invDate: r.invoiceDate || "", invAmt: Number(r.poTotalAmt || r.poAmt) || 0 }] : []);
        const totalInv = invs.reduce((sum, i) => sum + (Number(i.invAmt) || 0), 0);
        const invSummary = invs.map(i => `${i.invNum || "Inv"}: ${i.invAmt || 0} OMR (${i.invDate || ""})`).join(" | ");

        return [
          `"${(r.ref || "").replace(/"/g, '""')}"`,
          `"${r.quoteDate || ""}"`,
          `"${(r.client || "").replace(/"/g, '""')}"`,
          `"${(r.scope || "").replace(/"/g, '""')}"`,
          r.basicAmt || 0,
          r.vatAmt || 0,
          r.totalAmt || r.quoteAmt || 0,
          `"${r.status || ""}"`,
          `"${r.poNumber || ""}"`,
          r.poBasicAmt || 0,
          r.poVatAmt || 0,
          r.poTotalAmt || r.poAmt || 0,
          `"${r.workStatus || ""}"`,
          `"${r.completionDate || ""}"`,
          totalInv,
          `"${invSummary.replace(/"/g, '""')}"`
        ];
      });

      const csvContent = [headers.join(","), ...rows.map((r) => r.join(","))].join("\n");
      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `NorthStar_Workflow_Export_${new Date().toISOString().split("T")[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Backup JSON
    backupJsonBtn.addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(records, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `NorthStar_Backup_${new Date().toISOString().split("T")[0]}.json`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Reload 2026 Register
    resetSampleBtn.addEventListener("click", () => {
      if (confirm("Reset table to official 2026 Register? (Will replace current records)")) {
        records = REGISTER_2026_RECORDS;
        saveRecords();
      }
    });

    // Cloud Sync Listeners
    if (cloudSyncBtn) {
      cloudSyncBtn.addEventListener("click", () => {
        fetchFromCloud(false);
      });
    }

    // Auto-fetch fresh cloud updates whenever user returns to window/tab (e.g. switches from mobile to laptop)
    window.addEventListener("focus", () => {
      fetchFromCloud(true);
    });

    // Run
    checkAuth();
  </script>
</body>
</html>
