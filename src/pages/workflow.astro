              <input type="text" id="form-ref" required placeholder="e.g. NSTS-QT-2601" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
