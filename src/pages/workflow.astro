    // State
    let records = [];
    let selectedYear = (function() {
      try { return localStorage.getItem("nsts_workflow_selected_year") || "ALL"; } catch (e) { return "ALL"; }
    })();

    function getRecordYear(r) {
      if (!r) return "";
      if (r.ref && typeof r.ref === "string") {
        const refMatch = r.ref.match(/20\d\d/);
        if (refMatch) return refMatch[0];
      }
      if (r.quoteDate && typeof r.quoteDate === "string") {
        const parts = r.quoteDate.split("-");
        if (parts[0] && parts[0].length === 4) return parts[0];
      }
      return "";
    }

    function getAvailableYears() {
      const currentCalYear = new Date().getFullYear();
      const yearSet = new Set(["2025", "2026"]);

      // Automatically include 2027 and future years once calendar reaches 2027
      if (currentCalYear >= 2027) {
        for (let y = 2026; y <= currentCalYear; y++) {
          yearSet.add(String(y));
        }
      }

      // Also scan all records for any year present
      records.forEach((r) => {
        const y = getRecordYear(r);
        if (y && y.length === 4) yearSet.add(y);
      });

      return Array.from(yearSet).sort();
    }

    function renderYearTabs() {
      const container = document.getElementById("year-tabs-container");
      if (!container) return;

      const years = getAvailableYears();
      const allCounts = { ALL: records.length };
      years.forEach((y) => {
        allCounts[y] = records.filter((r) => getRecordYear(r) === y).length;
      });

      const tabs = ["ALL", ...years];
      if (!tabs.includes(selectedYear)) {
        selectedYear = "ALL";
      }

      container.innerHTML = tabs
        .map((tab) => {
          const isActive = selectedYear === tab;
          const label = tab === "ALL" ? "All Years" : tab;
          const count = allCounts[tab] || 0;
          const activeClasses = "bg-flare text-white font-bold shadow-sm border-flare";
          const inactiveClasses = "bg-[#161920] border-white/15 text-white/70 hover:border-white/30 hover:text-white";

          return `
            <button
              type="button"
              data-year="${tab}"
              class="year-tab-btn inline-flex items-center gap-1.5 rounded-sm border px-3 py-1.5 text-xs transition-colors ${isActive ? activeClasses : inactiveClasses}"
            >
              <span>${label}</span>
              <span class="rounded-full px-1.5 py-0.2 text-[10px] ${isActive ? 'bg-white/20 text-white' : 'bg-white/10 text-white/60'}">${count}</span>
            </button>
          `;
        })
        .join("");

      container.querySelectorAll(".year-tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const y = btn.getAttribute("data-year");
          if (y) {
            selectedYear = y;
            try { localStorage.setItem("nsts_workflow_selected_year", y); } catch (e) {}
            render();
          }
        });
      });

      const badge = document.getElementById("year-filter-badge");
      if (badge) {
        if (selectedYear === "ALL") {
          badge.innerHTML = `Viewing: <strong class="text-red-300 font-bold">All Years (${records.length} quotes)</strong>`;
        } else {
          const yCount = allCounts[selectedYear] || 0;
          badge.innerHTML = `Viewing: <strong class="text-red-300 font-bold">${selectedYear} Register</strong> <span class="text-red-400">(${yCount} quotes)</span>`;
        }
      }
    }

