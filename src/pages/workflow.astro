    // Forgot Password Operations
    const forgotModal = document.getElementById("forgot-modal");
    const openForgotBtn = document.getElementById("open-forgot-modal-btn");
    const closeForgotBtn = document.getElementById("forgot-modal-close-btn");
    const cancelForgotBtn = document.getElementById("forgot-cancel-btn");
    const forgotForm = document.getElementById("forgot-form");
    const recoveryEmailInput = document.getElementById("recovery-email");
    const recoveryNewPassGroup = document.getElementById("recovery-new-pass-group");
    const newPassInput = document.getElementById("new-password");
    const confirmPassInput = document.getElementById("confirm-password");
    const forgotMsg = document.getElementById("forgot-msg");
    const forgotSubmitBtn = document.getElementById("forgot-submit-btn");

    function openForgotModal() {
      if (!forgotForm) return;
      forgotForm.reset();
      recoveryEmailInput.value = "";
      recoveryEmailInput.removeAttribute("readonly");
      recoveryEmailInput.classList.remove("opacity-60", "cursor-not-allowed");
      recoveryNewPassGroup.classList.add("hidden");
      forgotMsg.classList.add("hidden");
      forgotMsg.className = "hidden rounded-sm p-2.5 text-xs font-medium";
      forgotSubmitBtn.textContent = "Verify Email & Continue";
      forgotModal.classList.remove("hidden");
      forgotModal.classList.add("flex");
    }

    function closeForgotModal() {
      if (!forgotModal) return;
      forgotModal.classList.add("hidden");
      forgotModal.classList.remove("flex");
    }

    if (openForgotBtn) openForgotBtn.addEventListener("click", openForgotModal);
    if (closeForgotBtn) closeForgotBtn.addEventListener("click", closeForgotModal);
    if (cancelForgotBtn) cancelForgotBtn.addEventListener("click", closeForgotModal);
    if (forgotModal) {
      forgotModal.addEventListener("click", (e) => {
        if (e.target === forgotModal) closeForgotModal();
      });
    }

    if (forgotForm) {
      forgotForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = recoveryEmailInput.value.trim().toLowerCase();
        if (email !== RECOVERY_EMAIL.toLowerCase()) {
          forgotMsg.textContent = "Verification failed: The email entered does not match the registered company recovery address.";
          forgotMsg.className = "rounded-sm bg-red-900/40 p-2.5 text-xs font-medium text-red-300 block";
          return;
        }

        // Step 1: Reveal new password inputs
        if (recoveryNewPassGroup.classList.contains("hidden")) {
          recoveryNewPassGroup.classList.remove("hidden");
          recoveryEmailInput.setAttribute("readonly", "true");
          recoveryEmailInput.classList.add("opacity-60", "cursor-not-allowed");
          forgotMsg.textContent = "Identity verified. Please enter and confirm your new portal password below.";
          forgotMsg.className = "rounded-sm bg-emerald-900/40 p-2.5 text-xs font-medium text-emerald-300 block";
          forgotSubmitBtn.textContent = "Save New Password";
          newPassInput.focus();
          return;
        }

        // Step 2: Validate and save new password
        const p1 = newPassInput.value;
        const p2 = confirmPassInput.value;
        if (!p1 || p1.length < 4) {
          forgotMsg.textContent = "New password must be at least 4 characters long.";
          forgotMsg.className = "rounded-sm bg-amber-900/40 p-2.5 text-xs font-medium text-amber-300 block";
          return;
        }
        if (p1 !== p2) {
          forgotMsg.textContent = "Passwords do not match. Please re-enter.";
          forgotMsg.className = "rounded-sm bg-red-900/40 p-2.5 text-xs font-medium text-red-300 block";
          return;
        }

        localStorage.setItem(CUSTOM_PASS_KEY, p1);
        forgotMsg.textContent = "Password successfully reset! Logging you in...";
        forgotMsg.className = "rounded-sm bg-emerald-900/40 p-2.5 text-xs font-medium text-emerald-300 block";
        setTimeout(() => {
          closeForgotModal();
          const passEl = document.getElementById("password");
          if (passEl) passEl.value = p1;
          localStorage.setItem(AUTH_KEY, "true");
          checkAuth();
        }, 1200);
      });
    }

    // Change Password (when logged in)
    const changePassBtn = document.getElementById("change-pass-btn");
    if (changePassBtn) {
      changePassBtn.addEventListener("click", () => {
        const currentPass = getActivePassword();
        const oldP = prompt("Enter current portal password:");
        if (oldP === null) return;
        if (oldP !== currentPass) {
          alert("Incorrect current password.");
          return;
        }
        const newP = prompt("Enter new password (min 4 characters):");
        if (!newP) return;
        if (newP.length < 4) {
          alert("Password must be at least 4 characters long.");
          return;
        }
        const confirmP = prompt("Confirm new password:");
        if (newP !== confirmP) {
          alert("Passwords do not match.");
          return;
        }
        localStorage.setItem(CUSTOM_PASS_KEY, newP);
        alert("Password updated successfully!");
      });
    }

    // Logout
    logoutBtn.addEventListener("click", () => {
      if (confirm("Log out of North Star Operations Portal?")) {
        localStorage.removeItem(AUTH_KEY);
        checkAuth();
      }
