---
// North Star Technical Services LLC - Staff Attendance & Payroll Portal
// Dedicated web portal for monthly attendance, automated Oman Labor Law overtime, and official printable pay slips.
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Attendance &amp; Payroll Portal | North Star Technical Services LLC</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      @media print {
        @page {
          size: A4 portrait;
          margin: 12mm 15mm;
        }

        html, body {
          background: #ffffff !important;
          color: #000000 !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          height: auto !important;
          min-height: 0 !important;
          overflow: visible !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        /* 1. Completely remove all non-printable dashboard elements from layout */
        #login-gate,
        #admin-app,
        #employee-modal,
        #timesheet-modal,
        .no-print,
        header,
        footer {
          display: none !important;
        }

        /* 2. Un-fix payslip modal so it flows as a normal top-level document */
        #payslip-modal {
          display: block !important;
          position: static !important;
          inset: auto !important;
          width: 100% !important;
          height: auto !important;
          min-height: 0 !important;
          max-height: none !important;
          overflow: visible !important;
          background: transparent !important;
          padding: 0 !important;
          margin: 0 !important;
          border: none !important;
          box-shadow: none !important;
          backdrop-filter: none !important;
          -webkit-backdrop-filter: none !important;
          z-index: auto !important;
        }

        #payslip-modal > div {
          display: block !important;
          position: static !important;
          width: 100% !important;
          max-width: 100% !important;
          height: auto !important;
          min-height: 0 !important;
          max-height: none !important;
          overflow: visible !important;
          background: transparent !important;
          border: none !important;
          box-shadow: none !important;
          padding: 0 !important;
          margin: 0 !important;
        }

        /* 3. Printable payslip document formatting */
        #printable-payslip {
          display: block !important;
          position: static !important;
          width: 100% !important;
          max-width: 100% !important;
          margin: 0 auto !important;
          padding: 24px !important;
          background: #ffffff !important;
          color: #000000 !important;
          border: 2px solid #000000 !important;
          border-radius: 0 !important;
          box-shadow: none !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }

        #printable-payslip * {
          visibility: visible !important;
          color: #000000 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        #printable-payslip table {
          width: 100% !important;
          border-collapse: collapse !important;
          border: 1.5px solid #000000 !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          margin-top: 16px !important;
        }

        #printable-payslip th,
        #printable-payslip td {
          border: 1px solid #000000 !important;
          padding: 8px 10px !important;
        }

        #printable-payslip thead,
        #printable-payslip tfoot {
          background-color: #f3f4f6 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        #slip-modal-doc-title {
          background-color: #000000 !important;
          color: #ffffff !important;
          border: 1px solid #000000 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#0b0d11] font-sans text-white/90 antialiased selection:bg-flare selection:text-white">
    <!-- ================= LOGIN GATEWAY ================= -->
    <div id="login-gate" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0b0d11] p-4">
      <div class="w-full max-w-md border border-white/10 bg-[#161920] p-8 shadow-2xl">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="North Star logo" class="h-10 w-auto" />
          <div class="border-l border-white/20 pl-3">
            <span class="block font-display text-lg font-extrabold text-white">NORTH STAR</span>
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-flare">Attendance &amp; Payroll</span>
          </div>
        </div>

        <h1 class="mt-6 text-xl font-bold text-white">Staff Payroll Portal</h1>
        <p class="mt-1 text-xs text-white/60">Authorized administrative access only. Sign in to manage staff attendance, calculate overtime, and generate pay slips.</p>

        <form id="login-form" class="mt-6 space-y-4">
          <div>
            <label for="username" class="block text-xs font-medium uppercase tracking-wider text-white/70">Username</label>
            <input
              type="text"
              id="username"
              required
              class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-3.5 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none"
              placeholder="e.g. admin"
              autocomplete="username"
            />
          </div>

          <div>
            <div class="flex items-center justify-between">
              <label for="password" class="block text-xs font-medium uppercase tracking-wider text-white/70">Password</label>
              <button
                type="button"
                id="open-forgot-modal-btn"
                class="text-[11px] font-medium text-flare transition-colors hover:underline"
              >
                Forgot Password?
              </button>
            </div>
            <input
              type="password"
              id="password"
              required
              class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-3.5 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none"
              placeholder="••••••••"
              autocomplete="current-password"
            />
          </div>

          <div id="login-error" class="hidden rounded-sm bg-red-950/60 border border-red-500/40 p-2.5 text-xs text-red-300">
            Invalid username or password. Please try again.
          </div>

          <button
            type="submit"
            class="w-full bg-flare py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition-colors hover:bg-red-700"
          >
            Sign In to Payroll
          </button>
        </form>

        <div class="mt-6 border-t border-white/10 pt-4 text-center">
          <a href="/workflow" class="text-xs text-white/50 transition-colors hover:text-white">
            ← Switch to Operations Portal (/workflow)
          </a>
        </div>
      </div>
    </div>

    <!-- ================= MAIN ATTENDANCE & PAYROLL APP ================= -->
    <div id="admin-app" class="hidden min-h-screen flex-col">
      <!-- Top Navigation -->
      <header class="sticky top-0 z-40 border-b border-white/10 bg-[#161920]/95 backdrop-blur-md">
        <div class="mx-auto flex max-w-[1440px] items-center justify-between px-3 py-3 sm:px-6">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-2.5" title="View live website">
              <img src="/logo.png" alt="North Star logo" class="h-9 w-auto" />
              <div class="border-l border-white/20 pl-2.5">
                <span class="block font-display text-lg font-extrabold leading-none tracking-wide text-white">NORTH STAR</span>
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-flare">Attendance &amp; Payroll</span>
              </div>
            </a>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 sm:gap-3">
            <a
              href="/workflow"
              class="inline-flex items-center gap-1.5 rounded-sm border border-white/15 px-3 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white"
              title="Operations Workflow Portal"
            >
              <span>Operations Portal</span>
              <svg class="h-3.5 w-3.5 text-flare" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>

            <button
              id="export-csv-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-sm border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/15"
              title="Export Current Month Payroll to CSV"
            >
              <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span class="hidden sm:inline">Export Payroll</span>
              <span class="sm:hidden">CSV</span>
            </button>

            <button
              id="cloud-sync-btn"
              type="button"
              title="Live Cloud Sync: Click to refresh and sync with cloud database"
              class="inline-flex items-center gap-1.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-medium text-emerald-300 transition-colors hover:border-emerald-400 hover:bg-emerald-500/20"
            >
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
              <span id="cloud-sync-text" class="hidden sm:inline">Live Synced</span>
              <svg id="cloud-sync-icon" class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            </button>

            <button
              id="open-create-employee-btn"
              type="button"
              class="inline-flex items-center gap-1.5 bg-flare px-3.5 py-1.5 text-xs font-semibold text-white shadow-md transition-colors hover:bg-red-700"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Add Employee</span>
            </button>

            <button
              id="open-create-temp-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-xs border border-purple-500/40 bg-purple-600/25 px-3 py-1.5 text-xs font-semibold text-purple-200 shadow-md transition-colors hover:bg-purple-600/40 hover:border-purple-400"
              title="Add Temporary Manpower (Hourly calculation e.g. T001)"
            >
              <svg class="h-4 w-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>+ Add Temp (Hourly)</span>
            </button>

            <button
              id="logout-btn"
              type="button"
              title="Log out"
              class="rounded-sm border border-white/15 p-1.5 text-white/60 transition-colors hover:border-red-500 hover:text-red-400"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="mx-auto w-full max-w-[1440px] flex-1 px-2.5 py-4 sm:px-4 lg:px-6">
        
        <!-- Summary Metric Cards -->
        <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
          <div class="border border-white/10 bg-[#161920] p-4 shadow-sm">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-white/50">Total Staff / Workers</span>
            <div class="mt-1.5 flex items-baseline gap-1">
              <span id="metric-staff-count" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
              <span class="text-xs font-medium text-white/50">employees</span>
            </div>
            <span id="metric-staff-sub" class="mt-1 block text-[11px] text-white/40">Registered in company</span>
          </div>

          <div class="border border-white/10 border-l-4 border-l-blue-500 bg-[#161920] p-4 shadow-sm">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-blue-400">Total Basic Payroll</span>
            <div class="mt-1.5 flex items-baseline gap-1">
              <span class="text-xs font-semibold text-blue-400">OMR</span>
              <span id="metric-basic-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0.000</span>
            </div>
            <span class="mt-1 block text-[11px] text-white/40">Fixed monthly basic</span>
          </div>

          <div class="border border-white/10 border-l-4 border-l-amber-500 bg-[#161920] p-4 shadow-sm">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-400">Total Overtime (OT)</span>
            <div class="mt-1.5 flex items-baseline gap-1">
              <span class="text-xs font-semibold text-amber-400">OMR</span>
              <span id="metric-ot-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0.000</span>
            </div>
            <span id="metric-ot-hours-sub" class="mt-1 block text-[11px] text-white/40">0 hrs total (125% rate)</span>
          </div>

          <div class="border border-white/10 border-l-4 border-l-emerald-500 bg-[#161920] p-4 shadow-sm">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-400">Net Monthly Payout</span>
            <div class="mt-1.5 flex items-baseline gap-1">
              <span class="text-xs font-semibold text-emerald-400">OMR</span>
              <span id="metric-net-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0.000</span>
            </div>
            <span id="metric-net-sub" class="mt-1 block text-[11px] text-white/40">Basic + Overtime</span>
          </div>
        </section>

        <!-- Salary Period & Controls Bar -->
        <section class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded border border-white/10 bg-[#161920] p-3.5 shadow-sm">
          <div class="flex flex-wrap items-center gap-3">
            <label for="period-select" class="text-xs font-bold uppercase tracking-wider text-red-400">Salary Period:</label>
            <input
              type="month"
              id="period-select"
              class="border border-white/20 bg-[#0f1115] px-3 py-1.5 text-xs font-mono font-bold text-white focus:border-flare focus:outline-none"
            />
            <div id="period-info-badge" class="inline-flex items-center gap-2 rounded bg-white/5 px-2.5 py-1 text-xs text-white/70">
              <!-- Dynamically populated: 30 days = 240 hrs -->
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <div class="relative min-w-[200px] sm:w-64">
              <input
                type="text"
                id="search-input"
                placeholder="Search staff name, ID, trade..."
                class="w-full border border-white/15 bg-[#0f1115] py-1.5 pl-8 pr-3 text-xs text-white placeholder-white/40 focus:border-flare focus:outline-none"
              />
              <svg class="absolute left-2.5 top-2 h-3.5 w-3.5 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <span class="text-xs font-semibold text-red-400">
              Showing <span id="staff-count-badge" class="font-bold text-red-300">0</span> staff
            </span>
          </div>
        </section>

        <!-- Attendance & Payroll Table -->
        <section class="mt-4 border border-white/10 bg-[#161920] shadow-xl">
          <div class="overflow-x-auto md:overflow-x-visible">
            <table class="w-full text-left text-xs">
              <thead class="sticky top-[60px] sm:top-[61px] z-30 border-b border-white/15 bg-[#1a1e27] text-[10.5px] font-bold uppercase tracking-wider text-white/70 shadow-md">
                <tr>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[75px] py-2.5 pl-2.5 pr-1">Emp #</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[160px] px-2 py-2.5">Staff Name</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[110px] px-1.5 py-2.5">Designation</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[125px] px-1.5 py-2.5" title="Month-specific basic salary (can be adjusted per month)">Basic (OMR) ✏️</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[85px] px-1.5 py-2.5">Std Hrs</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[95px] px-1.5 py-2.5">Rate / Hr</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[95px] px-1.5 py-2.5">OT Rate (125%)</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[100px] px-1.5 py-2.5">OT Hours</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[105px] px-1.5 py-2.5">OT Earning</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[115px] px-1.5 py-2.5">Net Pay (OMR)</th>
                  <th class="sticky top-[60px] sm:top-[61px] z-30 bg-[#1a1e27] w-[110px] py-2.5 pl-1 pr-2 text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="payroll-table-body" class="divide-y divide-white/5">
                <!-- Dynamically populated staff payroll rows -->
              </tbody>
            </table>
          </div>

          <div id="no-staff-msg" class="hidden py-12 text-center text-sm text-white/40">
            No employees found. Click "+ Add Employee" above to register staff.
          </div>
        </section>

        <!-- Bottom Utility Bar -->
        <section class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-red-400">
          <div class="font-medium text-red-400">
            Staff attendance &amp; payroll data is synchronized live across all devices (<span id="footer-sync-status" class="font-semibold text-emerald-400">Live Cloud Active</span>).
          </div>
          <div class="flex items-center gap-3">
            <button id="backup-json-btn" type="button" class="font-medium text-red-400 underline transition-colors hover:text-red-300">Download Attendance JSON</button>
            <span class="font-bold text-red-400">•</span>
            <button id="reset-sample-btn" type="button" class="font-medium text-red-400 underline transition-colors hover:text-red-300">Reload Initial 4 Staff</button>
          </div>
        </section>
      </main>
    </div>

    <!-- ================= DAILY TIMESHEET & OVERTIME MODAL ================= -->
    <div id="timesheet-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-3 sm:p-4 backdrop-blur-xs">
      <div class="relative max-h-[92vh] w-full max-w-2xl flex flex-col border border-white/20 border-t-4 border-t-amber-400 bg-[#161920] shadow-2xl">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between border-b border-white/10 p-5 sm:p-6 pb-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">Daily Attendance Log</span>
              <span id="ts-emp-badge" class="font-mono text-xs text-white/50"></span>
            </div>
            <h2 id="ts-emp-name" class="font-display text-xl sm:text-2xl font-bold text-white mt-0.5">Staff Name</h2>
            <div id="ts-period-info" class="text-xs text-white/60 mt-0.5">Month Information</div>
          </div>
          <button
            type="button"
            id="ts-close-top-btn"
            class="text-white/50 transition-colors hover:text-white p-1"
            title="Close (Esc)"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <!-- Quick Fill & Live Totals Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-2.5 bg-[#0f1115] px-5 py-3 border-b border-white/10 text-xs">
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="ts-fill-default-btn"
              class="rounded bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-white transition-colors hover:bg-white/20"
              title="Fill 8 normal hours for all working days"
            >
              Fill 8 Normal Hrs
            </button>
            <button
              type="button"
              id="ts-clear-ot-btn"
              class="rounded bg-white/5 px-2 py-1 text-[11px] font-semibold text-white/60 transition-colors hover:bg-white/15 hover:text-white"
              title="Reset all OT hours to 0"
            >
              Clear OT
            </button>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-white/60"><span id="ts-label-normal">Total Normal:</span> <strong id="ts-total-normal" class="text-white font-mono font-bold">0</strong> hrs</span>
            <span class="text-white/30">•</span>
            <span class="text-amber-400"><span id="ts-label-ot">Total OT:</span> <strong id="ts-total-ot" class="font-mono font-bold text-amber-300">0</strong></span>
          </div>
        </div>

        <!-- Scrollable Daily Grid -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 max-h-[55vh]">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="sticky top-0 z-10 border-b border-white/15 bg-[#1a1e27] text-[10.5px] font-bold uppercase tracking-wider text-white/70 shadow-sm">
              <tr>
                <th class="py-2 px-3 w-36">DATE</th>
                <th class="py-2 px-3 w-36 text-center">NORMAL HRS</th>
                <th class="py-2 px-3 w-36 text-center">OT HRS</th>
                <th class="py-2 px-3 text-right">DAY TOTAL</th>
              </tr>
            </thead>
            <tbody id="ts-days-tbody" class="divide-y divide-white/5 font-mono">
              <!-- Dynamically populated 1 to 28/29/30/31 days -->
            </tbody>
          </table>
        </div>

        <!-- Modal Footer -->
