    <!-- Client-Side Attendance Logic -->
    <script is:inline>
      const AUTH_KEY = "nsts_admin_auth";
      const STORAGE_KEY_ATTENDANCE = "nsts_attendance_payroll_v1";
      const CUSTOM_PASS_KEY = "nsts_custom_password";
      const DEFAULT_USER = "admin";
      const DEFAULT_PASS = "nsts2026";

      function getActivePassword() {
        return localStorage.getItem(CUSTOM_PASS_KEY) || DEFAULT_PASS;
      }

      // Initial Seed Employees (From official payslips & management directives)
      const INITIAL_EMPLOYEES = [
        { id: "emp_001", empNum: "001", name: "Nizamudeen A", designation: "General Manager", basic: 750.0 },
        { id: "emp_002", empNum: "002", name: "Suresh Kumar", designation: "Helper", basic: 150.0 },
        { id: "emp_003", empNum: "003", name: "Abdul Rahman", designation: "Fabrication", basic: 250.0 },
        { id: "emp_004", empNum: "004", name: "Mohammed Ahsan", designation: "Welder", basic: 170.0 },
        { id: "emp_005", empNum: "005", name: "Muhammed Joshim", designation: "Helper", basic: 180.0 },
        { id: "emp_006", empNum: "006", name: "Althaf Nizam", designation: "Operations Manager", basic: 400.0 },
        { id: "emp_007", empNum: "007", name: "Bavaneeth K", designation: "Mechanical Engineer", basic: 350.0 }
      ];

      function mergeSeedEmployees(currentList) {
        const map = new Map();
        INITIAL_EMPLOYEES.forEach(emp => map.set(emp.empNum || emp.id, { ...emp }));
        if (Array.isArray(currentList)) {
          currentList.forEach(emp => {
            const key = emp.empNum || emp.id;
            if (map.has(key)) {
              map.set(key, { ...map.get(key), ...emp });
            } else {
              map.set(key, emp);
            }
          });
        }
        return Array.from(map.values()).sort((a, b) => (a.empNum || "").localeCompare(b.empNum || ""));
      }

      // State:
      // employees: array of { id, empNum, name, designation, basic }
      // monthlyData: map of { "YYYY-MM": { "empId": { otHours: 17 } } }
      let employees = [];
      let monthlyData = {};
      let selectedPeriod = "";

      // Days in Month Calculator
      function getDaysInMonth(year, month) {
        return new Date(year, month, 0).getDate();
      }

      function getPeriodDetails(periodStr) {
        if (!periodStr) {
          const now = new Date();
          const y = now.getFullYear();
          const m = String(now.getMonth() + 1).padStart(2, "0");
          periodStr = `${y}-${m}`;
        }
        const [yearStr, monthStr] = periodStr.split("-");
        const y = parseInt(yearStr, 10);
        const m = parseInt(monthStr, 10);
        const days = getDaysInMonth(y, m);
        const totalHrs = days * 8;
        return { year: y, month: m, days, totalHrs, periodStr };
      }

      function fmtOmr(n) {
        return (Number(n) || 0).toLocaleString("en-US", {
          minimumFractionDigits: 3,
          maximumFractionDigits: 3
        });
      }

      // Load & Save
      function loadData() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY_ATTENDANCE);
          if (raw) {
            const parsed = JSON.parse(raw);
            employees = mergeSeedEmployees(parsed.employees);
            monthlyData = parsed.monthlyData || {};
          } else {
            employees = JSON.parse(JSON.stringify(INITIAL_EMPLOYEES));
            monthlyData = {
              "2026-04": { "emp_002": { otHours: 17 } },
              "2026-05": { "emp_003": { otHours: 54 } },
              "2026-01": { "emp_005": { otHours: 94 } }
            };
          }
        } catch (e) {
          employees = JSON.parse(JSON.stringify(INITIAL_EMPLOYEES));
          monthlyData = {};
        }
      }

      function saveData() {
        try {
          const payload = { employees, monthlyData };
          localStorage.setItem(STORAGE_KEY_ATTENDANCE, JSON.stringify(payload));
          syncToCloud(payload);
        } catch (e) {
          console.error("Save error:", e);
        }
      }

      async function syncToCloud(payload) {
        const syncText = document.getElementById("cloud-sync-text");
        const syncIcon = document.getElementById("cloud-sync-icon");
        if (syncIcon) syncIcon.classList.add("animate-spin");
        if (syncText) syncText.textContent = "Syncing...";

        try {
          const res = await fetch("/api/attendance-sync", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ data: payload })
          });
          if (res.ok) {
            if (syncText) syncText.textContent = "Live Synced";
          } else {
            if (syncText) syncText.textContent = "Saved";
          }
        } catch (e) {
          if (syncText) syncText.textContent = "Saved";
        } finally {
          if (syncIcon) syncIcon.classList.remove("animate-spin");
        }
      }

      async function pullFromCloud() {
        const syncText = document.getElementById("cloud-sync-text");
        const syncIcon = document.getElementById("cloud-sync-icon");
        if (syncIcon) syncIcon.classList.add("animate-spin");

        try {
          const res = await fetch("/api/attendance-sync?cb=" + Date.now());
          if (res.ok) {
            const result = await res.json();
            if (result && result.data && Array.isArray(result.data.employees)) {
              employees = mergeSeedEmployees(result.data.employees);
              monthlyData = result.data.monthlyData || {};
              localStorage.setItem(STORAGE_KEY_ATTENDANCE, JSON.stringify({ employees, monthlyData }));
              render();
              if (syncText) syncText.textContent = "Live Synced";
            }
          }
        } catch (e) {
          console.log("Cloud pull note: using local cache");
        } finally {
          if (syncIcon) syncIcon.classList.remove("animate-spin");
        }
      }

      // DOM Elements
      const loginGate = document.getElementById("login-gate");
      const adminApp = document.getElementById("admin-app");
      const loginForm = document.getElementById("login-form");
      const loginError = document.getElementById("login-error");
      const logoutBtn = document.getElementById("logout-btn");

      const periodSelect = document.getElementById("period-select");
      const periodInfoBadge = document.getElementById("period-info-badge");
      const searchInput = document.getElementById("search-input");
      const staffCountBadge = document.getElementById("staff-count-badge");
      const tableBody = document.getElementById("payroll-table-body");
      const noStaffMsg = document.getElementById("no-staff-msg");

      const metricStaffCount = document.getElementById("metric-staff-count");
      const metricBasicTotal = document.getElementById("metric-basic-total");
      const metricOtTotal = document.getElementById("metric-ot-total");
      const metricOtHoursSub = document.getElementById("metric-ot-hours-sub");
      const metricNetTotal = document.getElementById("metric-net-total");

      // Employee Modal
      const employeeModal = document.getElementById("employee-modal");
      const openCreateBtn = document.getElementById("open-create-employee-btn");
      const openCreateTempBtn = document.getElementById("open-create-temp-btn");
      const modalCloseBtn = document.getElementById("modal-close-btn");
      const modalCancelBtn = document.getElementById("modal-cancel-btn");
      const employeeForm = document.getElementById("employee-form");
      const labelFormBasic = document.getElementById("label-form-basic");
      const tempInfoBox = document.getElementById("temp-info-box");
      const typePermRadio = document.getElementById("type-permanent");
      const typeTempRadio = document.getElementById("type-temporary");

      function isTempEmp(emp) {
        if (!emp) return false;
        return emp.type === "temporary" || (emp.empNum && String(emp.empNum).trim().toUpperCase().startsWith("T"));
      }

      function getNextEmpNum(isTemp = false) {
        if (isTemp) {
          const tNums = employees
            .map(e => e.empNum)
            .filter(n => n && String(n).trim().toUpperCase().startsWith("T"))
            .map(n => parseInt(String(n).replace(/\D/g, ""), 10) || 0);
          const maxT = tNums.length > 0 ? Math.max(...tNums) : 0;
          return "T" + String(maxT + 1).padStart(3, "0");
        } else {
          const regNums = employees
            .map(e => e.empNum)
            .filter(n => n && !String(n).trim().toUpperCase().startsWith("T"))
            .map(n => parseInt(String(n).replace(/\D/g, ""), 10) || 0);
          const maxReg = regNums.length > 0 ? Math.max(...regNums) : 0;
          return String(maxReg + 1).padStart(3, "0");
        }
      }

      // Payslip Modal
      const payslipModal = document.getElementById("payslip-modal");
      const closePayslipBtn = document.getElementById("close-payslip-btn");
      const printPayslipBtn = document.getElementById("print-payslip-btn");

      // Timesheet Modal Elements
      const timesheetModal = document.getElementById("timesheet-modal");
      const tsEmpBadge = document.getElementById("ts-emp-badge");
      const tsEmpName = document.getElementById("ts-emp-name");
      const tsPeriodInfo = document.getElementById("ts-period-info");
      const tsDaysTbody = document.getElementById("ts-days-tbody");
      const tsTotalNormal = document.getElementById("ts-total-normal");
      const tsTotalOt = document.getElementById("ts-total-ot");
      const tsFillDefaultBtn = document.getElementById("ts-fill-default-btn");
      const tsClearOtBtn = document.getElementById("ts-clear-ot-btn");
      const tsCloseTopBtn = document.getElementById("ts-close-top-btn");
      const tsCancelBtn = document.getElementById("ts-cancel-btn");
      const tsSaveBtn = document.getElementById("ts-save-btn");
      let currentTsEmpId = null;

      // Auth Check
      function checkAuth() {
        const isAuthed = localStorage.getItem(AUTH_KEY) === "true";
        if (isAuthed) {
          loginGate.classList.add("hidden");
          adminApp.classList.remove("hidden");
          adminApp.classList.add("flex");
          loadData();
          initPeriod();
          render();
          pullFromCloud();
        } else {
          loginGate.classList.remove("hidden");
          adminApp.classList.add("hidden");
          adminApp.classList.remove("flex");
        }
      }

      loginForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const u = document.getElementById("username").value.trim().toLowerCase();
        const p = document.getElementById("password").value.trim();
        if (u === DEFAULT_USER && p === getActivePassword()) {
          localStorage.setItem(AUTH_KEY, "true");
          loginError.classList.add("hidden");
          checkAuth();
        } else {
          loginError.classList.remove("hidden");
        }
      });

      if (logoutBtn) {
        logoutBtn.addEventListener("click", () => {
          localStorage.removeItem(AUTH_KEY);
          checkAuth();
        });
      }

      function initPeriod() {
        const now = new Date();
        const curY = now.getFullYear();
        const curM = String(now.getMonth() + 1).padStart(2, "0");
        selectedPeriod = `${curY}-${curM}`;
        if (periodSelect) periodSelect.value = selectedPeriod;
      }

      // Render Table & Metrics
      function render() {
        const p = getPeriodDetails(selectedPeriod || (periodSelect ? periodSelect.value : ""));
        selectedPeriod = p.periodStr;

        // Update Period Info Badge
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        if (periodInfoBadge) {
          periodInfoBadge.innerHTML = `
            <span class="font-bold text-white">${monthNames[p.month - 1]} ${p.year}</span>: 
            <span class="text-white/80">${p.days} days</span> • 
            <span class="font-mono text-flare font-bold">${p.totalHrs} hrs</span> (${p.days}d × 8h)
          `;
        }

        const q = searchInput ? searchInput.value.trim().toLowerCase() : "";
        const filtered = employees.filter(e => {
          if (!q) return true;
          return (
            (e.name && e.name.toLowerCase().includes(q)) ||
            (e.empNum && e.empNum.toLowerCase().includes(q)) ||
            (e.designation && e.designation.toLowerCase().includes(q))
          );
        });

        if (staffCountBadge) staffCountBadge.textContent = filtered.length;
        if (metricStaffCount) metricStaffCount.textContent = employees.length;

        // Ensure period container in monthlyData
        if (!monthlyData[selectedPeriod]) {
          monthlyData[selectedPeriod] = {};
        }
        const currentPeriodRecords = monthlyData[selectedPeriod];

        let sumBasic = 0;
        let sumOtAmt = 0;
        let sumOtHrs = 0;
        let sumNet = 0;
        let permCount = 0;
        let tempCount = 0;

        // Calculate metrics across all employees for this period
        employees.forEach(emp => {
          const empMonth = currentPeriodRecords[emp.id] || {};
          const isTemp = isTempEmp(emp);

          if (isTemp) {
            tempCount++;
            const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
              ? Number(empMonth.hourlyRate)
              : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);

            let totalHours = 0;
            if (empMonth.days) {
              totalHours = Object.values(empMonth.days).reduce((s, d) => s + (Number(d.normal) || 0) + (Number(d.ot) || 0), 0);
            } else if (empMonth.totalHours !== undefined) {
              totalHours = Number(empMonth.totalHours);
            } else {
              totalHours = (Number(empMonth.normalHours) || 0) + (Number(empMonth.otHours) || 0);
            }

            const net = totalHours * hourlyRate;
            sumNet += net;
          } else {
            permCount++;
            const basic = (empMonth.basic !== undefined && empMonth.basic !== null && empMonth.basic !== "")
              ? Number(empMonth.basic)
              : (Number(emp.basic) || 0);
            const otHrs = Number(empMonth.otHours) || 0;
            const hourlyRate = p.totalHrs > 0 ? (basic / p.totalHrs) : 0;
            const otRate = hourlyRate * 1.25;
            const otAmt = otHrs * otRate;
            const net = basic + otAmt;

            sumBasic += basic;
            sumOtHrs += otHrs;
            sumOtAmt += otAmt;
            sumNet += net;
          }
        });

        if (metricBasicTotal) metricBasicTotal.textContent = fmtOmr(sumBasic);
        if (metricOtTotal) metricOtTotal.textContent = fmtOmr(sumOtAmt);
        if (metricOtHoursSub) metricOtHoursSub.textContent = `${sumOtHrs} hrs total (125% rate)`;
        if (metricNetTotal) metricNetTotal.textContent = fmtOmr(sumNet);
        const metricStaffSub = document.getElementById("metric-staff-sub");
        if (metricStaffSub) {
          metricStaffSub.textContent = tempCount > 0 ? `${permCount} Staff • ${tempCount} Temp (Hourly)` : "Registered in company";
        }
        const metricNetSub = document.getElementById("metric-net-sub");
        if (metricNetSub) {
          metricNetSub.textContent = tempCount > 0 ? "Staff Payroll + Temp Manpower" : "Basic + Overtime";
        }

        // Render Table Body
        if (filtered.length === 0) {
          tableBody.innerHTML = "";
          noStaffMsg.classList.remove("hidden");
          return;
        }
        noStaffMsg.classList.add("hidden");

        tableBody.innerHTML = filtered.map(emp => {
          const empMonth = currentPeriodRecords[emp.id] || {};
          const isTemp = isTempEmp(emp);

          if (isTemp) {
            const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
              ? Number(empMonth.hourlyRate)
              : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);

            let totalHours = 0;
            if (empMonth.days) {
              totalHours = Object.values(empMonth.days).reduce((s, d) => s + (Number(d.normal) || 0) + (Number(d.ot) || 0), 0);
            } else if (empMonth.totalHours !== undefined) {
              totalHours = Number(empMonth.totalHours);
            } else {
              totalHours = (Number(empMonth.normalHours) || 0) + (Number(empMonth.otHours) || 0);
            }
            const net = totalHours * hourlyRate;

            return `
              <tr class="transition-colors hover:bg-purple-500/[0.04] bg-purple-500/[0.01]">
                <!-- Emp # (Click to print voucher) -->
                <td class="w-[75px] py-2.5 pl-2.5 pr-1">
                  <button
                    type="button"
                    onclick="window._viewPaySlip('${emp.id}')"
                    class="font-mono font-bold text-purple-400 transition-colors hover:underline text-[11px] inline-flex items-center gap-1"
                    title="Click to view & print Temporary Manpower Voucher"
                  >
                    <span>${emp.empNum || "—"}</span>
                    <span class="rounded bg-purple-500/25 px-1 py-0.2 text-[8px] font-sans font-bold text-purple-300 border border-purple-500/30">TEMP</span>
                  </button>
                </td>

                <!-- Staff Name (Click to open Daily Timesheet) -->
                <td class="w-[160px] px-2 py-2.5 font-bold text-white text-[11px]">
                  <button
                    type="button"
                    onclick="window._openDailyTimesheet('${emp.id}')"
                    class="text-left text-purple-200 hover:text-purple-300 hover:underline transition-colors flex items-center justify-between gap-1 w-full group cursor-pointer"
                    title="Click to view & log daily hours"
                  >
                    <span class="truncate">${emp.name || "—"}</span>
                    <span class="rounded bg-purple-500/20 border border-purple-500/40 px-1 py-0.5 text-[9px] font-mono text-purple-300 group-hover:bg-purple-500/35 shrink-0">Daily 📅</span>
                  </button>
                </td>

                <!-- Designation -->
                <td class="w-[110px] px-1.5 py-2.5 text-white/80 text-[11px]">
                  <span class="rounded bg-purple-500/15 border border-purple-500/25 px-1.5 py-0.5 text-purple-200 text-[10px]">${emp.designation || "Temp Helper"}</span>
                </td>

                <!-- Basic / Hourly Rate -->
                <td class="w-[125px] px-1.5 py-2.5">
                  <div class="inline-flex items-center gap-1" title="Temporary Manpower Hourly Pay Rate">
                    <input
                      type="number"
                      step="0.05"
                      min="0"
                      value="${hourlyRate}"
                      onchange="window._updateTempHourlyRate('${emp.id}', this.value)"
                      class="w-16 rounded border border-purple-500/40 bg-[#0f1115] px-1.5 py-0.5 text-center font-mono text-xs font-bold text-purple-300 focus:border-purple-400 focus:outline-none"
                    />
                    <span class="text-[10px] text-purple-300/70 font-mono">/hr</span>
                  </div>
                </td>

                <!-- Std Hrs -->
                <td class="w-[85px] px-1.5 py-2.5 font-mono text-purple-300/60 text-[10.5px]">
                  Hourly
                </td>

                <!-- Rate / Hr -->
                <td class="w-[95px] px-1.5 py-2.5 font-mono text-[10.5px] text-purple-300 font-bold">
                  OMR ${fmtOmr(hourlyRate)}/h
                </td>

                <!-- OT Rate (Flat for temp) -->
                <td class="w-[95px] px-1.5 py-2.5 font-mono text-[10px] text-white/30" title="Temporary staff paid flat hourly rate">
                  —
                </td>

                <!-- Total Hours Input -->
                <td class="w-[100px] px-1.5 py-2.5">
                  <div class="inline-flex items-center gap-1">
                    <input
                      type="number"
                      step="0.5"
                      min="0"
                      value="${totalHours}"
                      onchange="window._updateTempHours('${emp.id}', this.value)"
                      class="w-16 border border-purple-500/30 bg-[#0f1115] px-1.5 py-0.5 text-center font-mono text-xs font-bold text-white focus:border-purple-400 focus:outline-none"
                      title="Total hours worked in ${p.periodStr} (or click staff name for daily log)"
                    />
                    <span class="text-[10px] text-white/40">hrs</span>
                  </div>
                </td>

                <!-- OT Earning -->
                <td class="w-[105px] px-1.5 py-2.5 font-mono text-white/30 text-[10px]">
                  —
                </td>

                <!-- Net Pay (Hours x Hourly Rate) -->
                <td class="w-[115px] px-1.5 py-2.5 font-mono font-bold text-emerald-400 text-[11.5px]">
                  OMR ${fmtOmr(net)}
                </td>

                <!-- Actions -->
                <td class="w-[110px] py-2.5 pl-1 pr-2 text-center">
                  <div class="inline-flex items-center gap-1">
                    <button
                      type="button"
                      onclick="window._viewPaySlip('${emp.id}')"
                      class="rounded-xs border border-purple-500/40 bg-purple-500/10 px-1.5 py-0.5 text-[10.5px] font-medium text-purple-300 transition-colors hover:border-purple-500/70 hover:bg-purple-500/25"
                      title="View & print payment voucher"
                    >
                      Slip
                    </button>
                    <button
                      type="button"
                      onclick="window._editEmployee('${emp.id}')"
                      class="rounded-xs border border-white/20 bg-white/5 px-1.5 py-0.5 text-[10.5px] font-medium text-white transition-colors hover:border-white/50 hover:bg-white/15"
                      title="Edit temporary employee"
                    >
                      Edit
                    </button>
                    <button
                      type="button"
                      onclick="window._deleteEmployee('${emp.id}')"
                      class="rounded-xs border border-red-500/30 bg-red-500/10 px-1 py-0.5 text-[10.5px] font-medium text-red-300 transition-colors hover:border-red-500/60 hover:bg-red-500/25"
                      title="Delete temporary employee"
                    >
                      Del
                    </button>
                  </div>
                </td>
              </tr>
            `;
          }

          const isCustomBasic = (empMonth.basic !== undefined && empMonth.basic !== null && empMonth.basic !== "");
          const basic = isCustomBasic ? Number(empMonth.basic) : (Number(emp.basic) || 0);
          const otHrs = Number(empMonth.otHours) || 0;
          const hourlyRate = p.totalHrs > 0 ? (basic / p.totalHrs) : 0;
          const otRate = hourlyRate * 1.25;
          const otAmt = otHrs * otRate;
          const net = basic + otAmt;

          return `
            <tr class="transition-colors hover:bg-white/[0.03]">
              <!-- Emp # (Click to print payslip) -->
              <td class="w-[75px] py-2.5 pl-2.5 pr-1">
                <button
                  type="button"
                  onclick="window._viewPaySlip('${emp.id}')"
                  class="font-mono font-bold text-flare transition-colors hover:underline text-[11px]"
                  title="Click to view & print pay slip"
                >
                  ${emp.empNum || "—"}
                </button>
              </td>

              <!-- Staff Name (Click to open Daily Timesheet & OT pop-up) -->
              <td class="w-[160px] px-2 py-2.5 font-bold text-white text-[11px]">
                <button
                  type="button"
                  onclick="window._openDailyTimesheet('${emp.id}')"
                  class="text-left text-white hover:text-amber-400 hover:underline transition-colors flex items-center justify-between gap-1 w-full group cursor-pointer"
                  title="Click to view & log daily Normal & OT hours"
                >
                  <span class="truncate">${emp.name || "—"}</span>
                  <span class="rounded bg-amber-400/10 border border-amber-400/30 px-1 py-0.5 text-[9px] font-mono text-amber-300 group-hover:bg-amber-400/25 shrink-0">Daily 📅</span>
                </button>
              </td>

              <!-- Designation -->
              <td class="w-[110px] px-1.5 py-2.5 text-white/80 text-[11px]">
                <span class="rounded bg-white/5 px-1.5 py-0.5">${emp.designation || "—"}</span>
              </td>

              <!-- Basic Salary (Editable per Month) -->
              <td class="w-[125px] px-1.5 py-2.5">
                <div class="inline-flex items-center gap-1">
                  <input
                    type="number"
                    step="1"
                    min="0"
                    value="${basic}"
                    onchange="window._updateMonthBasic('${emp.id}', this.value)"
                    class="w-20 rounded border ${isCustomBasic ? 'border-amber-400 bg-amber-500/15 text-amber-300' : 'border-white/20 bg-[#0f1115] text-white'} px-1.5 py-0.5 text-center font-mono text-xs font-bold focus:border-flare focus:outline-none"
                    title="${isCustomBasic ? `Custom basic for ${p.periodStr} (Default is OMR ${fmtOmr(emp.basic)})` : `Click to change basic for ${p.periodStr} only`}"
                  />
                  ${isCustomBasic ? `
                    <button
                      type="button"
                      onclick="window._resetMonthBasic('${emp.id}')"
                      class="text-white/40 hover:text-amber-300 text-[11px] p-0.5"
                      title="Reset to default OMR ${fmtOmr(emp.basic)}"
                    >
                      ↺
                    </button>
                  ` : ''}
                </div>
              </td>

              <!-- Std Hrs -->
              <td class="w-[85px] px-1.5 py-2.5 font-mono text-white/60 text-[11px]">
                ${p.totalHrs}h
              </td>

              <!-- Normal Rate / Hr -->
              <td class="w-[95px] px-1.5 py-2.5 font-mono text-[10px] text-white/50">
                ${fmtOmr(hourlyRate)}/h
              </td>

              <!-- OT Rate (125%) -->
              <td class="w-[95px] px-1.5 py-2.5 font-mono text-[10px] text-amber-300">
                ${fmtOmr(otRate)}/h
              </td>

              <!-- OT Hours Input -->
              <td class="w-[100px] px-1.5 py-2.5">
                <div class="inline-flex items-center gap-1">
                  <input
                    type="number"
                    step="0.5"
                    min="0"
                    value="${otHrs}"
                    onchange="window._updateOt('${emp.id}', this.value)"
                    class="w-16 border border-white/20 bg-[#0f1115] px-1.5 py-0.5 text-center font-mono text-xs font-bold text-amber-300 focus:border-flare focus:outline-none"
                    title="Enter overtime hours"
                  />
                  <span class="text-[10px] text-white/40">hrs</span>
                </div>
              </td>

              <!-- OT Earning -->
              <td class="w-[105px] px-1.5 py-2.5 font-mono font-bold text-amber-300 text-[11px]">
                OMR ${fmtOmr(otAmt)}
              </td>

              <!-- Net Pay -->
              <td class="w-[115px] px-1.5 py-2.5 font-mono font-bold text-emerald-400 text-[11.5px]">
                OMR ${fmtOmr(net)}
              </td>

              <!-- Actions -->
              <td class="w-[110px] py-2.5 pl-1 pr-2 text-center">
                <div class="inline-flex items-center gap-1">
                  <button
                    type="button"
                    onclick="window._viewPaySlip('${emp.id}')"
                    class="rounded-xs border border-blue-500/30 bg-blue-500/10 px-1.5 py-0.5 text-[10.5px] font-medium text-blue-300 transition-colors hover:border-blue-500/60 hover:bg-blue-500/25"
                    title="View & print official pay slip"
                  >
                    Slip
                  </button>
                  <button
                    type="button"
                    onclick="window._editEmployee('${emp.id}')"
                    class="rounded-xs border border-white/20 bg-white/5 px-1.5 py-0.5 text-[10.5px] font-medium text-white transition-colors hover:border-white/50 hover:bg-white/15"
                    title="Edit employee"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    onclick="window._deleteEmployee('${emp.id}')"
                    class="rounded-xs border border-red-500/30 bg-red-500/10 px-1 py-0.5 text-[10.5px] font-medium text-red-300 transition-colors hover:border-red-500/60 hover:bg-red-500/25"
                    title="Delete employee"
                  >
                    Del
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join("");
      }

      // Event Listeners for Period & Search
      if (periodSelect) {
        periodSelect.addEventListener("change", (e) => {
          selectedPeriod = e.target.value;
          render();
        });
      }
      if (searchInput) {
        searchInput.addEventListener("input", render);
      }

      // Update OT hours inline
      window._updateOt = function(empId, val) {
        const hrs = Math.max(0, parseFloat(val) || 0);
        if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
        if (!monthlyData[selectedPeriod][empId]) monthlyData[selectedPeriod][empId] = {};
        monthlyData[selectedPeriod][empId].otHours = hrs;
        saveData();
        render();
      };

      // Update Basic Salary for current month only (doesn't affect other months)
      window._updateMonthBasic = function(empId, val) {
        const emp = employees.find(e => e.id === empId);
        const defaultBasic = emp ? Number(emp.basic) || 0 : 0;
        const num = parseFloat(val);

        if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
        if (!monthlyData[selectedPeriod][empId]) monthlyData[selectedPeriod][empId] = {};

        if (isNaN(num) || num === defaultBasic) {
          delete monthlyData[selectedPeriod][empId].basic;
        } else {
          monthlyData[selectedPeriod][empId].basic = Math.max(0, num);
        }
        saveData();
        render();
      };

      // Reset Month Basic back to standard master default
      window._resetMonthBasic = function(empId) {
        if (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][empId]) {
          delete monthlyData[selectedPeriod][empId].basic;
          saveData();
          render();
        }
      };

      // Update Temporary Hourly Rate
      window._updateTempHourlyRate = function(empId, val) {
        const rate = Math.max(0, parseFloat(val) || 0);
        if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
        if (!monthlyData[selectedPeriod][empId]) monthlyData[selectedPeriod][empId] = {};
        monthlyData[selectedPeriod][empId].hourlyRate = rate;

        const emp = employees.find(e => e.id === empId);
        if (emp) emp.hourlyRate = rate;

        saveData();
        render();
      };

      // Update Temporary Hours
      window._updateTempHours = function(empId, val) {
        const hrs = Math.max(0, parseFloat(val) || 0);
        if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
        if (!monthlyData[selectedPeriod][empId]) monthlyData[selectedPeriod][empId] = {};
        monthlyData[selectedPeriod][empId].totalHours = hrs;
        monthlyData[selectedPeriod][empId].normalHours = hrs;
        monthlyData[selectedPeriod][empId].otHours = 0;

        saveData();
        render();
      };

      // ================= Daily Timesheet & Overtime Modal =================
      function closeTimesheetModal() {
        if (!timesheetModal) return;
        timesheetModal.classList.add("hidden");
        timesheetModal.classList.remove("flex");
        currentTsEmpId = null;
      }

      function updateTsLiveTotals() {
        if (!tsDaysTbody) return;
        let totNorm = 0;
        let totOt = 0;
        const rows = tsDaysTbody.querySelectorAll("tr");
        rows.forEach(row => {
          const normInp = row.querySelector(".ts-input-normal");
          const otInp = row.querySelector(".ts-input-ot");
          const dayTotSpan = row.querySelector(".ts-day-total");
          const normVal = Math.max(0, parseFloat(normInp ? normInp.value : 0) || 0);
          const otVal = Math.max(0, parseFloat(otInp ? otInp.value : 0) || 0);
          if (dayTotSpan) dayTotSpan.textContent = (normVal + otVal);
          totNorm += normVal;
          totOt += otVal;
        });

        const curEmp = currentTsEmpId ? employees.find(e => e.id === currentTsEmpId) : null;
        const isTemp = curEmp && isTempEmp(curEmp);

        if (isTemp) {
          const empMonth = (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][currentTsEmpId]) || {};
          const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
            ? Number(empMonth.hourlyRate)
            : (Number(curEmp.hourlyRate) || Number(curEmp.basic) || 1.0);
          const totalHours = totNorm + totOt;
          const payout = totalHours * hourlyRate;

          if (tsTotalNormal) tsTotalNormal.textContent = totalHours;
          if (tsTotalOt) tsTotalOt.textContent = `OMR ${fmtOmr(payout)}`;
        } else {
          if (tsTotalNormal) tsTotalNormal.textContent = totNorm;
          if (tsTotalOt) tsTotalOt.textContent = `${totOt} hrs`;
        }
      }

      window._openDailyTimesheet = function(empId) {
        const emp = employees.find(e => e.id === empId);
        if (!emp) return;
        currentTsEmpId = empId;

        const isTemp = isTempEmp(emp);
        const p = getPeriodDetails(selectedPeriod);
        const monthNamesShort = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        const monthShort = monthNamesShort[p.month - 1] || "MTH";

        if (tsEmpBadge) {
          tsEmpBadge.innerHTML = isTemp
            ? `Emp #${emp.empNum || "—"} <span class="rounded bg-purple-500/20 border border-purple-500/30 text-purple-300 px-1 py-0.2 text-[9px]">TEMP MANPOWER</span>`
            : `Emp #${emp.empNum || "—"}`;
        }
        if (tsEmpName) tsEmpName.textContent = emp.name || "Staff";

        // Get existing logged days or defaults
        monthlyData[selectedPeriod] = monthlyData[selectedPeriod] || {};
        const empMonth = monthlyData[selectedPeriod][empId] || {};
        const savedDays = empMonth.days || {};

        const toolbarLabelNormal = document.getElementById("ts-label-normal");
        const toolbarLabelOt = document.getElementById("ts-label-ot");

        if (isTemp) {
          const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
            ? Number(empMonth.hourlyRate)
            : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);

          if (tsPeriodInfo) {
            tsPeriodInfo.innerHTML = `
              <span class="font-bold text-purple-300">${monthShort} ${p.year}</span> • 
              <span>Temporary Manpower</span> • 
              <span>Hourly Rate: <strong class="text-purple-300 font-mono">OMR ${fmtOmr(hourlyRate)}/hr</strong></span> • 
              <span class="text-emerald-400">Total Payout = Total Hours Worked × Rate</span>
            `;
          }
          if (toolbarLabelNormal) toolbarLabelNormal.textContent = "Total Hours Worked:";
          if (toolbarLabelOt) toolbarLabelOt.textContent = "Est. Total Payout:";
        } else {
          if (tsPeriodInfo) {
            tsPeriodInfo.innerHTML = `
              <span class="font-bold text-white">${monthShort} ${p.year}</span> • 
              <span>${p.days} Days in Month</span> • 
              <span>Standard Working Hours: <strong class="text-amber-400 font-mono">${p.totalHrs}h</strong> (${p.days}d × 8h)</span>
            `;
          }
          if (toolbarLabelNormal) toolbarLabelNormal.textContent = "Total Normal:";
          if (toolbarLabelOt) toolbarLabelOt.textContent = "Total Overtime:";
        }

        let rowsHtml = "";
        const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

        for (let d = 1; d <= p.days; d++) {
          const dateObj = new Date(p.year, p.month - 1, d);
          const dow = dayNames[dateObj.getDay()];
          const isFriday = (dateObj.getDay() === 5);

          let normVal = isTemp ? 0 : 8;
          let otVal = 0;

          if (savedDays[d] !== undefined) {
            normVal = Number(savedDays[d].normal) >= 0 ? Number(savedDays[d].normal) : (isTemp ? 0 : 8);
            otVal = Number(savedDays[d].ot) >= 0 ? Number(savedDays[d].ot) : 0;
          } else if (isTemp && empMonth.totalHours && d === 1 && Object.keys(savedDays).length === 0) {
            // Backward compat: if there was previous lump-sum hours entered
            normVal = Number(empMonth.totalHours);
          } else if (!isTemp && empMonth.otHours && d === 1 && Object.keys(savedDays).length === 0) {
            // Backward compat: if there was previous lump-sum OT
            otVal = Number(empMonth.otHours);
          }

          const daySum = normVal + otVal;

          rowsHtml += `
            <tr class="hover:bg-white/[0.04] transition-colors ${isFriday ? 'bg-white/[0.02]' : ''}" data-day="${d}">
              <td class="py-2 px-3 font-medium text-white">
                <span class="font-bold text-white text-xs">${d} ${monthShort}</span>
                <span class="text-white/40 text-[10px] ml-1.5 uppercase tracking-wide">(${dow})</span>
                ${isFriday ? '<span class="ml-1 rounded bg-blue-500/10 px-1 py-0.2 text-[9px] text-blue-300 font-sans">Fri</span>' : ''}
              </td>
              <td class="py-1.5 px-3 text-center">
                <input
                  type="number"
                  min="0"
                  max="24"
                  step="0.5"
                  data-day="${d}"
                  data-type="normal"
                  value="${normVal}"
                  class="ts-input-normal w-20 rounded border border-white/20 bg-[#0f1115] px-2 py-1 text-center font-mono text-xs font-bold text-white focus:border-amber-400 focus:outline-none"
                />
              </td>
              <td class="py-1.5 px-3 text-center">
                <input
                  type="number"
                  min="0"
                  max="24"
                  step="0.5"
                  data-day="${d}"
                  data-type="ot"
                  value="${otVal}"
                  class="ts-input-ot w-20 rounded border border-amber-500/30 bg-[#0f1115] px-2 py-1 text-center font-mono text-xs font-bold text-amber-300 focus:border-amber-400 focus:outline-none"
                />
              </td>
              <td class="py-2 px-3 text-right font-mono font-bold text-white/90">
                <span class="ts-day-total text-xs">${daySum}</span><span class="text-white/30 text-[10px] ml-0.5">h</span>
              </td>
            </tr>
          `;
        }

        if (tsDaysTbody) tsDaysTbody.innerHTML = rowsHtml;
        updateTsLiveTotals();

        if (timesheetModal) {
          timesheetModal.classList.remove("hidden");
          timesheetModal.classList.add("flex");
        }
      };

      if (tsDaysTbody) {
        tsDaysTbody.addEventListener("input", (e) => {
          if (e.target.classList.contains("ts-input-normal") || e.target.classList.contains("ts-input-ot")) {
            updateTsLiveTotals();
          }
        });
      }

      if (tsFillDefaultBtn) {
        tsFillDefaultBtn.addEventListener("click", () => {
          if (!tsDaysTbody) return;
          const normInputs = tsDaysTbody.querySelectorAll(".ts-input-normal");
          normInputs.forEach(inp => { inp.value = 8; });
          updateTsLiveTotals();
        });
      }

      if (tsClearOtBtn) {
        tsClearOtBtn.addEventListener("click", () => {
          if (!tsDaysTbody) return;
          const otInputs = tsDaysTbody.querySelectorAll(".ts-input-ot");
          otInputs.forEach(inp => { inp.value = 0; });
          updateTsLiveTotals();
        });
      }

      if (tsCloseTopBtn) tsCloseTopBtn.addEventListener("click", closeTimesheetModal);
      if (tsCancelBtn) tsCancelBtn.addEventListener("click", closeTimesheetModal);

      if (timesheetModal) {
        timesheetModal.addEventListener("click", (e) => {
          if (e.target === timesheetModal) closeTimesheetModal();
        });
      }

      if (tsSaveBtn) {
        tsSaveBtn.addEventListener("click", () => {
          if (!currentTsEmpId) return;
          const curEmp = employees.find(e => e.id === currentTsEmpId);
          const isTemp = curEmp && isTempEmp(curEmp);
          const daysObj = {};
          let totalNorm = 0;
          let totalOt = 0;

          if (tsDaysTbody) {
            const rows = tsDaysTbody.querySelectorAll("tr");
            rows.forEach(row => {
              const d = row.getAttribute("data-day");
              const normInp = row.querySelector(".ts-input-normal");
              const otInp = row.querySelector(".ts-input-ot");
              const normVal = Math.max(0, parseFloat(normInp ? normInp.value : 0) || 0);
              const otVal = Math.max(0, parseFloat(otInp ? otInp.value : 0) || 0);
              if (d) {
                daysObj[d] = { normal: normVal, ot: otVal };
                totalNorm += normVal;
                totalOt += otVal;
              }
            });
          }

          if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
          const existingEmpMonth = monthlyData[selectedPeriod][currentTsEmpId] || {};

          monthlyData[selectedPeriod][currentTsEmpId] = {
            ...existingEmpMonth,
            days: daysObj,
            normalHours: totalNorm,
            otHours: totalOt,
            totalHours: totalNorm + totalOt
          };

          saveData();
          closeTimesheetModal();
          render();
        });
      }

      // ================= Staff Category Radios & Employee Modal =================
      if (typePermRadio && typeTempRadio) {
        typePermRadio.addEventListener("change", () => {
          if (typePermRadio.checked) {
            if (labelFormBasic) labelFormBasic.textContent = "Basic Salary (OMR)";
            if (tempInfoBox) tempInfoBox.classList.add("hidden");
            const id = document.getElementById("emp-internal-id").value;
            if (!id) {
              document.getElementById("form-emp-num").value = getNextEmpNum(false);
              document.getElementById("form-emp-basic").placeholder = "e.g. 180.000";
              document.getElementById("form-emp-basic").value = "";
              document.getElementById("form-emp-designation").placeholder = "e.g. Helper, Welder, Fabrication...";
            }
          }
        });
        typeTempRadio.addEventListener("change", () => {
          if (typeTempRadio.checked) {
            if (labelFormBasic) labelFormBasic.textContent = "Hourly Pay Rate (OMR / hr)";
            if (tempInfoBox) tempInfoBox.classList.remove("hidden");
            const id = document.getElementById("emp-internal-id").value;
            if (!id) {
              document.getElementById("form-emp-num").value = getNextEmpNum(true);
              document.getElementById("form-emp-basic").placeholder = "e.g. 1.000";
              document.getElementById("form-emp-basic").value = "1.000";
              document.getElementById("form-emp-designation").value = document.getElementById("form-emp-designation").value || "Helper (Temp)";
            }
          }
        });
      }

      // Employee Modal Management
      function openEmployeeModal(emp = null, forceTemp = false) {
        const p = getPeriodDetails(selectedPeriod);
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const curMonthLabel = `${monthNames[p.month - 1]} ${p.year}`;
        const scopeContainer = document.getElementById("form-salary-scope-container");
        const scopeMonthLabel = document.getElementById("modal-current-period-name");
        if (scopeMonthLabel) scopeMonthLabel.textContent = curMonthLabel;

        if (emp) {
          const isTemp = isTempEmp(emp);
          document.getElementById("modal-eyebrow").textContent = isTemp ? "Edit Temp Staff" : "Edit Staff";
          document.getElementById("modal-title").textContent = isTemp ? "Update Temporary Employee" : "Update Employee Details";
          document.getElementById("emp-internal-id").value = emp.id;
          document.getElementById("form-emp-num").value = emp.empNum || "";
          document.getElementById("form-emp-name").value = emp.name || "";
          document.getElementById("form-emp-designation").value = emp.designation || "";

          if (isTemp) {
            if (typeTempRadio) typeTempRadio.checked = true;
            if (labelFormBasic) labelFormBasic.textContent = "Hourly Pay Rate (OMR / hr)";
            if (tempInfoBox) tempInfoBox.classList.remove("hidden");
            const empMonth = (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][emp.id]) || {};
            const curRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
              ? Number(empMonth.hourlyRate)
              : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);
            document.getElementById("form-emp-basic").value = curRate;
          } else {
            if (typePermRadio) typePermRadio.checked = true;
            if (labelFormBasic) labelFormBasic.textContent = "Basic Salary (OMR)";
            if (tempInfoBox) tempInfoBox.classList.add("hidden");
            const empMonth = (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][emp.id]) || {};
            const currentBasic = (empMonth.basic !== undefined && empMonth.basic !== null && empMonth.basic !== "")
              ? Number(empMonth.basic)
              : (Number(emp.basic) || 0);
            document.getElementById("form-emp-basic").value = currentBasic;
          }

          if (scopeContainer) scopeContainer.classList.remove("hidden");
          const defaultRadio = document.querySelector('input[name="salary-scope"][value="month_only"]');
          if (defaultRadio) defaultRadio.checked = true;
        } else {
          employeeForm.reset();
          document.getElementById("emp-internal-id").value = "";
          if (scopeContainer) scopeContainer.classList.add("hidden");

          if (forceTemp) {
            if (typeTempRadio) typeTempRadio.checked = true;
            document.getElementById("modal-eyebrow").textContent = "Temp Manpower";
            document.getElementById("modal-title").textContent = "Add Temporary Employee";
            if (labelFormBasic) labelFormBasic.textContent = "Hourly Pay Rate (OMR / hr)";
            if (tempInfoBox) tempInfoBox.classList.remove("hidden");
            document.getElementById("form-emp-num").value = getNextEmpNum(true);
            document.getElementById("form-emp-basic").placeholder = "e.g. 1.000";
            document.getElementById("form-emp-basic").value = "1.000";
            document.getElementById("form-emp-designation").value = "Helper (Temp)";
          } else {
            if (typePermRadio) typePermRadio.checked = true;
            document.getElementById("modal-eyebrow").textContent = "New Staff";
            document.getElementById("modal-title").textContent = "Add New Employee";
            if (labelFormBasic) labelFormBasic.textContent = "Basic Salary (OMR)";
            if (tempInfoBox) tempInfoBox.classList.add("hidden");
            document.getElementById("form-emp-num").value = getNextEmpNum(false);
            document.getElementById("form-emp-basic").placeholder = "e.g. 180.000";
            document.getElementById("form-emp-basic").value = "";
            document.getElementById("form-emp-designation").value = "";
          }
        }
        employeeModal.classList.remove("hidden");
        employeeModal.classList.add("flex");
      }

      function closeEmployeeModal() {
        employeeModal.classList.add("hidden");
        employeeModal.classList.remove("flex");
      }

      if (openCreateBtn) openCreateBtn.addEventListener("click", () => openEmployeeModal(null, false));
      if (openCreateTempBtn) openCreateTempBtn.addEventListener("click", () => openEmployeeModal(null, true));
      if (modalCloseBtn) modalCloseBtn.addEventListener("click", closeEmployeeModal);
      if (modalCancelBtn) modalCancelBtn.addEventListener("click", closeEmployeeModal);
      if (employeeModal) {
        employeeModal.addEventListener("click", (e) => {
          if (e.target === employeeModal) closeEmployeeModal();
        });
      }

      employeeForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const id = document.getElementById("emp-internal-id").value;
        const empNum = document.getElementById("form-emp-num").value.trim();
        const name = document.getElementById("form-emp-name").value.trim();
        const designation = document.getElementById("form-emp-designation").value.trim();
        const valBasicOrRate = parseFloat(document.getElementById("form-emp-basic").value) || 0;
        const isTemp = (typeTempRadio && typeTempRadio.checked) || (empNum.toUpperCase().startsWith("T"));

        const scopeRadios = document.getElementsByName("salary-scope");
        let scopeVal = "month_only";
        for (const r of scopeRadios) {
          if (r.checked) { scopeVal = r.value; break; }
        }

        if (id) {
          const idx = employees.findIndex(emp => emp.id === id);
          if (idx >= 0) {
            if (isTemp) {
              if (scopeVal === "all_months") {
                employees[idx] = { ...employees[idx], empNum, name, designation, type: "temporary", hourlyRate: valBasicOrRate, basic: 0 };
                if (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][id]) {
                  delete monthlyData[selectedPeriod][id].hourlyRate;
                }
              } else {
                employees[idx] = { ...employees[idx], empNum, name, designation, type: "temporary" };
                if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
                if (!monthlyData[selectedPeriod][id]) monthlyData[selectedPeriod][id] = {};
                monthlyData[selectedPeriod][id].hourlyRate = valBasicOrRate;
              }
            } else {
              if (scopeVal === "all_months") {
                employees[idx] = { ...employees[idx], empNum, name, designation, type: "permanent", basic: valBasicOrRate };
                if (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][id]) {
                  delete monthlyData[selectedPeriod][id].basic;
                }
              } else {
                employees[idx] = { ...employees[idx], empNum, name, designation, type: "permanent" };
                if (!monthlyData[selectedPeriod]) monthlyData[selectedPeriod] = {};
                if (!monthlyData[selectedPeriod][id]) monthlyData[selectedPeriod][id] = {};
                monthlyData[selectedPeriod][id].basic = valBasicOrRate;
              }
            }
          }
        } else {
          const newId = "emp_" + Date.now();
          if (isTemp) {
            employees.push({
              id: newId,
              empNum,
              name,
              designation: designation || "Helper (Temp)",
              type: "temporary",
              hourlyRate: valBasicOrRate,
              basic: 0
            });
          } else {
            employees.push({
              id: newId,
              empNum,
              name,
              designation,
              type: "permanent",
              basic: valBasicOrRate
            });
          }
        }

        saveData();
        closeEmployeeModal();
        render();
      });

      window._editEmployee = function(id) {
        const emp = employees.find(e => e.id === id);
        if (emp) openEmployeeModal(emp);
      };

      window._deleteEmployee = function(id) {
        const emp = employees.find(e => e.id === id);
        if (emp && confirm(`Remove employee "${emp.name}" (ID: ${emp.empNum})?`)) {
          employees = employees.filter(e => e.id !== id);
          saveData();
          render();
        }
      };

      // ================= View & Print Official Pay Slip / Temp Voucher =================
      window._viewPaySlip = function(empId) {
        const emp = employees.find(e => e.id === empId);
        if (!emp) return;

        const p = getPeriodDetails(selectedPeriod);
        const empMonth = (monthlyData[selectedPeriod] && monthlyData[selectedPeriod][empId]) || {};
        const isTemp = isTempEmp(emp);
        const monthNamesLong = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

        const slipTitle = document.getElementById("slip-modal-doc-title");
        const slipCalcNote = document.getElementById("slip-days-calc");
        const otRow = document.getElementById("slip-ot-row");
        const slipDescCol = document.getElementById("slip-desc-col");
        const slipBasicHeader = document.getElementById("slip-basic-header");
        const slipTotalLabel = document.getElementById("slip-total-label");

        document.getElementById("slip-emp-num").textContent = emp.empNum || "—";
        document.getElementById("slip-period").textContent = `${monthNamesLong[p.month - 1]} ${p.year} (${p.year}-${String(p.month).padStart(2, "0")}-01)`;
        document.getElementById("slip-emp-name").textContent = emp.name || "—";
        document.getElementById("slip-designation").textContent = emp.designation || "—";

        if (isTemp) {
          const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
            ? Number(empMonth.hourlyRate)
            : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);

          let totalHours = 0;
          if (empMonth.days) {
            totalHours = Object.values(empMonth.days).reduce((s, d) => s + (Number(d.normal) || 0) + (Number(d.ot) || 0), 0);
          } else if (empMonth.totalHours !== undefined) {
            totalHours = Number(empMonth.totalHours);
          } else {
            totalHours = (Number(empMonth.normalHours) || 0) + (Number(empMonth.otHours) || 0);
          }
          const net = totalHours * hourlyRate;

          if (slipTitle) slipTitle.textContent = "Temporary Manpower Payment Voucher";
          if (slipBasicHeader) slipBasicHeader.textContent = "Rate / Hr (OMR)";
          if (slipDescCol) slipDescCol.textContent = "Temporary Manpower Services (Hourly Payment)";
          if (slipTotalLabel) slipTotalLabel.textContent = "Total Amount Due:";

          document.getElementById("slip-basic-col").textContent = fmtOmr(hourlyRate);
          document.getElementById("slip-working-hrs").textContent = "—";
          document.getElementById("slip-present-hrs").textContent = `${totalHours} hrs`;
          document.getElementById("slip-basic-earning").textContent = fmtOmr(net);

          if (otRow) otRow.classList.add("hidden");
          document.getElementById("slip-total-amount").textContent = `OMR ${fmtOmr(net)}`;
          if (slipCalcNote) {
            slipCalcNote.innerHTML = `<strong>Temporary Manpower Calculation:</strong> Total Hours Worked (<strong>${totalHours} hrs</strong>) × Agreed Rate (<strong>OMR ${fmtOmr(hourlyRate)}/hr</strong>) = <strong>OMR ${fmtOmr(net)}</strong>.`;
          }
        } else {
          const otHrs = Number(empMonth.otHours) || 0;
          const normalHrs = (empMonth.normalHours !== undefined) ? Number(empMonth.normalHours) : p.totalHrs;
          const basic = (empMonth.basic !== undefined && empMonth.basic !== null && empMonth.basic !== "")
            ? Number(empMonth.basic)
            : (Number(emp.basic) || 0);
          const hourlyRate = p.totalHrs > 0 ? (basic / p.totalHrs) : 0;
          const otRate = hourlyRate * 1.25;
          const otAmt = otHrs * otRate;
          const net = basic + otAmt;

          if (slipTitle) slipTitle.textContent = "Employee Pay Slip";
          if (slipBasicHeader) slipBasicHeader.textContent = "Basic (OMR)";
          if (slipDescCol) slipDescCol.textContent = "Salary (Basic)";
          if (slipTotalLabel) slipTotalLabel.textContent = "Total Salary Payout:";

          document.getElementById("slip-basic-col").textContent = fmtOmr(basic);
          document.getElementById("slip-working-hrs").textContent = p.totalHrs;
          document.getElementById("slip-present-hrs").textContent = normalHrs;
          document.getElementById("slip-basic-earning").textContent = fmtOmr(basic);

          if (otRow) otRow.classList.remove("hidden");
          document.getElementById("slip-ot-hrs").textContent = otHrs;
          document.getElementById("slip-ot-earning").textContent = fmtOmr(otAmt);

          document.getElementById("slip-total-amount").textContent = `OMR ${fmtOmr(net)}`;
          if (slipCalcNote) {
            slipCalcNote.innerHTML = `<strong>Calculation Method:</strong> Total Working Hours = ${p.days} days × 8 hrs = ${p.totalHrs} hrs. Hourly Rate = Basic ÷ Total Hours. Overtime Hourly Rate = Hourly Rate × 1.25 (Oman Labor Law Standard 125%). Overtime Earning = OT Hours × OT Rate.`;
          }
        }

        payslipModal.classList.remove("hidden");
        payslipModal.classList.add("flex");
      };

      if (closePayslipBtn) {
        closePayslipBtn.addEventListener("click", () => {
          payslipModal.classList.add("hidden");
          payslipModal.classList.remove("flex");
        });
      }
      if (printPayslipBtn) {
        printPayslipBtn.addEventListener("click", () => {
          window.print();
        });
      }
      if (payslipModal) {
        payslipModal.addEventListener("click", (e) => {
          if (e.target === payslipModal) {
            payslipModal.classList.add("hidden");
            payslipModal.classList.remove("flex");
          }
        });
      }

      // Escape key to close modals
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeTimesheetModal();
          closeEmployeeModal();
          if (payslipModal) {
            payslipModal.classList.add("hidden");
            payslipModal.classList.remove("flex");
          }
        }
      });

      // Export to CSV
      const exportCsvBtn = document.getElementById("export-csv-btn");
      if (exportCsvBtn) {
        exportCsvBtn.addEventListener("click", () => {
          const p = getPeriodDetails(selectedPeriod);
          const currentPeriodRecords = (monthlyData[selectedPeriod]) || {};

          const headers = [
            "Emp Number",
            "Staff Type",
            "Name",
            "Designation",
            "Salary Period",
            "Month Days",
            "Total Working Hours",
            "Basic Salary / Rate (OMR)",
            "Hourly Rate (OMR)",
            "OT Rate (125% OMR)",
            "OT Hours",
            "OT Earning (OMR)",
            "Net Pay (OMR)"
          ];

          const rows = employees.map(emp => {
            const isTemp = isTempEmp(emp);
            const empMonth = currentPeriodRecords[emp.id] || {};

            if (isTemp) {
              const hourlyRate = (empMonth.hourlyRate !== undefined && empMonth.hourlyRate !== null && empMonth.hourlyRate !== "")
                ? Number(empMonth.hourlyRate)
                : (Number(emp.hourlyRate) || Number(emp.basic) || 1.0);

              let totalHours = 0;
              if (empMonth.days) {
                totalHours = Object.values(empMonth.days).reduce((s, d) => s + (Number(d.normal) || 0) + (Number(d.ot) || 0), 0);
              } else if (empMonth.totalHours !== undefined) {
                totalHours = Number(empMonth.totalHours);
              } else {
                totalHours = (Number(empMonth.normalHours) || 0) + (Number(empMonth.otHours) || 0);
              }
              const net = totalHours * hourlyRate;

              return [
                `"${emp.empNum}"`,
                `"Temporary Manpower"`,
                `"${emp.name}"`,
                `"${emp.designation || 'Helper (Temp)'}"`,
                `"${p.periodStr}"`,
                p.days,
                totalHours,
                hourlyRate.toFixed(3),
                hourlyRate.toFixed(3),
                "—",
                "—",
                "—",
                net.toFixed(3)
              ];
            } else {
              const basic = (empMonth.basic !== undefined && empMonth.basic !== null && empMonth.basic !== "")
                ? Number(empMonth.basic)
                : (Number(emp.basic) || 0);
              const otHrs = Number(empMonth.otHours) || 0;
              const hourlyRate = p.totalHrs > 0 ? (basic / p.totalHrs) : 0;
              const otRate = hourlyRate * 1.25;
              const otAmt = otHrs * otRate;
              const net = basic + otAmt;

              return [
                `"${emp.empNum}"`,
                `"Permanent Staff"`,
                `"${emp.name}"`,
                `"${emp.designation}"`,
                `"${p.periodStr}"`,
                p.days,
                p.totalHrs,
                basic.toFixed(3),
                hourlyRate.toFixed(3),
                otRate.toFixed(3),
                otHrs,
                otAmt.toFixed(3),
                net.toFixed(3)
              ];
            }
          });

          const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
          const encodedUri = encodeURI(csvContent);
          const link = document.createElement("a");
          link.setAttribute("href", encodedUri);
          link.setAttribute("download", `NorthStar_Payroll_${selectedPeriod}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      }

      // JSON Backup & Reset
      const backupJsonBtn = document.getElementById("backup-json-btn");
      if (backupJsonBtn) {
        backupJsonBtn.addEventListener("click", () => {
          const payload = { employees, monthlyData };
          const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(payload, null, 2));
          const dlAnchor = document.createElement("a");
          dlAnchor.setAttribute("href", dataStr);
          dlAnchor.setAttribute("download", `NorthStar_Attendance_Backup_${new Date().toISOString().split("T")[0]}.json`);
          document.body.appendChild(dlAnchor);
          dlAnchor.click();
          dlAnchor.remove();
        });
      }

      const resetSampleBtn = document.getElementById("reset-sample-btn");
      if (resetSampleBtn) {
        resetSampleBtn.addEventListener("click", () => {
          if (confirm("Reset to initial 4 employees? Current unsaved entries will be restored to default.")) {
            employees = JSON.parse(JSON.stringify(INITIAL_EMPLOYEES));
            saveData();
            render();
          }
        });
      }

      const cloudSyncBtn = document.getElementById("cloud-sync-btn");
      if (cloudSyncBtn) {
        cloudSyncBtn.addEventListener("click", () => {
          pullFromCloud();
        });
      }

      // Boot
      checkAuth();
    </script>
  </body>
</html>
