    function getCategoryColor(cat) {
      if (!cat) return "bg-white/10 text-white/70";
      const c = cat.toLowerCase();
      if (c.includes("material")) return "bg-blue-500/15 text-blue-300 border border-blue-500/30";
      if (c.includes("salary")) return "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30";
      if (c.includes("rent") || c.includes("hire")) return "bg-amber-500/15 text-amber-300 border border-amber-500/30";
      if (c.includes("food")) return "bg-orange-500/15 text-orange-300 border border-orange-500/30";
      if (c.includes("vehicle") || c.includes("fuel")) return "bg-cyan-500/15 text-cyan-300 border border-cyan-500/30";
      if (c.includes("office") || c.includes("stationary")) return "bg-purple-500/15 text-purple-300 border border-purple-500/30";
      if (c.includes("tele") || c.includes("internet") || c.includes("electric") || c.includes("water") || c.includes("gas")) return "bg-indigo-500/15 text-indigo-300 border border-indigo-500/30";
      if (c.includes("treatment") || c.includes("medical")) return "bg-pink-500/15 text-pink-300 border border-pink-500/30";
      if (c.includes("govt") || c.includes("visa") || c.includes("insurance")) return "bg-rose-500/15 text-rose-300 border border-rose-500/30";
      return "bg-white/10 text-white/80 border border-white/15";
    }

    function escapeHtml(str) {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

