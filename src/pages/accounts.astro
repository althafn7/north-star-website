---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Accounts &amp; Cash Book Register | North Star Technical Services LLC</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    @media print {
      /* Hide all UI elements except printable voucher */
      #login-gate,
      #admin-app,
      #txn-modal,
      #forgot-modal,
      #change-pass-modal,
      .no-print,
      .no-print-in-voucher,
      header,
      footer {
        display: none !important;
      }

      /* Un-fix voucher modal so it prints cleanly as a document */
      #voucher-slip-modal {
        display: block !important;
        position: static !important;
        inset: auto !important;
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        z-index: auto !important;
      }

      #voucher-slip-modal > div {
        display: block !important;
        position: static !important;
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        overflow: visible !important;
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #printable-voucher {
        display: block !important;
        position: static !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 auto !important;
        padding: 24px !important;
        background: #ffffff !important;
        color: #000000 !important;
        border: 2px solid #000000 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        page-break-inside: avoid;
        break-inside: avoid;
      }
    }
  </style>
</head>
<body class="min-h-screen bg-[#0f1115] font-sans text-white antialiased">

  <!-- ================= AUTH GATE (LOGIN SCREEN) ================= -->
  <div id="login-gate" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0b0d11] p-4">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-amber-500 bg-[#161920] p-8 shadow-2xl sm:p-10">
      <div class="flex flex-col items-center text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white p-2.5 shadow-md">
          <img src="/logo.png" alt="North Star logo" class="h-full w-auto object-contain" />
        </div>
        <span class="mt-4 text-xs font-semibold uppercase tracking-[0.25em] text-amber-400">North Star Financials</span>
        <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight text-white">Accounts Portal</h1>
        <p class="mt-2 text-xs text-white/60">Daily Cash Book &bull; Company Expenses &bull; 2017&ndash;2026 Register</p>
      </div>

      <form id="login-form" class="mt-8 space-y-4">
        <div>
          <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            autocomplete="username"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            value="admin"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
            placeholder="admin"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Password</label>
            <button type="button" id="open-forgot-modal-btn" class="text-[11px] font-medium text-amber-400 hover:underline">Forgot Password?</button>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
            placeholder="••••••••"
          />
        </div>

        <div id="login-error" class="hidden rounded-sm bg-red-900/40 p-2.5 text-xs font-medium text-red-300">
          Invalid username or password. Please try again.
        </div>

        <button
          type="submit"
          class="w-full bg-amber-500 py-3 text-sm font-semibold tracking-wider text-black shadow-lg transition-colors hover:bg-amber-400"
        >
          Sign In to Accounts
        </button>
      </form>

      <div class="mt-6 border-t border-white/10 pt-4 text-center">
        <a href="/" class="text-xs text-white/50 transition-colors hover:text-white">&larr; Back to public website</a>
      </div>
    </div>
  </div>

  <!-- ================= FORGOT PASSWORD MODAL ================= -->
  <div id="forgot-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-amber-400 bg-[#161920] p-6 shadow-2xl sm:p-8">
      <button
        type="button"
        id="forgot-modal-close-btn"
        class="absolute right-4 top-4 text-white/50 transition-colors hover:text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">Security Recovery</span>
      <h3 class="mt-1 font-display text-2xl font-bold text-white">Reset Password</h3>
      <p class="mt-2 text-xs text-white/60">Enter your designated master recovery PIN to reset the portal credentials.</p>

      <form id="forgot-form" class="mt-6 space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">Master Recovery PIN</label>
          <input
            type="password"
            id="recovery-pin"
            required
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
            placeholder="Enter recovery PIN"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">New Password</label>
          <input
            type="password"
            id="new-password"
            required
            minlength="6"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
            placeholder="At least 6 characters"
          />
        </div>
        <div id="forgot-error" class="hidden rounded-sm bg-red-900/40 p-2.5 text-xs text-red-300"></div>
        <div id="forgot-success" class="hidden rounded-sm bg-emerald-900/40 p-2.5 text-xs text-emerald-300">
          Password reset successfully! Redirecting...
        </div>
        <button
          type="submit"
          class="w-full bg-amber-500 py-2.5 text-xs font-semibold text-black transition-colors hover:bg-amber-400"
        >
          Update Password
        </button>
      </form>
    </div>
  </div>

  <!-- ================= CHANGE PASSWORD MODAL ================= -->
  <div id="change-pass-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-amber-400 bg-[#161920] p-6 shadow-2xl sm:p-8">
      <button
        type="button"
        id="change-pass-close-btn"
        class="absolute right-4 top-4 text-white/50 transition-colors hover:text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">Settings</span>
      <h3 class="mt-1 font-display text-2xl font-bold text-white">Change Password</h3>

      <form id="change-pass-form" class="mt-6 space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">Current Password</label>
          <input
            type="password"
            id="curr-pass"
            required
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">New Password</label>
          <input
            type="password"
            id="next-pass"
            required
            minlength="6"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">Confirm New Password</label>
          <input
            type="password"
            id="confirm-next-pass"
            required
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div id="change-pass-error" class="hidden rounded-sm bg-red-900/40 p-2.5 text-xs text-red-300"></div>
        <div id="change-pass-success" class="hidden rounded-sm bg-emerald-900/40 p-2.5 text-xs text-emerald-300">
          Password updated successfully!
        </div>
        <button
          type="submit"
          class="w-full bg-amber-500 py-2.5 text-xs font-semibold text-black transition-colors hover:bg-amber-400"
        >
          Save New Password
        </button>
      </form>
    </div>
  </div>

  <!-- ================= MAIN APP (AUTHENTICATED) ================= -->
  <div id="admin-app" class="hidden min-h-screen flex-col">
    <!-- Top Navigation Header -->
    <header class="border-b border-white/10 bg-[#161920]/90 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-3 py-2.5 sm:px-6">
        <!-- Brand -->
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2.5">
            <div class="flex h-9 w-9 items-center justify-center rounded-sm bg-white p-1">
              <img src="/logo.png" alt="North Star logo" class="h-full w-auto object-contain" />
            </div>
            <div>
              <span class="block font-display text-lg font-extrabold leading-none tracking-wide text-white">NORTH STAR</span>
              <span class="block text-[10px] font-semibold uppercase tracking-wider text-amber-400">Accounts &amp; Cash Book</span>
            </div>
          </a>
        </div>

        <!-- Action tools -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-3">
          <a
            href="/workflow"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/15 px-2.5 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white"
            title="Switch to Operations Workflow Portal"
          >
            <span class="hidden sm:inline">Operations Workflow</span>
            <span class="sm:hidden">Ops</span>
            <svg class="h-3.5 w-3.5 text-flare" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>

          <a
            href="/attendance"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/15 px-2.5 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white"
            title="Switch to Staff Attendance & Payroll Portal"
          >
            <span class="hidden sm:inline">Attendance &amp; Payroll</span>
            <span class="sm:hidden">Staff</span>
            <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </a>

          <button
            id="export-csv-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/20 bg-white/5 px-2.5 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/15"
            title="Export filtered records to CSV"
          >
            <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="hidden sm:inline">Export Excel/CSV</span>
            <span class="sm:hidden">CSV</span>
          </button>

          <button
            id="cloud-sync-btn"
            type="button"
            title="Live Cloud Sync: Click to refresh and sync with cloud database"
            class="inline-flex items-center gap-1.5 rounded-sm border border-emerald-500/30 bg-emerald-500/10 px-2 py-1.5 text-xs font-medium text-emerald-300 transition-colors hover:border-emerald-400 hover:bg-emerald-500/20"
          >
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
            <span id="cloud-sync-text" class="hidden sm:inline">Live Synced</span>
            <svg id="cloud-sync-icon" class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          </button>

          <button
            id="open-create-modal-btn"
            type="button"
            class="inline-flex items-center gap-1 bg-amber-500 px-2.5 py-1.5 text-xs font-semibold text-black shadow-md transition-colors hover:bg-amber-400"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span class="hidden sm:inline">+ New Voucher</span>
            <span class="sm:hidden">+ Entry</span>
          </button>

          <button
            id="change-pass-btn"
            type="button"
            title="Change Password"
            class="hidden sm:inline-flex rounded-sm border border-white/15 px-2.5 py-1.5 text-xs text-white/70 transition-colors hover:border-white/40 hover:text-white"
          >
            Password
          </button>

          <button
            id="logout-btn"
            type="button"
            title="Log out"
            class="rounded-sm border border-white/15 p-1.5 text-white/60 transition-colors hover:border-red-500 hover:text-red-400"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="mx-auto w-full max-w-[1440px] flex-1 px-2.5 py-4 sm:px-4 lg:px-6">
      
      <!-- Summary Metric Cards -->
      <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <div class="border border-white/10 bg-[#161920] p-4 shadow-sm border-l-4 border-l-amber-500">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-white/50">Total Cash Outflow</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-amber-400">OMR</span>
            <span id="metric-total-amount" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-total-count" class="mt-1 block text-[11px] text-white/40">0 transactions</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-emerald-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-400">Active View Value</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-emerald-400">OMR</span>
            <span id="metric-active-amount" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-active-sub" class="mt-1 block text-[11px] text-white/40">Filtered records sum</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-blue-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-blue-400">Top Expense Category</span>
          <div class="mt-1.5 flex items-baseline gap-1 truncate">
            <span id="metric-top-category" class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl truncate">—</span>
          </div>
          <span id="metric-top-val" class="mt-1 block text-[11px] text-white/40">OMR 0</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-purple-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-purple-400">Total Entries / Years</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span id="metric-entry-count" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
            <span class="text-xs font-medium text-white/50">vouchers</span>
          </div>
          <span id="metric-year-range" class="mt-1 block text-[11px] text-white/40">2017 &ndash; 2026 Registers</span>
        </div>
      </section>

      <!-- Table Toolbar (Search & Filters) -->
      <section class="mt-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div class="flex flex-1 flex-wrap items-center gap-2.5">
          <div class="relative min-w-[220px] flex-1 sm:max-w-xs">
            <input
              type="text"
              id="search-input"
              placeholder="Search category, payee, description, voucher #..."
              class="w-full border border-white/15 bg-[#161920] py-2 pl-9 pr-3 text-xs text-white placeholder-white/40 focus:border-amber-400 focus:outline-none"
            />
            <svg class="absolute left-3 top-2.5 h-4 w-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <select
            id="filter-paidto"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-amber-400 focus:outline-none max-w-[190px]"
            title="Filter by Beneficiary / Paid To"
          >
            <option value="ALL">All Paid To / Beneficiaries</option>
          </select>

          <select
            id="filter-category"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-amber-400 focus:outline-none max-w-[180px]"
          >
            <option value="ALL">All Categories</option>
          </select>

          <select
            id="filter-project"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-amber-400 focus:outline-none max-w-[160px]"
          >
            <option value="ALL">All Projects</option>
          </select>

          <select
            id="sort-date"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-amber-400 focus:outline-none"
            title="Sort records by date"
          >
            <option value="NEWEST">Date: Newest to Oldest</option>
            <option value="OLDEST">Date: Oldest to Newest</option>
            <option value="AMOUNT_HIGH">Amount: Highest First</option>
            <option value="AMOUNT_LOW">Amount: Lowest First</option>
          </select>

          <select
            id="page-size"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-amber-400 focus:outline-none"
            title="Rows per page"
          >
            <option value="100">100 rows / page</option>
            <option value="50">50 rows / page</option>
            <option value="250">250 rows / page</option>
            <option value="500">500 rows / page</option>
            <option value="ALL">All rows (No Pagination)</option>
          </select>
        </div>

        <div class="text-right">
          <span class="inline-block rounded-sm bg-[#161920] border border-white/15 px-3 py-1.5 text-xs font-semibold text-amber-400 shadow-sm">
            Showing <span id="record-count" class="font-bold text-amber-300">0</span> records
          </span>
        </div>
      </section>

      <!-- Year Category Filter Bar (Between Search Bar & Table) -->
      <section class="mt-4 flex flex-wrap items-center justify-between gap-3 border-b border-black/10 pb-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-sm bg-[#161920] border border-white/15 px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wider text-amber-400 shadow-sm">Year Register:</span>
          <div id="year-tabs-container" class="inline-flex flex-wrap items-center gap-1.5">
            <!-- Dynamically populated buttons: All Years, 2026, 2025, 2024 ... 2017 -->
          </div>
        </div>
        <div id="year-filter-badge" class="rounded-sm bg-[#161920] border border-white/15 px-3 py-1.5 text-xs font-bold text-amber-400 shadow-sm">
          <!-- Dynamically populated year summary -->
        </div>
      </section>

      <!-- Accounts Table -->
      <section class="mt-3 border border-white/10 bg-[#161920] shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-white/15 bg-[#1a1e27] text-[10.5px] font-bold uppercase tracking-wider text-white/70 shadow-sm">
              <tr>
                <th class="w-[95px] cursor-pointer select-none py-2.5 pl-3 pr-1 transition-colors hover:text-amber-400" id="th-sort-date" title="Click to sort by date">
                  <span class="inline-flex items-center gap-1">
                    <span>Date</span>
                    <span id="sort-indicator" class="text-xs text-amber-400 font-bold">▼</span>
                  </span>
                </th>
                <th class="w-[140px] px-2 py-2.5">Category / Head</th>
