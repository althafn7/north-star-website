  <!-- SCRIPT -->
  <script is:inline>
    const STORAGE_KEY_ACCOUNTS = "nsts_accounts_records_v3";
    const AUTH_KEY = "nsts_workflow_auth";
    const PASS_STORAGE_KEY = "nsts_workflow_admin_password";
    const DEFAULT_USER = "admin";
    const DEFAULT_PASS = "nsts2026";
    const MASTER_RECOVERY_PIN = "0000";

    function getActivePassword() {
      return localStorage.getItem(PASS_STORAGE_KEY) || DEFAULT_PASS;
    }

    let records = [];
    let selectedYear = "ALL";
    let selectedPaidTo = "ALL";
    let selectedCategory = "ALL";
    let selectedProject = "ALL";
    let searchQuery = "";
    let sortMode = "NEWEST";
    let pageSize = 100;
    let currentPage = 1;

    // Load Data: Try localStorage, then fallback to /data/cashbook_records.json
    async function loadData() {
      const cached = localStorage.getItem(STORAGE_KEY_ACCOUNTS);
      if (cached) {
        try {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed) && parsed.length > 0) {
            records = parsed;
            onDataLoaded();
            pullFromCloud();
            return;
          }
        } catch (e) {
          console.warn("Failed to parse cached accounts data:", e);
        }
      }

      // Fetch static seed from /data/cashbook_records.json
      try {
        const res = await fetch("/data/cashbook_records.json");
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data) && data.length > 0) {
            records = data;
            saveLocal();
            onDataLoaded();
            pullFromCloud();
            return;
          }
        }
      } catch (err) {
        console.warn("Failed to load /data/cashbook_records.json:", err);
      }

      onDataLoaded();
      pullFromCloud();
    }

    function saveLocal() {
      try {
        localStorage.setItem(STORAGE_KEY_ACCOUNTS, JSON.stringify(records));
      } catch (e) {
        console.warn("Local storage quota notice, data remains in memory");
      }
    }

    async function pushToCloud() {
      const syncText = document.getElementById("cloud-sync-text");
      const syncIcon = document.getElementById("cloud-sync-icon");
      if (syncIcon) syncIcon.classList.add("animate-spin");
      if (syncText) syncText.textContent = "Syncing...";

      try {
        const res = await fetch("/api/accounts-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ records })
        });
        if (res.ok) {
          if (syncText) syncText.textContent = "Live Synced";
        } else {
          if (syncText) syncText.textContent = "Local Saved";
        }
      } catch (e) {
        if (syncText) syncText.textContent = "Local Saved";
      } finally {
        if (syncIcon) syncIcon.classList.remove("animate-spin");
      }
    }

    async function pullFromCloud() {
      const syncText = document.getElementById("cloud-sync-text");
      const syncIcon = document.getElementById("cloud-sync-icon");
      if (syncIcon) syncIcon.classList.add("animate-spin");

      try {
        const res = await fetch("/api/accounts-sync?cb=" + Date.now());
        if (res.ok) {
          const result = await res.json();
          if (result && Array.isArray(result.records) && result.records.length > 0) {
            records = result.records;
            saveLocal();
            render();
            if (syncText) syncText.textContent = "Live Synced";
          }
        }
      } catch (e) {
        console.log("Using cached records");
      } finally {
        if (syncIcon) syncIcon.classList.remove("animate-spin");
      }
    }

    function onDataLoaded() {
      populateFilterDropdowns();
      renderYearTabs();
      render();
    }

    function getAvailableYears() {
      const set = new Set();
      records.forEach(r => {
        if (r.year) set.add(parseInt(r.year, 10));
      });
      return Array.from(set).sort((a, b) => b - a); // 2026 -> 2017
    }

    function renderYearTabs() {
      const container = document.getElementById("year-tabs-container");
      if (!container) return;

      const years = getAvailableYears();
      const allCounts = { ALL: records.length };
      years.forEach(y => {
        allCounts[y] = records.filter(r => parseInt(r.year, 10) === y).length;
      });

      const tabs = ["ALL", ...years.map(String)];
      if (!tabs.includes(String(selectedYear))) {
        selectedYear = "ALL";
      }

      container.innerHTML = tabs
        .map(tab => {
          const isActive = String(selectedYear) === String(tab);
          const count = allCounts[tab] || 0;
          const label = tab === "ALL" ? "All Years" : tab;
          const activeClass = isActive
            ? "bg-amber-500 text-black font-extrabold shadow-md border border-amber-400"
