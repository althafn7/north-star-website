    // Amount to Words Converter (Omani Rials & Baizas)
    function amountToWordsOMR(amount) {
      if (amount === 0 || !amount || isNaN(amount)) return "Zero Omani Rials Only";
      const num = Math.abs(parseFloat(amount) || 0);
      const rials = Math.floor(num);
      const baizas = Math.round((num - rials) * 1000);

      const ones = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
      const tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

      function chunkToWords(n) {
        let str = "";
        if (n >= 100) {
          str += ones[Math.floor(n / 100)] + " Hundred ";
          n %= 100;
        }
        if (n >= 20) {
          str += tens[Math.floor(n / 10)] + " ";
          n %= 10;
        }
        if (n > 0) {
          str += ones[n] + " ";
        }
        return str.trim();
      }

      function convertNumber(n) {
        if (n === 0) return "";
        let str = "";
        if (n >= 1000000) {
          str += chunkToWords(Math.floor(n / 1000000)) + " Million ";
          n %= 1000000;
        }
        if (n >= 1000) {
          str += chunkToWords(Math.floor(n / 1000)) + " Thousand ";
          n %= 1000;
        }
        if (n > 0) {
          str += chunkToWords(n);
        }
        return str.trim();
      }

      let res = "";
      if (rials > 0) {
        res += convertNumber(rials) + (rials === 1 ? " Omani Rial" : " Omani Rials");
      }
      if (baizas > 0) {
        if (res) res += " and ";
        res += convertNumber(baizas) + (baizas === 1 ? " Baiza" : " Baizas");
      }
      return res ? (res + " Only") : "Zero Omani Rials Only";
    }

    // Payment Voucher Slip Operations
    function openVoucherSlipModal(id) {
      const r = records.find(x => x.id === id);
      if (!r) return;

      const amtVal = r.amount || 0;
      const amtStr = amtVal.toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });

      const tagEl = document.getElementById("slip-voucher-no-tag");
      if (tagEl) tagEl.textContent = r.docNo ? `• ${r.docNo}` : `• ID ${r.id}`;

      const docNoEl = document.getElementById("slip-doc-no");
      if (docNoEl) docNoEl.textContent = r.docNo || r.id;

      const dateEl = document.getElementById("slip-date");
      if (dateEl) dateEl.textContent = r.date || "—";

      const docTypeEl = document.getElementById("slip-doc-type");
      if (docTypeEl) docTypeEl.textContent = r.docType || "Cash";

      const projEl = document.getElementById("slip-project");
      if (projEl) projEl.textContent = r.project || "Office / General";

      const paidToEl = document.getElementById("slip-paid-to");
      if (paidToEl) paidToEl.textContent = r.paidTo || "—";

      const catEl = document.getElementById("slip-category");
      if (catEl) catEl.textContent = r.category || "General Expense";

      const descEl = document.getElementById("slip-description");
      if (descEl) descEl.textContent = r.description || "—";

      const taxRow = document.getElementById("slip-tax-row");
      const taxInvEl = document.getElementById("slip-tax-inv");
      const vatNoEl = document.getElementById("slip-vat-no");
      const taxAmtEl = document.getElementById("slip-tax-amt");

      if (r.taxInvNo || r.vatNo || r.taxAmount) {
        if (taxRow) taxRow.classList.remove("hidden");
        if (taxInvEl) taxInvEl.textContent = r.taxInvNo || "—";
        if (vatNoEl) vatNoEl.textContent = r.vatNo || "—";
        if (taxAmtEl) taxAmtEl.textContent = "OMR " + (r.taxAmount || 0).toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      } else {
        if (taxRow) taxRow.classList.add("hidden");
      }

      const wordsEl = document.getElementById("slip-amount-words");
      if (wordsEl) wordsEl.textContent = amountToWordsOMR(amtVal);

      const amtNumEl = document.getElementById("slip-amount-num");
      if (amtNumEl) amtNumEl.textContent = `OMR ${amtStr}`;

      const recvNameEl = document.getElementById("slip-receiver-name");
      if (recvNameEl) recvNameEl.textContent = r.paidTo || "Receiver";

      const modal = document.getElementById("voucher-slip-modal");
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closeVoucherSlipModal() {
      const modal = document.getElementById("voucher-slip-modal");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    // Delete Transaction
    function deleteTransaction(id) {
      const r = records.find(x => x.id === id);
      if (!r) return;

      const amtFormatted = (r.amount || 0).toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      const confirmMsg = `Are you sure you want to delete this payment transaction?\n\n• Voucher No: ${r.docNo || r.id}\n• Date: ${r.date || "—"}\n• Paid To: ${r.paidTo || "—"}\n• Amount: OMR ${amtFormatted}\n• Description: ${r.description || "—"}\n\nThis will remove the transaction and sync to the cloud database.`;

      if (!confirm(confirmMsg)) return;

      const idx = records.findIndex(x => x.id === id);
      if (idx !== -1) {
        records.splice(idx, 1);
        saveLocal();
        pushToCloud();
        populateFilterDropdowns();
        renderYearTabs();
        renderTable();
      }
    }

    // CSV Export
    function exportToCsv() {
      const filtered = filterRecords();
      if (filtered.length === 0) {
        alert("No records to export.");
        return;
      }

      const headers = [
        "Year",
        "Date",
        "Category",
        "Paid To",
        "Description",
        "Project",
        "Doc No",
        "Doc Type",
        "Cash From",
        "Tax Inv No",
        "VAT No",
        "Tax Amount OMR",
        "Amount OMR"
      ];

      const csvRows = [headers.join(",")];

      filtered.forEach(r => {
        const row = [
          r.year || "",
          r.date || "",
          escapeCsv(r.category || ""),
          escapeCsv(r.paidTo || ""),
          escapeCsv(r.description || ""),
          escapeCsv(r.project || ""),
          escapeCsv(r.docNo || ""),
          escapeCsv(r.docType || ""),
          escapeCsv(r.cashFrom || ""),
          escapeCsv(r.taxInvNo || ""),
          escapeCsv(r.vatNo || ""),
          (r.taxAmount || 0).toFixed(3),
          (r.amount || 0).toFixed(3)
        ];
        csvRows.push(row.join(","));
      });

      const blob = new Blob([csvRows.join("\n")], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      const yLabel = selectedYear === "ALL" ? "All_Years" : selectedYear;
      a.download = `NorthStar_Accounts_${yLabel}_${Date.now()}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function escapeCsv(str) {
      if (str === null || str === undefined) return '""';
      const s = String(str).replace(/"/g, '""');
      return `"${s}"`;
    }

    // Download JSON Backup
    function downloadBackupJson() {
      const blob = new Blob([JSON.stringify(records, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `NorthStar_CashBook_Master_${Date.now()}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Auth & Boot
    function checkAuth() {
      const isAuth = localStorage.getItem(AUTH_KEY) === "true";
      const loginGate = document.getElementById("login-gate");
      const adminApp = document.getElementById("admin-app");

      if (isAuth) {
        if (loginGate) loginGate.classList.add("hidden");
        if (adminApp) {
          adminApp.classList.remove("hidden");
          adminApp.classList.add("flex");
        }
        loadData();
      } else {
        if (loginGate) loginGate.classList.remove("hidden");
        if (adminApp) {
          adminApp.classList.add("hidden");
          adminApp.classList.remove("flex");
        }
      }
    }

    // Wire Event Listeners
    document.addEventListener("DOMContentLoaded", () => {
      // Login Form
      const loginForm = document.getElementById("login-form");
      const loginError = document.getElementById("login-error");
      if (loginForm) {
        loginForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const u = document.getElementById("username").value.trim().toLowerCase();
          const p = document.getElementById("password").value.trim();
          if (u === DEFAULT_USER && p === getActivePassword()) {
            localStorage.setItem(AUTH_KEY, "true");
            if (loginError) loginError.classList.add("hidden");
            checkAuth();
          } else {
            if (loginError) loginError.classList.remove("hidden");
          }
        });
      }

      // Logout
      const logoutBtn = document.getElementById("logout-btn");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", () => {
          localStorage.removeItem(AUTH_KEY);
          checkAuth();
        });
      }

      // Change Password
      const changePassBtn = document.getElementById("change-pass-btn");
      const changePassModal = document.getElementById("change-pass-modal");
      const changePassClose = document.getElementById("change-pass-close-btn");
      const changePassForm = document.getElementById("change-pass-form");
      const changePassErr = document.getElementById("change-pass-error");
      const changePassSuccess = document.getElementById("change-pass-success");

      if (changePassBtn && changePassModal) {
        changePassBtn.addEventListener("click", () => {
          changePassModal.classList.remove("hidden");
          changePassModal.classList.add("flex");
        });
      }
      if (changePassClose && changePassModal) {
        changePassClose.addEventListener("click", () => {
          changePassModal.classList.add("hidden");
          changePassModal.classList.remove("flex");
        });
      }
      if (changePassForm) {
        changePassForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const curr = document.getElementById("curr-pass").value;
          const next = document.getElementById("next-pass").value;
          const conf = document.getElementById("confirm-next-pass").value;
          if (curr !== getActivePassword()) {
            changePassErr.textContent = "Current password is incorrect.";
            changePassErr.classList.remove("hidden");
            return;
          }
          if (next !== conf) {
            changePassErr.textContent = "New passwords do not match.";
            changePassErr.classList.remove("hidden");
            return;
          }
          localStorage.setItem(PASS_STORAGE_KEY, next);
          changePassErr.classList.add("hidden");
          changePassSuccess.classList.remove("hidden");
          setTimeout(() => {
            changePassModal.classList.add("hidden");
            changePassModal.classList.remove("flex");
            changePassSuccess.classList.add("hidden");
          }, 1200);
        });
      }

      // Forgot Password
      const openForgotBtn = document.getElementById("open-forgot-modal-btn");
      const forgotModal = document.getElementById("forgot-modal");
      const forgotClose = document.getElementById("forgot-modal-close-btn");
      const forgotForm = document.getElementById("forgot-form");
      const forgotErr = document.getElementById("forgot-error");
      const forgotSuccess = document.getElementById("forgot-success");

      if (openForgotBtn && forgotModal) {
        openForgotBtn.addEventListener("click", () => {
          forgotModal.classList.remove("hidden");
          forgotModal.classList.add("flex");
        });
      }
      if (forgotClose && forgotModal) {
        forgotClose.addEventListener("click", () => {
          forgotModal.classList.add("hidden");
          forgotModal.classList.remove("flex");
        });
      }
      if (forgotForm) {
        forgotForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const pin = document.getElementById("recovery-pin").value.trim();
          const np = document.getElementById("new-password").value.trim();
          if (pin !== MASTER_RECOVERY_PIN) {
            forgotErr.textContent = "Invalid Master Recovery PIN.";
            forgotErr.classList.remove("hidden");
            return;
          }
          localStorage.setItem(PASS_STORAGE_KEY, np);
          forgotErr.classList.add("hidden");
          forgotSuccess.classList.remove("hidden");
          setTimeout(() => {
            forgotModal.classList.add("hidden");
            forgotModal.classList.remove("flex");
            forgotSuccess.classList.add("hidden");
          }, 1200);
        });
      }

      // Search input
      const searchInput = document.getElementById("search-input");
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value;
          currentPage = 1;
          renderTable();
        });
      }

      // Paid To filter
      const filterPaidTo = document.getElementById("filter-paidto");
      if (filterPaidTo) {
        filterPaidTo.addEventListener("change", (e) => {
          selectedPaidTo = e.target.value;
          currentPage = 1;
          renderTable();
        });
      }

      // Category filter
      const filterCat = document.getElementById("filter-category");
      if (filterCat) {
        filterCat.addEventListener("change", (e) => {
          selectedCategory = e.target.value;
          currentPage = 1;
          renderTable();
        });
      }

      // Project filter
      const filterProj = document.getElementById("filter-project");
      if (filterProj) {
        filterProj.addEventListener("change", (e) => {
          selectedProject = e.target.value;
          currentPage = 1;
          renderTable();
        });
      }

      // Sort Date
      const sortSelect = document.getElementById("sort-date");
      if (sortSelect) {
        sortSelect.addEventListener("change", (e) => {
          sortMode = e.target.value;
          const sortInd = document.getElementById("sort-indicator");
          if (sortInd) {
            sortInd.textContent = sortMode === "OLDEST" ? "▲" : "▼";
          }
          renderTable();
        });
      }

      // Table Header click sort
      const thSortDate = document.getElementById("th-sort-date");
      if (thSortDate) {
        thSortDate.addEventListener("click", () => {
          sortMode = sortMode === "NEWEST" ? "OLDEST" : "NEWEST";
          if (sortSelect) sortSelect.value = sortMode;
          const sortInd = document.getElementById("sort-indicator");
          if (sortInd) {
            sortInd.textContent = sortMode === "OLDEST" ? "▲" : "▼";
          }
          renderTable();
        });
      }

      // Page size
      const pageSizeSelect = document.getElementById("page-size");
      if (pageSizeSelect) {
        pageSizeSelect.addEventListener("change", (e) => {
          pageSize = e.target.value;
          currentPage = 1;
          renderTable();
        });
      }

      // Pagination Buttons
      const pgFirst = document.getElementById("pg-first-btn");
      const pgPrev = document.getElementById("pg-prev-btn");
      const pgNext = document.getElementById("pg-next-btn");
      const pgLast = document.getElementById("pg-last-btn");

      if (pgFirst) pgFirst.addEventListener("click", () => { currentPage = 1; renderTable(); });
      if (pgPrev) pgPrev.addEventListener("click", () => { if (currentPage > 1) { currentPage--; renderTable(); } });
      if (pgNext) pgNext.addEventListener("click", () => { currentPage++; renderTable(); });
      if (pgLast) pgLast.addEventListener("click", () => {
        const filtered = filterRecords();
        const pSize = parseInt(pageSize, 10) || 100;
        currentPage = Math.ceil(filtered.length / pSize) || 1;
        renderTable();
      });

      // Export CSV
      const exportBtn = document.getElementById("export-csv-btn");
      if (exportBtn) exportBtn.addEventListener("click", exportToCsv);

      // Backup JSON
      const backupBtn = document.getElementById("backup-json-btn");
      if (backupBtn) backupBtn.addEventListener("click", downloadBackupJson);

      // Cloud Sync Button
      const cloudSyncBtn = document.getElementById("cloud-sync-btn");
      if (cloudSyncBtn) cloudSyncBtn.addEventListener("click", pullFromCloud);

      // New Voucher / Transaction Modal
      const openCreateBtn = document.getElementById("open-create-modal-btn");
      if (openCreateBtn) openCreateBtn.addEventListener("click", openCreateModal);

      const closeTxnBtn = document.getElementById("txn-modal-close-btn");
      if (closeTxnBtn) closeTxnBtn.addEventListener("click", closeTxnModal);

      const cancelTxnBtn = document.getElementById("txn-modal-cancel-btn");
      if (cancelTxnBtn) cancelTxnBtn.addEventListener("click", closeTxnModal);

      // Form Submit (Add / Edit)
      const txnForm = document.getElementById("txn-form");
      if (txnForm) {
        txnForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const id = document.getElementById("form-txn-id").value;
          const dStr = document.getElementById("form-txn-date").value.trim();
          let yr = parseInt(document.getElementById("form-txn-year").value, 10);
          const dateMatch = dStr.match(/(\d{4})/);
          if (dateMatch) {
            const detectedYr = parseInt(dateMatch[1], 10);
            if (detectedYr >= 2017 && detectedYr <= 2040) {
              yr = detectedYr;
            }
          }
          if (!yr || isNaN(yr)) yr = new Date().getFullYear();
          const amt = parseFloat(document.getElementById("form-txn-amount").value) || 0;
          const cat = document.getElementById("form-txn-category").value.trim();
          const paidTo = document.getElementById("form-txn-paidto").value.trim();
          const desc = document.getElementById("form-txn-description").value.trim();
          const proj = document.getElementById("form-txn-project").value.trim();
          const docNo = document.getElementById("form-txn-docno").value.trim();
          const cashFrom = document.getElementById("form-txn-cashfrom").value.trim();
          const taxInv = document.getElementById("form-txn-taxinv").value.trim();
          const vatNo = document.getElementById("form-txn-vatno").value.trim();
          const taxAmt = parseFloat(document.getElementById("form-txn-taxamt").value) || 0;

          if (id) {
            // Edit existing
            const targetIdx = records.findIndex(x => x.id === id);
            if (targetIdx !== -1) {
              records[targetIdx] = {
                ...records[targetIdx],
                date: dStr,
                year: yr,
                amount: Math.round(amt * 1000) / 1000,
                category: cat,
                paidTo,
                description: desc,
                project: proj,
                docNo,
                cashFrom,
                taxInvNo: taxInv,
                vatNo,
                taxAmount: Math.round(taxAmt * 1000) / 1000
              };
            }
          } else {
            // Add new
            const newId = `rec_${yr}_${Date.now().toString().slice(-4)}`;
            records.unshift({
              id: newId,
              year: yr,
              date: dStr,
              category: cat,
              paidTo,
              description: desc,
              docType: "Cash",
              docNo,
              project: proj,
              amount: Math.round(amt * 1000) / 1000,
              taxInvNo: taxInv,
              vatNo,
              taxAmount: Math.round(taxAmt * 1000) / 1000,
              cashFrom
            });
            selectedYear = String(yr);
          }

          saveLocal();
          pushToCloud();
          closeTxnModal();
          populateFilterDropdowns();
          renderYearTabs();
          render();
        });
      }

      // Auto-sync year input when date is typed
      const formDateInput = document.getElementById("form-txn-date");
      const formYearInput = document.getElementById("form-txn-year");
      if (formDateInput && formYearInput) {
        formDateInput.addEventListener("input", (e) => {
          const match = e.target.value.match(/(\d{4})/);
          if (match) {
            const y = parseInt(match[1], 10);
            if (y >= 2017 && y <= 2040) {
              formYearInput.value = y;
            }
          }
        });
      }

      // Voucher Slip Modal Controls
      const printVoucherBtn = document.getElementById("print-voucher-btn");
      if (printVoucherBtn) {
        printVoucherBtn.addEventListener("click", () => {
          window.print();
        });
      }

      const closeVoucherBtn = document.getElementById("close-voucher-btn");
      if (closeVoucherBtn) {
        closeVoucherBtn.addEventListener("click", closeVoucherSlipModal);
      }

      const voucherSlipModal = document.getElementById("voucher-slip-modal");
      if (voucherSlipModal) {
        voucherSlipModal.addEventListener("click", (e) => {
          if (e.target === voucherSlipModal) {
            closeVoucherSlipModal();
          }
        });
      }

      // Close modals on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeVoucherSlipModal();
          closeTxnModal();
        }
      });

      checkAuth();
    });
  </script>
</body>
</html>
