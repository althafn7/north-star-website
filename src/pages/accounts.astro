          const countBadgeClass = isActive
            ? "bg-black/30 text-black font-extrabold"
            : "bg-white/15 text-white/90 font-medium";

          return `
            <button
              type="button"
              class="year-tab-btn inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 text-xs transition-all ${activeClass}"
              data-year="${tab}"
            >
              <span>${label}</span>
              <span class="rounded-full px-1.5 py-0.2 text-[10px] ${countBadgeClass}">${count.toLocaleString()}</span>
