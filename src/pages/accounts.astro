      container.querySelectorAll(".year-tab-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          selectedYear = btn.dataset.year;
          currentPage = 1;
          populateFilterDropdowns();
          renderYearTabs();
          render();
        });
      });
    }

    function populateFilterDropdowns() {
      const catSelect = document.getElementById("filter-category");
      const projSelect = document.getElementById("filter-project");
      const paidToSelect = document.getElementById("filter-paidto");

      // Scope to active year if not ALL
      const pool = selectedYear === "ALL" ? records : records.filter(r => parseInt(r.year, 10) === parseInt(selectedYear, 10));

      const catSet = new Set();
      const projSet = new Set();
      const paidToSet = new Set();

      pool.forEach(r => {
        if (r.category && r.category.trim()) catSet.add(r.category.trim());
        if (r.project && r.project.trim()) projSet.add(r.project.trim());
        if (r.paidTo && r.paidTo.trim()) paidToSet.add(r.paidTo.trim());
      });

      if (catSelect) {
        const sortedCats = Array.from(catSet).sort((a, b) => a.localeCompare(b));
        const prevVal = selectedCategory;
        catSelect.innerHTML = `<option value="ALL">All Categories (${sortedCats.length})</option>` +
          sortedCats.map(c => `<option value="${escapeHtml(c)}" ${c.toLowerCase() === prevVal.toLowerCase() ? "selected" : ""}>${escapeHtml(c)}</option>`).join("");
        if (!sortedCats.some(c => c.toLowerCase() === prevVal.toLowerCase()) && prevVal !== "ALL") {
          selectedCategory = "ALL";
          catSelect.value = "ALL";
        }
      }

      if (projSelect) {
        const sortedProjs = Array.from(projSet).sort((a, b) => a.localeCompare(b));
        const prevVal = selectedProject;
        projSelect.innerHTML = `<option value="ALL">All Projects (${sortedProjs.length})</option>` +
          sortedProjs.map(p => `<option value="${escapeHtml(p)}" ${p.toLowerCase() === prevVal.toLowerCase() ? "selected" : ""}>${escapeHtml(p)}</option>`).join("");
        if (!sortedProjs.some(p => p.toLowerCase() === prevVal.toLowerCase()) && prevVal !== "ALL") {
          selectedProject = "ALL";
          projSelect.value = "ALL";
        }
      }

      if (paidToSelect) {
        const sortedPaidTo = Array.from(paidToSet).sort((a, b) => a.localeCompare(b));
        const prevVal = selectedPaidTo;
        paidToSelect.innerHTML = `<option value="ALL">All Paid To (${sortedPaidTo.length})</option>` +
          sortedPaidTo.map(p => `<option value="${escapeHtml(p)}" ${p.toLowerCase() === prevVal.toLowerCase() ? "selected" : ""}>${escapeHtml(p)}</option>`).join("");
        if (!sortedPaidTo.some(p => p.toLowerCase() === prevVal.toLowerCase()) && prevVal !== "ALL") {
          selectedPaidTo = "ALL";
          paidToSelect.value = "ALL";
        }
      }
    }

    function filterRecords() {
      let filtered = [...records];

      // Year filter
      if (selectedYear !== "ALL") {
        const yNum = parseInt(selectedYear, 10);
        filtered = filtered.filter(r => parseInt(r.year, 10) === yNum);
      }

      // Paid To filter
      if (selectedPaidTo !== "ALL") {
        filtered = filtered.filter(r => (r.paidTo || "").trim().toLowerCase() === selectedPaidTo.toLowerCase());
      }

      // Category filter
      if (selectedCategory !== "ALL") {
        filtered = filtered.filter(r => (r.category || "").trim().toLowerCase() === selectedCategory.toLowerCase());
      }

      // Project filter
      if (selectedProject !== "ALL") {
        filtered = filtered.filter(r => (r.project || "").trim().toLowerCase() === selectedProject.toLowerCase());
      }

      // Search query
      if (searchQuery.trim()) {
        const q = searchQuery.trim().toLowerCase();
        filtered = filtered.filter(r => {
          return (
            (r.category && r.category.toLowerCase().includes(q)) ||
            (r.paidTo && r.paidTo.toLowerCase().includes(q)) ||
            (r.description && r.description.toLowerCase().includes(q)) ||
            (r.docNo && r.docNo.toLowerCase().includes(q)) ||
            (r.project && r.project.toLowerCase().includes(q)) ||
            (r.taxInvNo && r.taxInvNo.toLowerCase().includes(q)) ||
            (r.date && r.date.toLowerCase().includes(q))
          );
        });
      }

      // Sort
      if (sortMode === "AMOUNT_HIGH") {
        filtered.sort((a, b) => (b.amount || 0) - (a.amount || 0));
      } else if (sortMode === "AMOUNT_LOW") {
        filtered.sort((a, b) => (a.amount || 0) - (b.amount || 0));
      } else if (sortMode === "OLDEST") {
        filtered.sort((a, b) => parseDateSortKey(a.date, a.year) - parseDateSortKey(b.date, b.year));
      } else {
        // NEWEST default
        filtered.sort((a, b) => parseDateSortKey(b.date, b.year) - parseDateSortKey(a.date, a.year));
      }

      return filtered;
    }

    function parseDateSortKey(dStr, yearFallback) {
      const yr = parseInt(yearFallback, 10) || 2000;
      if (!dStr) return yr * 10000;
      const parts = dStr.split(/[./-]/);
      if (parts.length >= 2) {
        let day = parseInt(parts[0], 10) || 1;
        let month = parseInt(parts[1], 10) || 1;
        if (day > 31) day = 1;
        if (month > 12) month = 1;
        return yr * 10000 + month * 100 + day;
      }
      return yr * 10000;
    }

    function renderMetrics(filtered) {
      // Total amount across all records
      const grandTotal = records.reduce((sum, r) => sum + (r.amount || 0), 0);
      const filteredTotal = filtered.reduce((sum, r) => sum + (r.amount || 0), 0);

      const totalAmtEl = document.getElementById("metric-total-amount");
      const totalCountEl = document.getElementById("metric-total-count");
      const activeAmtEl = document.getElementById("metric-active-amount");
      const activeSubEl = document.getElementById("metric-active-sub");
      const topCatEl = document.getElementById("metric-top-category");
      const topValEl = document.getElementById("metric-top-val");
      const entryCountEl = document.getElementById("metric-entry-count");
      const yearBadge = document.getElementById("year-filter-badge");

      if (totalAmtEl) totalAmtEl.textContent = grandTotal.toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      if (totalCountEl) totalCountEl.textContent = records.length.toLocaleString() + " all-time records";

      if (activeAmtEl) activeAmtEl.textContent = filteredTotal.toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      if (activeSubEl) {
        const pct = grandTotal > 0 ? ((filteredTotal / grandTotal) * 100).toFixed(1) : 0;
        activeSubEl.textContent = `${filtered.length.toLocaleString()} records (${pct}% of all cash outflow)`;
      }

      // Top category in filtered
      const catTotals = {};
      filtered.forEach(r => {
        const c = (r.category || "Uncategorized").trim();
        catTotals[c] = (catTotals[c] || 0) + (r.amount || 0);
      });
      let topCategory = "—";
      let topCategoryVal = 0;
      Object.entries(catTotals).forEach(([c, val]) => {
        if (val > topCategoryVal) {
          topCategory = c;
          topCategoryVal = val;
        }
      });
      if (topCatEl) topCatEl.textContent = topCategory;
      if (topValEl) topValEl.textContent = "OMR " + topCategoryVal.toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 });

      if (entryCountEl) entryCountEl.textContent = filtered.length.toLocaleString();

      if (yearBadge) {
        const yText = selectedYear === "ALL" ? "All Years" : selectedYear;
        yearBadge.textContent = `Viewing: ${yText} (${filtered.length.toLocaleString()} records • OMR ${filteredTotal.toLocaleString("en-US", { minimumFractionDigits: 3, maximumFractionDigits: 3 })})`;
      }
    }

