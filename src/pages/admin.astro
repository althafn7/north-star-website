    const logoutBtn = document.getElementById("logout-btn");

    const tableBody = document.getElementById("workflow-table-body");
    const noRecordsMsg = document.getElementById("no-records-msg");
    const searchInput = document.getElementById("search-input");
    const filterStatus = document.getElementById("filter-status");
    const filterWork = document.getElementById("filter-work");
    const recordCountEl = document.getElementById("record-count");

    const metricQuotedTotal = document.getElementById("metric-quoted-total");
    const metricQuotedCount = document.getElementById("metric-quoted-count");
    const metricPoTotal = document.getElementById("metric-po-total");
    const metricPoCount = document.getElementById("metric-po-count");
    const metricPendingCount = document.getElementById("metric-pending-count");
    const metricPendingVal = document.getElementById("metric-pending-val");
    const metricInvoicedTotal = document.getElementById("metric-invoiced-total");
    const metricInvoicedCount = document.getElementById("metric-invoiced-count");

    const recordModal = document.getElementById("record-modal");
