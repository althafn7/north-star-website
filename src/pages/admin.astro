---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Operations Portal | North Star Technical Services LLC</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-[#0f1115] font-sans text-white antialiased">

  <!-- ================= AUTH GATE (LOGIN SCREEN) ================= -->
  <div id="login-gate" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0b0d11] p-4">
    <div class="relative w-full max-w-md border border-white/10 border-t-4 border-t-flare bg-[#161920] p-8 shadow-2xl sm:p-10">
      <div class="flex flex-col items-center text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white p-2.5 shadow-md">
          <img src="/logo.png" alt="North Star logo" class="h-full w-auto object-contain" />
        </div>
        <span class="mt-4 text-xs font-semibold uppercase tracking-[0.25em] text-flare">North Star Operations</span>
        <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight text-white">Workflow Portal</h1>
        <p class="mt-2 text-xs text-white/60">Quotes • Purchase Orders • Execution • Invoicing</p>
      </div>

      <form id="login-form" class="mt-8 space-y-4">
        <div>
          <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            autocomplete="username"
            value="admin"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none focus:ring-1 focus:ring-flare"
            placeholder="admin"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-white/70">Password</label>
            <span class="text-[11px] text-white/40">Default: <code class="text-flare">nsts2026</code></span>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="mt-1.5 w-full border border-white/15 bg-[#0f1115] px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-flare focus:outline-none focus:ring-1 focus:ring-flare"
            placeholder="••••••••"
          />
        </div>

        <div id="login-error" class="hidden rounded-sm bg-red-900/40 p-2.5 text-xs font-medium text-red-300">
          Invalid username or password. Please try again.
        </div>

        <button
          type="submit"
          class="w-full bg-flare py-3 text-sm font-semibold tracking-wider text-white shadow-lg transition-colors hover:bg-red-700"
        >
          Sign In to Portal
        </button>
      </form>

      <div class="mt-6 border-t border-white/10 pt-4 text-center">
        <a href="/" class="text-xs text-white/50 transition-colors hover:text-white">← Back to public website</a>
      </div>
    </div>
  </div>

  <!-- ================= MAIN ADMIN DASHBOARD ================= -->
  <div id="admin-app" class="hidden min-h-screen flex-col">
    <!-- Top Navigation -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#161920]/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2.5" title="View live website">
            <img src="/logo.png" alt="North Star logo" class="h-9 w-auto" />
            <div class="border-l border-white/20 pl-2.5">
              <span class="block font-display text-lg font-extrabold leading-none tracking-wide text-white">NORTH STAR</span>
              <span class="block text-[10px] font-semibold uppercase tracking-wider text-flare">Operations Portal</span>
            </div>
          </a>
        </div>

        <!-- Action tools -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <a
            href="/"
            target="_blank"
            class="hidden items-center gap-1.5 rounded-sm border border-white/15 px-3 py-1.5 text-xs font-medium text-white/80 transition-colors hover:border-white/40 hover:text-white md:inline-flex"
          >
            <span>Live Site</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>

          <button
            id="export-csv-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-sm border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-white/15"
          >
            <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="hidden sm:inline">Export Excel/CSV</span>
            <span class="sm:hidden">CSV</span>
          </button>

          <button
            id="open-create-modal-btn"
            type="button"
            class="inline-flex items-center gap-1.5 bg-flare px-3.5 py-1.5 text-xs font-semibold text-white shadow-md transition-colors hover:bg-red-700"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>New Job / Quote</span>
          </button>

          <button
            id="logout-btn"
            type="button"
            title="Log out"
            class="rounded-sm border border-white/15 p-1.5 text-white/60 transition-colors hover:border-red-500 hover:text-red-400"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6">
      
      <!-- Summary Metric Cards -->
      <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <div class="border border-white/10 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-white/50">Total Quoted Value</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-flare">OMR</span>
            <span id="metric-quoted-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-quoted-count" class="mt-1 block text-[11px] text-white/40">0 active quotes</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-emerald-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-400">POs Received (Approved)</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-emerald-400">OMR</span>
            <span id="metric-po-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-po-count" class="mt-1 block text-[11px] text-white/40">0 jobs with PO</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-amber-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-400">Pending Approvals</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span id="metric-pending-count" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
            <span class="text-xs font-medium text-white/50">quotes</span>
          </div>
          <span id="metric-pending-val" class="mt-1 block text-[11px] text-white/40">OMR 0 in review</span>
        </div>

        <div class="border border-white/10 border-l-4 border-l-blue-500 bg-[#161920] p-4 shadow-sm">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-blue-400">Invoiced / Completed</span>
          <div class="mt-1.5 flex items-baseline gap-1">
            <span class="text-xs font-semibold text-blue-400">OMR</span>
            <span id="metric-invoiced-total" class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">0</span>
          </div>
          <span id="metric-invoiced-count" class="mt-1 block text-[11px] text-white/40">0 jobs invoiced</span>
        </div>
      </section>

      <!-- Table Toolbar (Search & Filters) -->
      <section class="mt-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div class="flex flex-1 flex-wrap items-center gap-2.5">
          <div class="relative min-w-[220px] flex-1 sm:max-w-xs">
            <input
              type="text"
              id="search-input"
              placeholder="Search client, PO #, scope, quote #..."
              class="w-full border border-white/15 bg-[#161920] py-2 pl-9 pr-3 text-xs text-white placeholder-white/40 focus:border-flare focus:outline-none"
            />
            <svg class="absolute left-3 top-2.5 h-4 w-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <select
            id="filter-status"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-flare focus:outline-none"
          >
            <option value="ALL">All Approval Statuses</option>
            <option value="Pending">Pending Approval</option>
            <option value="Approved">PO Received / Approved</option>
            <option value="Under Revision">Under Revision</option>
            <option value="Lost">Lost / Cancelled</option>
            <option value="Dummy Quote">Dummy Quote</option>
          </select>

          <select
            id="filter-work"
            class="border border-white/15 bg-[#161920] px-3 py-2 text-xs text-white/80 focus:border-flare focus:outline-none"
          >
            <option value="ALL">All Work Progress</option>
            <option value="Not Started">Not Started</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
          </select>
        </div>

        <div class="text-right text-xs text-white/50">
          Showing <span id="record-count" class="font-semibold text-white">0</span> records
        </div>
      </section>

      <!-- Workflow Table -->
      <section class="mt-3 overflow-hidden border border-white/10 bg-[#161920] shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[1050px] text-left text-xs">
            <thead class="border-b border-white/15 bg-[#1a1e27] text-[11px] font-bold uppercase tracking-wider text-white/70">
              <tr>
                <th class="py-3.5 pl-4 pr-3">Ref &amp; Date</th>
                <th class="px-3 py-3.5">Client</th>
                <th class="px-3 py-3.5">Job / Scope Description</th>
                <th class="px-3 py-3.5">Quote Total (OMR)</th>
                <th class="px-3 py-3.5">Approval Status</th>
                <th class="px-3 py-3.5">PO Details</th>
                <th class="px-3 py-3.5">Work Progress</th>
                <th class="px-3 py-3.5">Invoicing</th>
                <th class="py-3.5 pl-3 pr-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="workflow-table-body" class="divide-y divide-white/5">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>

        <div id="no-records-msg" class="hidden py-12 text-center text-sm text-white/40">
          No records match your filter criteria. Click "New Job / Quote" to add one.
        </div>
      </section>

      <!-- Bottom Utility Bar -->
      <section class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-white/40">
        <div>
          Data is saved securely in your browser (<span class="text-emerald-400">Auto-saved</span>).
        </div>
        <div class="flex items-center gap-3">
          <button id="backup-json-btn" type="button" class="underline hover:text-white">Download JSON Backup</button>
          <span>•</span>
          <button id="reset-sample-btn" type="button" class="underline hover:text-white">Reload Sample Data</button>
        </div>
      </section>
    </main>
  </div>

  <!-- ================= ADD / EDIT RECORD MODAL ================= -->
  <div id="record-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-xs">
    <div class="relative max-h-[90vh] w-full max-w-2xl overflow-y-auto border border-white/15 border-t-4 border-t-flare bg-[#161920] p-6 shadow-2xl sm:p-8">
      <button
        id="modal-close-btn"
        type="button"
        class="absolute right-4 top-4 text-white/50 transition-colors hover:text-white"
        aria-label="Close"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <span id="modal-eyebrow" class="text-xs font-semibold uppercase tracking-[0.2em] text-flare">New Entry</span>
      <h2 id="modal-title" class="font-display text-2xl font-extrabold text-white sm:text-3xl">Add Job / Quotation</h2>

      <form id="record-form" class="mt-6 space-y-6">
        <input type="hidden" id="record-id" name="id" value="" />

        <!-- Section 1: Quotation Details -->
        <div>
          <h3 class="border-b border-white/10 pb-1.5 text-xs font-bold uppercase tracking-wider text-white/80">1. Quotation Details</h3>
          <div class="mt-3 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
            <div>
              <label for="form-ref" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Quote Ref #</label>
              <input type="text" id="form-ref" required placeholder="e.g. NSTS-QT-2601" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>

            <div>
              <label for="form-date" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Quote Date</label>
              <input type="date" id="form-date" required class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white focus:border-flare focus:outline-none" />
            </div>

            <div>
              <label for="form-client" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Client Name</label>
              <input type="text" id="form-client" required placeholder="e.g. OQ, Sohar Aluminium, Vale..." class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>

            <div class="sm:col-span-2 grid grid-cols-1 gap-3 sm:grid-cols-3 rounded border border-white/10 bg-[#0b0d11]/60 p-2.5">
              <div>
                <label for="form-basic-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Basic Amount (OMR)</label>
                <input type="number" step="0.001" id="form-basic-amt" required placeholder="0.000" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs font-mono text-white placeholder-white/30 focus:border-flare focus:outline-none" />
              </div>
              <div>
                <label for="form-vat-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-amber-300">VAT 5% (OMR)</label>
                <input type="number" step="0.001" id="form-vat-amt" placeholder="0.000" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs font-mono text-amber-300 placeholder-white/30 focus:border-flare focus:outline-none" />
              </div>
              <div>
                <label for="form-total-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-flare font-bold">Total Quoted (OMR)</label>
                <input type="number" step="0.001" id="form-total-amt" readonly class="mt-1 w-full border border-flare/40 bg-flare/10 px-3 py-2 text-xs font-mono font-bold text-flare focus:outline-none cursor-not-allowed" />
              </div>
            </div>

            <div class="sm:col-span-2">
              <label for="form-scope" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Job / Scope Description</label>
              <textarea id="form-scope" rows="2" required placeholder="e.g. API 650 Storage Tank Shell Rehabilitation & Pad Plate Testing" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none"></textarea>
            </div>
          </div>
        </div>

        <!-- Section 2: Approval & PO Details -->
        <div>
          <h3 class="border-b border-white/10 pb-1.5 text-xs font-bold uppercase tracking-wider text-white/80">2. Approval &amp; Purchase Order (PO)</h3>
          <div class="mt-3 grid grid-cols-1 gap-3.5 sm:grid-cols-3">
            <div>
              <label for="form-status" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Approval Status</label>
              <select id="form-status" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white focus:border-flare focus:outline-none">
                <option value="Pending">Pending Approval</option>
                <option value="Approved">PO Received / Approved</option>
                <option value="Under Revision">Under Revision</option>
                <option value="Lost">Lost / Cancelled</option>
                <option value="Dummy Quote">Dummy Quote</option>
              </select>
            </div>

            <div>
              <label for="form-po-number" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">PO Number</label>
              <input type="text" id="form-po-number" placeholder="e.g. PO-OQ-9842" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>

            <div class="sm:col-span-3 grid grid-cols-1 gap-3 sm:grid-cols-3 rounded border border-white/10 bg-[#0b0d11]/60 p-2.5">
              <div>
                <label for="form-po-basic-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">PO Basic Amount (OMR)</label>
                <input type="number" step="0.001" id="form-po-basic-amt" placeholder="0.000" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs font-mono text-white placeholder-white/30 focus:border-flare focus:outline-none" />
              </div>
              <div>
                <label for="form-po-vat-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-amber-300">PO VAT 5% (OMR)</label>
                <input type="number" step="0.001" id="form-po-vat-amt" placeholder="0.000" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs font-mono text-amber-300 placeholder-white/30 focus:border-flare focus:outline-none" />
              </div>
              <div>
                <label for="form-po-total-amt" class="block text-[11px] font-semibold uppercase tracking-wider text-emerald-400 font-bold">PO Total Value (OMR)</label>
                <input type="number" step="0.001" id="form-po-total-amt" readonly class="mt-1 w-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs font-mono font-bold text-emerald-400 focus:outline-none cursor-not-allowed" />
              </div>
            </div>
          </div>
        </div>

        <!-- Section 3: Execution & Invoicing -->
        <div>
          <h3 class="border-b border-white/10 pb-1.5 text-xs font-bold uppercase tracking-wider text-white/80">3. Work Execution &amp; Invoicing</h3>
          <div class="mt-3 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <label for="form-work-status" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Work Progress</label>
              <select id="form-work-status" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white focus:border-flare focus:outline-none">
                <option value="Not Started">Not Started</option>
                <option value="In Progress">In Progress</option>
                <option value="Completed">Completed</option>
              </select>
            </div>

            <div>
              <label for="form-completed-date" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Completion Date</label>
              <input type="date" id="form-completed-date" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white focus:border-flare focus:outline-none" />
            </div>

            <div>
              <label for="form-invoice-num" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Invoice #</label>
              <input type="text" id="form-invoice-num" placeholder="INV-2026-042" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white placeholder-white/30 focus:border-flare focus:outline-none" />
            </div>

            <div>
              <label for="form-invoice-date" class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">Invoice Submission Date</label>
              <input type="date" id="form-invoice-date" class="mt-1 w-full border border-white/15 bg-[#0f1115] px-3 py-2 text-xs text-white focus:border-flare focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Submit & Cancel -->
        <div class="flex items-center justify-end gap-3 border-t border-white/10 pt-4">
          <button
            type="button"
            id="modal-cancel-btn"
            class="border border-white/20 px-4 py-2 text-xs font-semibold text-white/70 transition-colors hover:bg-white/10 hover:text-white"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="bg-flare px-6 py-2 text-xs font-semibold uppercase tracking-wider text-white shadow-md transition-colors hover:bg-red-700"
          >
            Save Record
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Client-Side Portal Logic -->
  <script is:inline>
    // Config & Credential
    const AUTH_KEY = "nsts_admin_auth";
    const STORAGE_KEY = "nsts_workflow_records_2026_v3";
